#!/usr/bin/env php
<?php

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../vendor/autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require_once $autoloader;
        break;
    }
}

$phpstanBin = __DIR__ . '/../vendor/bin/phpstan';

if (!file_exists($phpstanBin)) {
    echo "Error: PHPStan no está instalado en vendor/bin/phpstan" . PHP_EOL;
    exit(1);
}

$memoryLimit = '--memory-limit=-1';
$args = implode(' ', array_map('escapeshellarg', array_slice($argv, 1)));
passthru("$phpstanBin analyse $memoryLimit $args", $exitCode);

exit($exitCode);