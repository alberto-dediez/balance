default:
    formatters:
        progress: true
    suites:
        default:
            paths:
                features: tests/Acceptance
            contexts:
                - App\Tests\Acceptance\Shared\WebContext
                - App\Tests\Acceptance\Shared\MailContext
                - App\Tests\Acceptance\Shared\ApiContext
                - App\Tests\Acceptance\Shared\SystemContext
                - App\Tests\Acceptance\Security\SecurityContext
                - App\Tests\Acceptance\Property\PropertyContext
                - App\Tests\Acceptance\DataExchange\DataExchangeContext
                - App\Tests\Acceptance\FoodLoss\FoodLossContext
                - App\Tests\Acceptance\HumanResources\HumanResourcesContext

    extensions:
        FriendsOfBehat\SymfonyExtension:
            bootstrap: tests/bootstrap.php
            kernel:
                class: App\Shared\Infrastructure\Symfony\Kernel
                environment: test
