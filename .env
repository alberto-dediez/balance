###> media storage ###
# local | ovh
MEDIA_STORAGE=local
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_REGION=gra
OVH_S3_BUCKET=
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
OVH_S3_PREFIX=library
# Keeps the library files on the local disk while the main storage is down; requires a shared var/uploads/library with several web nodes
MEDIA_STORAGE_FALLBACK_ENABLED=true
###< media storage ###
