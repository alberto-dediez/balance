###> symfony/sendgrid-mailer ###
# MAILER_DSN=sendgrid://KEY@default
# El seguimiento del log de emails (custom_args) solo funciona con el transporte API (sendgrid:// o sendgrid+api://), no con sendgrid+smtp://
###< symfony/sendgrid-mailer ###

###> sendgrid webhook ###
# Clave pública del Signed Event Webhook de SendGrid; solo funciona con MAILER_DSN=sendgrid://…
SENDGRID_WEBHOOK_SECRET=
###< sendgrid webhook ###

###> email log ###
EMAIL_LOG_RETENTION_DAYS=180
