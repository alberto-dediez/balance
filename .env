# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> docker-config ###
LOCAL_IP=127.0.0.1
###< docker-config ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=b041ba37c9ff4bd70d10d2a7b037df56
# Comma-separated list of trusted proxy IPs. Set to the IP of your reverse proxy / load balancer in production.
# Leave empty if the app is exposed directly to the internet without a proxy.
TRUSTED_PROXIES=127.0.0.1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://root:@127.0.0.1:3306/hydra?serverVersion=10.4.28-MariaDB&charset=utf8mb4"
# DATABASE_URL=mysql://${MYSQL_USER:-app}:${MYSQL_PASSWORD:-!ChangeMe!}@database:3306/${MYSQL_DATABASE:-app}?serverVersion=${MYSQL_VERSION:-9}&charset=${MYSQL_CHARSET:-utf8mb4}
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=16&charset=utf8"

# MYSQL_USER=app
# MYSQL_PASSWORD=!ChangeMe!
# MYSQL_DATABASE=app
# MYSQL_VERSION=9
# MYSQL_DATABASE_CHARSET=utf8mb4
# DATABASE_URL=mysql://${MYSQL_USER:-app}:${MYSQL_PASSWORD:-!ChangeMe!}@database:3306/${MYSQL_DATABASE:-app}?serverVersion=${MYSQL_VERSION:-9}&charset=${MYSQL_DATABASE_CHARSET:-utf8}
###< doctrine/doctrine-bundle ###

###> languages ###
LANGUAGE_DEFAULT='es'
LANGUAGE_LIST='es|en'
###< languages ###

SERVER_NAME=localhost
BASE_URL=https://localhost
###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=03ac9d6afbb5ac4fdbeca81a57065e7d1834e34580f53217a4734a3e5aaa8431
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> signature ###
SIGNATURE_HMAC_SECRET=generate-with-openssl-rand-hex-32
SIGNATURE_SMS_ENABLED=false
SIGNATURE_WHATSAPP_ENABLED=false
###< signature ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=web@email.com
###< symfony/mailer ###

###> symfony/sendgrid-mailer ###
# MAILER_DSN=sendgrid://KEY@default
###< symfony/sendgrid-mailer ###

###> app ###
COMPANY_NAME='Dediez Software'
###< app ###

###> account impersonation ###
ACCOUNT_IMPERSONATION_ENABLED=false
###< account impersonation ###

###> sso ###
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_ENABLED=false
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=common
###< sso ###

###> two factor ###
TWO_FACTOR_REQUIRED=false
TWO_FACTOR_SSO_ENABLED=false
###< two factor ###

###> announcements ###
ANNOUNCEMENTS_ENABLED=false
###< announcements ###

###> notifications ###
INTERNAL_NOTIFICATIONS_ENABLED=true
LIVE_NOTIFICATIONS_ENABLED=true
LIVE_NOTIFICATIONS_POLLING_SECONDS=30
###< notifications ###


###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/twilio-notifier ###
TWILIO_DSN=twilio://ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx:your_auth_token@default?from=%2B1234567890
###< symfony/twilio-notifier ###

###> error notifications ###
ERROR_NOTIFICATIONS_ENABLED=true
ERROR_NOTIFICATION_RECIPIENTS='alberto@minotour.es'
ERROR_NOTIFICATIONS_THROTTLE_MINUTES=60
###< error notifications ###

###> maintenance ###
MAINTENANCE_MODE=false
###< maintenance ###

###> media storage ###
# local | ovh
MEDIA_STORAGE=local
OVH_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
OVH_S3_REGION=gra
OVH_S3_BUCKET=
OVH_S3_ACCESS_KEY=
OVH_S3_SECRET_KEY=
OVH_S3_PREFIX=library
# Keeps the library files on the local disk while the main storage is down; requires a shared var/uploads/library with several web nodes
MEDIA_STORAGE_FALLBACK_ENABLED=true
###< media storage ###
