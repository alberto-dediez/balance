parameters:
    level: 8
    paths:
        - src/
        - tests/
    symfony:
        # You have to provide a path to srcDevDebugProjectContainer.xml or similar XML file describing your container.
        containerXmlPath: var/cache/test/App_Shared_Infrastructure_Symfony_KernelTestDebugContainer.xml
    # If you're using PHP config files for Symfony 5.3+, you also need this for auto-loading of `Symfony\Config`:
    scanDirectories:
        - var/cache/test/Symfony/Config
    # If you're using PHP config files (including the ones under packages/*.php) for Symfony 5.3+,
    # you need this to load the helper functions (i.e. service(), env()):
    scanFiles:
        - vendor/symfony/dependency-injection/Loader/Configurator/ContainerConfigurator.php
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        -
            message: '#type mapping mismatch.*but database expects Doctrine\\Common\\Collections\\Collection#'
            identifier: doctrine.associationType
        -
            message: '#Instanceof between App\\Shared\\Domain\\Model\\Locale\\Translation and App\\Shared\\Domain\\Model\\Locale\\Translation will always evaluate to true\.#'
            identifier: instanceof.alwaysTrue
        -
            # The doctrine extension narrows the nullable "locale" custom-type field to non-null,
            # but User::preferredLocale() is genuinely nullable at runtime.
            message: '#Using nullsafe property access "\?->value" on left side of \?\? is unnecessary\. Use -> instead\.#'
            identifier: nullsafe.neverNull
            path: src/Notifications/Infrastructure/Notification/DispatchingSystemNotifier.php
        -
            # The doctrine extension narrows the nullable "locale" custom-type field to non-null,
            # but User::preferredLocale() is genuinely nullable at runtime.
            message: '#Using nullsafe property access "\?->value" on left side of \?\? is unnecessary\. Use -> instead\.#'
            identifier: nullsafe.neverNull
            path: src/Security/Infrastructure/Symfony/Security/SsoAuthenticator.php
        -
            # The doctrine extension narrows the nullable "locale" custom-type field to non-null,
            # but User::preferredLocale() is genuinely nullable at runtime.
            message: '#Using nullsafe property access "\?->value" on left side of \?\? is unnecessary\. Use -> instead\.#'
            identifier: nullsafe.neverNull
            path: src/Security/Infrastructure/UI/Web/TwoFactorLoginController.php
        -
            message: '#Parameter \#1 .* of method .*::__invoke\(\) expects .*, .*Command given\.#'
            path: src/Shared/Application/CommandBus/CommandInvokeHandlerTrait.php
        -
            message: '#Variable \$outputFile might not be defined\.#'
            identifier: variable.undefined
            path: src/Property/Infrastructure/UI/Console/Property/ImportCommand.php
        -
            message: '#^Method App\\Assistant\\Application\\Engine\\ConversationTranscript::messagesFor\(\) should return list<App\\Shared\\Application\\Ai\\Agent\\AiAgentMessage> but returns array<int<0, max>, App\\Shared\\Application\\Ai\\Agent\\AiAgentMessage>\.$#'
            identifier: return.type
            path: src/Assistant/Application/Engine/ConversationTranscript.php
            reportUnmatched: false
        -
            message: '#^Property App\\Tests\\Unit\\Assistant\\Application\\Engine\\FakeAssistantTool@anonymous/tests/Unit/Assistant/Application/ActionPlan/ExecuteActionPlanServiceTest\.php:\d+::\$executionIds is never read, only written\.$#'
            identifier: property.onlyWritten
            path: tests/Unit/Assistant/Application/ActionPlan/ExecuteActionPlanServiceTest.php
            reportUnmatched: false
        -
            message: '#Service ".*" is private\.#'
            paths:
                - tests/*
