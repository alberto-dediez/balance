<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Payments\Domain\Model\Payout\Payout" table="payouts">
        <id name="id" type="payout_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="number" type="string" column="number" length="20" nullable="true" unique="true"/>
        <field name="payeeId" type="payee_id" column="payee_id" nullable="true"/>
        <field name="baseAmount" type="float" column="base_amount" nullable="false"/>
        <field name="payableAmount" type="float" column="payable_amount" nullable="false"/>
        <field name="currency" type="string" column="currency" length="3" nullable="false"/>
        <field name="linesCount" type="integer" column="lines_count" nullable="false"/>
        <field name="status" type="string" column="status" length="20" enum-type="App\Payments\Domain\Model\Payout\PayoutStatus" nullable="false"/>
        <field name="gateway" type="string" column="gateway" length="50" nullable="true"/>
        <field name="externalId" type="string" column="external_id" length="255" nullable="true"/>
        <field name="reference" type="string" column="reference" length="255" nullable="true"/>
        <field name="evidence" type="string" column="evidence" length="36" nullable="true"/>
        <field name="failureReason" type="text" column="failure_reason" nullable="true"/>
        <field name="createdBy" type="user_id" column="created_by" nullable="true"/>
        <field name="resolvedBy" type="user_id" column="resolved_by" nullable="true"/>
        <field name="notes" type="text" column="notes" nullable="true"/>
        <field name="periodFrom" type="datetime_immutable" column="period_from" nullable="true"/>
        <field name="periodTo" type="datetime_immutable" column="period_to" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="sentAt" type="datetime_immutable" column="sent_at" nullable="true"/>
        <field name="resolvedAt" type="datetime_immutable" column="resolved_at" nullable="true"/>

        <indexes>
            <index columns="payee_id" name="idx_payout_payee_id"/>
            <index columns="status" name="idx_payout_status"/>
            <index columns="created_at" name="idx_payout_created_at"/>
        </indexes>
    </entity>
</doctrine-mapping>
