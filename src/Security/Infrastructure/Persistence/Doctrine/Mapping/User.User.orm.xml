<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Security\Domain\Model\User\User" table="user">
        <id name="id" type="user_id" column="id">
            <generator strategy="NONE" />
        </id>

        <embedded name="recoverToken" class="App\Security\Domain\Model\User\RecoverToken" use-column-prefix="true" column-prefix="recover_" />

        <field name="username" type="string" length="255" nullable="false"/>
        <field name="password" type="string" length="1024" nullable="false"/>
        <field name="roles" type="array" nullable="false"/>
        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>
        <field name="accountId" type="account_id" nullable="true"/>
        <field name="preferredLocale" type="locale" column="preferred_locale" nullable="true"/>
        <field name="pictureId" type="media_id" column="picture_id" nullable="true"/>

        <many-to-one field="account" target-entity="App\Security\Domain\Model\Account\Account">
            <cascade><cascade-remove /></cascade>
            <join-column name="account_id" referenced-column-name="id" on-delete="CASCADE" />
        </many-to-one>
    </entity>
</doctrine-mapping>
