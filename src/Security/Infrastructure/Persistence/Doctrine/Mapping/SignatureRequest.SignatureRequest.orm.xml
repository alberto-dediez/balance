<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Security\Domain\Model\SignatureRequest\SignatureRequest" table="signature_requests">
        <id name="id" type="signature_request_id" column="id">
            <generator strategy="NONE" />
        </id>

        <unique-constraints>
            <unique-constraint columns="token_hash" name="uq_signature_request_token_hash"/>
        </unique-constraints>

        <embedded name="token" class="App\Security\Domain\Model\SignatureRequest\Token" use-column-prefix="true" column-prefix="token_" />
        <embedded name="documentToSign" class="App\Security\Domain\Model\SignatureRequest\DocumentReference" use-column-prefix="true" column-prefix="doc_to_sign_" />
        <embedded name="documentSigned" class="App\Security\Domain\Model\SignatureRequest\DocumentReference" use-column-prefix="true" column-prefix="doc_signed_" />
        <embedded name="signer" class="App\Security\Domain\Model\SignatureRequest\Signer" use-column-prefix="true" column-prefix="signer_" />
        <embedded name="signatureProof" class="App\Security\Domain\Model\SignatureRequest\SignatureProof" use-column-prefix="true" column-prefix="proof_" />
        <embedded name="otpChallenge" class="App\Security\Domain\Model\SignatureRequest\OtpChallenge" use-column-prefix="true" column-prefix="otp_" />

        <field name="status" type="string" enum-type="App\Security\Domain\Model\SignatureRequest\SignatureRequestStatus" nullable="false"/>
        <field name="expiresAt" type="datetime_immutable" column="expires_at" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="true"/>
        <field name="removed" type="boolean" nullable="false"/>
        <field name="otpRequired" type="boolean" column="otp_required" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>
    </entity>

</doctrine-mapping>
