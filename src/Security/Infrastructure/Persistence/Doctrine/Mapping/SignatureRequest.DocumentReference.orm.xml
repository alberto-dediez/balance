<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\Security\Domain\Model\SignatureRequest\DocumentReference">
        <field name="sha256" type="string" length="64" nullable="true"/>
        <field name="size" type="integer" nullable="true"/>
        <field name="filename" type="string" length="512" nullable="true"/>
        <field name="path" type="string" length="2048" nullable="true"/>
    </embeddable>

</doctrine-mapping>
