<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\Security\Domain\Model\SignatureRequest\Signer">
        <field name="name" type="string" length="255" nullable="false"/>
        <field name="locale" type="locale" nullable="false"/>
        <field name="email" type="string" length="255" nullable="true"/>
        <field name="phone" type="string" length="64" nullable="true"/>
        <field name="notificationChannel" type="string" enum-type="App\Security\Domain\Model\SignatureRequest\NotificationChannel" nullable="false"/>
    </embeddable>

</doctrine-mapping>
