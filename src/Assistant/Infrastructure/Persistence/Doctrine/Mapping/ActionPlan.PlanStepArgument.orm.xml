<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Assistant\Domain\Model\ActionPlan\PlanStepArgument" table="assistant_plan_step_argument">
        <indexes>
            <index name="idx_assistant_plan_step_argument_step" columns="step_id"/>
        </indexes>

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO" />
        </id>

        <many-to-one field="step" target-entity="App\Assistant\Domain\Model\ActionPlan\PlanStep" inversed-by="arguments">
            <join-column name="step_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <field name="name" type="string" length="64" nullable="false"/>
        <field name="position" type="integer" nullable="false"/>
        <field name="value" type="text" nullable="false"/>
        <field name="display" type="string" length="255" nullable="true"/>
        <field name="fromStep" type="integer" column="from_step" nullable="true"/>
    </entity>

</doctrine-mapping>
