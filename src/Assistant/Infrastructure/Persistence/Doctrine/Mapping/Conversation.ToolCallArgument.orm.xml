<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Assistant\Domain\Model\Conversation\ToolCallArgument" table="assistant_tool_call_argument">
        <indexes>
            <index name="idx_assistant_tool_call_argument_call" columns="tool_call_id"/>
        </indexes>

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO" />
        </id>

        <many-to-one field="toolCall" target-entity="App\Assistant\Domain\Model\Conversation\ToolCall" inversed-by="arguments">
            <join-column name="tool_call_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <field name="name" type="string" length="64" nullable="false"/>
        <field name="position" type="integer" nullable="false"/>
        <field name="value" type="text" nullable="false"/>
    </entity>

</doctrine-mapping>
