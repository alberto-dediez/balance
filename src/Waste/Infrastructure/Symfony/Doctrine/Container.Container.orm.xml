<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Waste\Domain\Model\Container\Container" table="containers">
        <embedded name="id" class="App\Waste\Domain\Model\Container\ContainerId" use-column-prefix="false" />

        <field name="purpose" type="object" nullable="false"/>
        <field name="measurementMethod" type="object" nullable="false"/>
        <field name="removed" type="boolean" nullable="true"/>
        <field name="events" type="array" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>


        <field name="propertyId" type="string" length="36" nullable="true"/>
        <field name="wasteId" type="string" length="36" nullable="true"/>
    </entity>

</doctrine-mapping>
