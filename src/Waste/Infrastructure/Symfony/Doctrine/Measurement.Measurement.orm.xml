<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Waste\Domain\Model\Measurement\Measurement" table="measurements">
        <id name="id" type="measurement_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="containerId" type="container_id" nullable="true" />
        <field name="propertyId" type="property_id" nullable="true" />
        <field name="accountId" type="account_id" nullable="true" />
        <field name="wasteId" type="waste_id" nullable="true" />
        <field name="purpose" type="string" enum-type="App\Waste\Domain\Model\Container\Purpose" nullable="false" />
        <field name="measurementMethod" type="string" enum-type="App\Waste\Domain\Model\Container\MeasurementMethod" nullable="false" />
        <field name="wasteManagerId" type="string" length="36" nullable="true" />

        <field name="quantity" type="integer" nullable="false" />
        <field name="load" type="decimal" scale="4" precision="14" nullable="false" column="container_load" />
        <field name="justification" type="text" nullable="true" />

        <field name="registeredBy" type="string" length="36" nullable="false" />
        
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
    </entity>

</doctrine-mapping>
