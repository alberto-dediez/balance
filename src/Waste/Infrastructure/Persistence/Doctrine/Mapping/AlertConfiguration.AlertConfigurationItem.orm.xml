<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Waste\Domain\Model\AlertConfiguration\AlertConfigurationItem" table="alert_configuration_items">
        <id name="id" type="alert_configuration_item_id" column="id">
            <generator strategy="NONE" />
        </id>

        <many-to-one field="alertConfiguration" target-entity="App\Waste\Domain\Model\AlertConfiguration\AlertConfiguration" inversed-by="items">
            <join-column name="alert_configuration_id" referenced-column-name="id" on-delete="CASCADE" nullable="false" />
        </many-to-one>

        <field name="type" type="string" enum-type="App\Waste\Domain\Model\Alert\AlertType" nullable="false" />
        <field name="enabled" type="boolean" nullable="false" />
        <field name="parameters" type="json" column="parameters" nullable="false" />

        <unique-constraints>
            <unique-constraint name="uq_alert_config_item_type" columns="alert_configuration_id,type" />
        </unique-constraints>
    </entity>

</doctrine-mapping>
