<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Waste\Domain\Model\AlertConfiguration\AlertConfiguration" table="alert_configurations">
        <id name="id" type="alert_configuration_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="accountId" type="account_id" column="account_id" nullable="true" />
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true" />

        <one-to-many field="items" target-entity="App\Waste\Domain\Model\AlertConfiguration\AlertConfigurationItem" mapped-by="alertConfiguration" orphan-removal="true" fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <unique-constraints>
            <unique-constraint name="uq_alert_config_account" columns="account_id" />
        </unique-constraints>
    </entity>

</doctrine-mapping>
