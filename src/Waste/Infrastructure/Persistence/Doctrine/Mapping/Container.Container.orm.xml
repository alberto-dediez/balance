<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Waste\Domain\Model\Container\Container" table="containers">
        <id name="id" type="container_id" column="id">
            <generator strategy="NONE" />
        </id>
        <embedded name="qrCode" class="App\Waste\Domain\Model\Container\QrCode" column-prefix="qr_" />

        <field name="purpose" type="string" enum-type="App\Waste\Domain\Model\Container\Purpose" nullable="false"/>
        <field name="measurementMethod" type="string" enum-type="App\Waste\Domain\Model\Container\MeasurementMethod" nullable="false"/>
        <field name="volume" type="decimal" scale="2" precision="12"  nullable="true"/>
        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="printedAt" type="datetime_immutable" column="printed_at" nullable="true"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>

        <field name="accountId" type="account_id" nullable="true"/>
        <field name="propertyId" type="property_id" nullable="true"/>
        <field name="wasteId" type="waste_id" nullable="true"/>
        <field name="wasteManagerId" type="waste_manager_id" nullable="true"/>
    </entity>

</doctrine-mapping>
