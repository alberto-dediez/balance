<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Waste\Domain\Model\Alert\Alert" table="alerts">
        <id name="id" type="alert_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="type" type="string" enum-type="App\Waste\Domain\Model\Alert\AlertType" nullable="false" />
        <field name="status" type="string" enum-type="App\Waste\Domain\Model\Alert\AlertStatus" nullable="false" />
        <field name="propertyId" type="property_id" column="property_id" nullable="true" />
        <field name="wasteId" type="waste_id" column="waste_id" nullable="true" />
        <field name="accountId" type="account_id" column="account_id" nullable="true" />
        <field name="detectedAt" type="datetime_immutable" column="detected_at" nullable="false" />
        <field name="periodFrom" type="datetime_immutable" column="period_from" nullable="false" />
        <field name="periodTo" type="datetime_immutable" column="period_to" nullable="false" />
        <field name="value" type="float" nullable="true" />
        <field name="threshold" type="float" nullable="true" />
    </entity>

</doctrine-mapping>
