<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Property\Domain\Model\Property\Property" table="properties">
        <id name="id" type="property_id" column="id">
            <generator strategy="NONE" />
        </id>

        <embedded name="info" class="App\Property\Domain\Model\Property\PropertyInfo" use-column-prefix="false" />
        <embedded name="externalId" class="App\Property\Domain\Model\Property\ExternalId" use-column-prefix="false" />

        <field name="name" type="string" length="255" nullable="false" />
        <field name="accountId" type="account_id" nullable="true" />
        <field name="companyId" type="company_id" column="company_id" nullable="true" />
        
        <field name="numberOfEmployees" type="integer" column="number_of_employees" nullable="true" />
        <field name="dailyClients" type="integer" column="daily_clients" nullable="true" />

        <field name="removed" type="boolean" nullable="true" />
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false" />
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true" />
    </entity>

</doctrine-mapping>
