<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\Property\Domain\Model\Property\PropertyInfo">
        <field name="propertyType" type="string" enum-type="App\Property\Domain\Model\Property\PropertyType" nullable="true"/>
        <field name="categoryId" type="string" length="36" nullable="true"/>
        <field name="brandId" type="string" length="36" nullable="true"/>
        <field name="address" type="string" length="1024" nullable="true"/>
        <field name="postalCode" type="string" length="20" nullable="true"/>
        <field name="longitude" type="decimal" scale="10" precision="14" nullable="true"/>
        <field name="latitude" type="decimal" scale="10" precision="14" nullable="true"/>
        <field name="rooms" type="integer" nullable="true"/>
        <field name="zone" type="string" length="512" nullable="true" />
        <field name="web" type="string" length="1024" nullable="true" />
        <field name="destinationId" type="string" length="36" nullable="true"/>
        <field name="countryId" type="string" length="36" nullable="true"/>
    </embeddable>
</doctrine-mapping>
