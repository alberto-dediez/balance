<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Shared\Domain\CommandBus\ScheduledCommandRecord" table="scheduled_command_records">
        <id name="commandId" type="string" length="128" column="command_id">
            <generator strategy="NONE" />
        </id>

        <field name="lastRunAt" type="datetime_immutable" column="last_run_at" nullable="false" />
    </entity>
</doctrine-mapping>
