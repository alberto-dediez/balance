<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Shared\Domain\Model\Integration\IntegrationOutboxMessage" table="integration_outbox">
        <id name="sequence" type="integer" column="sequence">
            <generator strategy="IDENTITY" />
        </id>

        <unique-constraints>
            <unique-constraint columns="message_id" name="uniq_integration_outbox_message_id"/>
        </unique-constraints>

        <indexes>
            <index columns="sent_at,sequence" name="idx_integration_outbox_pending"/>
        </indexes>

        <field name="messageId" type="string" length="36" column="message_id" nullable="false"/>
        <field name="type" type="string" length="150" column="type" nullable="false"/>
        <field name="version" type="integer" column="version" nullable="false"/>
        <field name="aggregateId" type="string" length="64" column="aggregate_id" nullable="true"/>
        <field name="accountRef" type="string" length="64" column="account_ref" nullable="true"/>
        <field name="correlationId" type="string" length="36" column="correlation_id" nullable="false"/>
        <field name="causationId" type="string" length="36" column="causation_id" nullable="true"/>
        <field name="hops" type="integer" column="hops" nullable="false"/>
        <field name="occurredOn" type="datetime_immutable" column="occurred_on" nullable="false"/>
        <field name="payload" type="text" column="payload" nullable="false"/>
        <field name="sentAt" type="datetime_immutable" column="sent_at" nullable="true"/>
        <field name="attempts" type="integer" column="attempts" nullable="false"/>
        <field name="lastError" type="string" length="1000" column="last_error" nullable="true"/>
    </entity>
</doctrine-mapping>
