<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Balance\Domain\Model\AccountProject\AccountProject" table="account_projects">
        <id name="id" type="account_project_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="accountId" type="account_id" column="account_id" nullable="false"/>
        <field name="projectId" type="project_id" column="project_id" nullable="false"/>
        <field name="selectedAt" type="datetime_immutable" column="selected_at" nullable="false"/>

        <unique-constraints>
            <unique-constraint columns="account_id,project_id" name="uq_account_project"/>
        </unique-constraints>

        <indexes>
            <index columns="account_id" name="idx_account_project_account_id"/>
            <index columns="project_id" name="idx_account_project_project_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
