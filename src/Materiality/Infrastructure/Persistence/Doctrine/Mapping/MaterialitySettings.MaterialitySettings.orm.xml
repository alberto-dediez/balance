<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Materiality\Domain\Model\MaterialitySettings\MaterialitySettings" table="materiality_settings">
        <id name="id" type="materiality_settings_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="relevanceThresholdPercent" type="smallint" column="relevance_threshold_percent" nullable="false"/>
        <field name="highMagnitudeForcesInclusion" type="boolean" column="high_magnitude_forces_inclusion" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
    </entity>
</doctrine-mapping>
