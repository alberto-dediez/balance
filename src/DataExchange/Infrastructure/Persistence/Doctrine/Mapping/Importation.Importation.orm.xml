<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\DataExchange\Domain\Model\Importation\Importation" table="importation">
        <id name="id" type="importation_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="name" type="string" length="255" nullable="false" />
        <field name="type" type="string" length="255" nullable="false" />
        <field name="status" type="string" enum-type="App\DataExchange\Domain\Model\Importation\ImportationStatus" nullable="true"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false" />
        <field name="executedAt" type="datetime_immutable" column="executed_at" nullable="true" />
        <field name="accountId" type="account_id" nullable="true" />
        <field name="registeredBy" type="user_id" nullable="true" />
        <field name="defaultValues" type="array" nullable="true" />
    </entity>

</doctrine-mapping>
