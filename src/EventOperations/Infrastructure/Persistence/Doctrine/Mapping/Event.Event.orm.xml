<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\EventOperations\Domain\Model\Event\Event" table="events">
        <id name="id" type="event_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="name" type="string" length="255" nullable="false" />
        <field name="location" type="destination_id" column="location_id" nullable="true" />
        <field name="size" type="string" enum-type="App\EventOperations\Domain\Model\Event\EventSize" nullable="true" />
        <field name="estimatedAttendees" type="integer" column="estimated_attendees" nullable="true" />
        <field name="sector" type="string" enum-type="App\EventOperations\Domain\Model\Event\EventSector" nullable="true" />
        <field name="typology" type="string" enum-type="App\EventOperations\Domain\Model\Event\EventTypology" nullable="true" />

        <embedded name="setup" class="App\EventOperations\Domain\Model\Event\DateRange" use-column-prefix="true" column-prefix="setup_" />
        <embedded name="celebration" class="App\EventOperations\Domain\Model\Event\DateRange" use-column-prefix="true" column-prefix="celebration_" />
        <embedded name="dismantling" class="App\EventOperations\Domain\Model\Event\DateRange" use-column-prefix="true" column-prefix="dismantling_" />

        <field name="accountId" type="account_id" column="account_id" nullable="true" />

        <field name="removed" type="boolean" nullable="true" />
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true" />
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true" />
    </entity>

</doctrine-mapping>
