<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\BaseYearDeclaration\BaseYearDeclaration" table="carbon_footprint_base_year_declarations">
        <unique-constraints>
            <unique-constraint name="UNIQ_byd_subject" columns="subject_type,subject_id"/>
        </unique-constraints>
        <indexes>
            <index name="IDX_byd_account" columns="account_id" />
        </indexes>

        <id name="id" type="base_year_declaration_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="subjectType" type="string" column="subject_type" length="16" nullable="false" enum-type="App\CarbonFootprint\Domain\Model\CarbonFootprintReport\CarbonFootprintReportSubjectType"/>
        <field name="subjectId" type="string" column="subject_id" length="36" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="false"/>
        <field name="year" type="integer" column="year" nullable="false"/>
        <field name="justification" type="text" column="justification" nullable="false"/>
        <field name="recalculationThresholdPercent" type="decimal" column="recalculation_threshold_percent" precision="5" scale="2" nullable="false"/>
        <field name="primaryIndicator" type="string" column="primary_indicator" length="32" nullable="true" enum-type="App\CarbonFootprint\Domain\Model\OrganizationalCarbonFootprint\IntensityIndicator"/>
        <field name="baseYearTotalKgCo2eq" type="decimal" column="base_year_total_kg_co2eq" precision="16" scale="2" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="false"/>
    </entity>
</doctrine-mapping>
