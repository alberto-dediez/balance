<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\Contest\ContestAllowedCountry" table="contest_allowed_countries">
        <id name="id" type="contest_allowed_country_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="countryIso" type="string" length="2" column="country_iso" nullable="false" />

        <many-to-one field="contest" target-entity="App\CarbonFootprint\Domain\Model\Contest\Contest" inversed-by="allowedCountries">
            <join-column name="contest_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint name="uq_contest_allowed_country" columns="contest_id,country_iso" />
        </unique-constraints>
    </entity>

</doctrine-mapping>
