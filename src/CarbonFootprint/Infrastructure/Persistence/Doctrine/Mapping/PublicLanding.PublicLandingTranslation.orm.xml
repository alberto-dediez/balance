<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\PublicLanding\PublicLandingTranslation" table="public_landings_translation">
        <id name="locale" type="locale" length="5" />
        <field name="title" type="string" length="255" nullable="false" />
        <field name="subtitle" type="string" length="255" nullable="false" />
        <field name="intro" type="text" nullable="false" />
        <field name="ctaLabel" type="string" length="255" column="cta_label" nullable="false" />
        <id name="translatable" association-key="true" />

        <many-to-one field="translatable" target-entity="App\CarbonFootprint\Domain\Model\PublicLanding\PublicLanding" inversed-by="translations">
            <join-column name="public_landing_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
