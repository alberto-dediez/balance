<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\TripCalculationLink\TripCalculationLinkDestinationCountry" table="trip_calculation_link_destination_countries">
        <id name="id" type="trip_calculation_link_destination_country_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="countryId" type="country_id" column="country_id" nullable="false" />

        <many-to-one field="tripCalculationLink" target-entity="App\CarbonFootprint\Domain\Model\TripCalculationLink\TripCalculationLink" inversed-by="destinationCountries">
            <join-column name="trip_calculation_link_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint name="uniq_trip_link_destination_country" columns="trip_calculation_link_id,country_id" />
        </unique-constraints>
    </entity>

</doctrine-mapping>
