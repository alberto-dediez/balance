<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\CarbonFootprint\Domain\Model\OrganizationalCarbonFootprint\IntensityDenominators">
        <field name="occupiedRooms" type="integer" column="occupied_rooms" nullable="true"/>
        <field name="stays" type="integer" column="stays" nullable="true"/>
        <field name="builtAreaM2" type="decimal" column="built_area_m2" precision="12" scale="2" nullable="true"/>
        <field name="coversServed" type="integer" column="covers_served" nullable="true"/>
        <field name="averageHeadcount" type="decimal" column="average_headcount" precision="10" scale="2" nullable="true"/>
        <field name="revenueEur" type="decimal" column="revenue_eur" precision="16" scale="2" nullable="true"/>
        <field name="customersServed" type="integer" column="customers_served" nullable="true"/>
    </embeddable>

</doctrine-mapping>
