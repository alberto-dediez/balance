<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\EconomicSector\EconomicSector" table="economic_sectors">
        <id name="id" type="economic_sector_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="name" type="string" length="255" nullable="false"/>
        <field name="unit" type="string" enum-type="App\CarbonFootprint\Domain\Model\Unit" nullable="false"/>
        <field name="classificationCode" type="string" column="classification_code" length="20" nullable="true"/>
        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>

        <indexes>
            <index columns="classification_code" name="idx_economic_sector_classification_code"/>
        </indexes>

        <one-to-many field="translations"
                     target-entity="App\CarbonFootprint\Domain\Model\EconomicSector\EconomicSectorTranslation"
                     mapped-by="translatable"
                     fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="emissionFactors"
                     target-entity="App\CarbonFootprint\Domain\Model\EconomicSector\EconomicSectorEmissionFactor"
                     mapped-by="economicSector"
                     orphan-removal="true"
                     fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
