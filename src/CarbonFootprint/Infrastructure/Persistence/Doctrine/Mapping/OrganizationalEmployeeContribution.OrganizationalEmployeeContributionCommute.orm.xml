<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\OrganizationalEmployeeContribution\OrganizationalEmployeeContributionCommute" table="organizational_employee_contribution_commutes">
        <id name="id" type="organizational_employee_contribution_commute_id" column="id">
            <generator strategy="NONE" />
        </id>

        <many-to-one field="contribution" target-entity="App\CarbonFootprint\Domain\Model\OrganizationalEmployeeContribution\OrganizationalEmployeeContribution" inversed-by="commutes">
            <join-column name="contribution_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <field name="mobilityId" type="mobility_id" column="mobility_id" nullable="false"/>
        <field name="distanceKm" type="float" column="distance_km" nullable="false"/>
        <field name="daysPerWeek" type="smallint" column="days_per_week" nullable="false"/>
        <field name="vehicleOccupants" type="smallint" column="vehicle_occupants" nullable="false"/>
    </entity>

</doctrine-mapping>
