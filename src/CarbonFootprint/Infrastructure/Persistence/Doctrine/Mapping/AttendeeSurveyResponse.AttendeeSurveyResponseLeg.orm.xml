<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\AttendeeSurveyResponse\AttendeeSurveyResponseLeg" table="attendee_survey_response_legs">
        <id name="id" type="attendee_survey_response_leg_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="position" type="integer" column="position" nullable="false" />
        <field name="kind" type="string" length="20" column="kind" enum-type="App\CarbonFootprint\Domain\Model\AttendeeSurveyResponse\LegKind" nullable="false" />
        <field name="mobilityId" type="mobility_id" column="mobility_id" nullable="false" />
        <field name="vehicleOccupants" type="integer" column="vehicle_occupants" nullable="true" />

        <field name="originPlaceReference" type="string" length="255" column="origin_place_reference" nullable="true" />
        <field name="originLabel" type="string" length="255" column="origin_label" nullable="true" />
        <field name="originLatitude" type="float" column="origin_latitude" nullable="true" />
        <field name="originLongitude" type="float" column="origin_longitude" nullable="true" />

        <field name="destinationPlaceReference" type="string" length="255" column="destination_place_reference" nullable="true" />
        <field name="destinationLabel" type="string" length="255" column="destination_label" nullable="true" />
        <field name="destinationLatitude" type="float" column="destination_latitude" nullable="true" />
        <field name="destinationLongitude" type="float" column="destination_longitude" nullable="true" />

        <field name="distanceKm" type="float" column="distance_km" nullable="true" />
        <field name="distanceSource" type="string" length="20" column="distance_source" enum-type="App\CarbonFootprint\Domain\Model\Geo\DistanceSource" nullable="false" />

        <many-to-one field="response" target-entity="App\CarbonFootprint\Domain\Model\AttendeeSurveyResponse\AttendeeSurveyResponse" inversed-by="legs">
            <join-column name="attendee_survey_response_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <indexes>
            <index name="idx_attendee_survey_response_legs_response" columns="attendee_survey_response_id,position" />
        </indexes>
    </entity>

</doctrine-mapping>
