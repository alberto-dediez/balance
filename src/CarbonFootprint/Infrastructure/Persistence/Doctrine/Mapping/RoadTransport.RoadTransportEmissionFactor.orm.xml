<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\RoadTransport\RoadTransportEmissionFactor" table="road_transport_emission_factor">
        <unique-constraints>
            <unique-constraint columns="road_transport_id,year,emission_factor_group_id" name="uq_road_transport_emission_factor_year"/>
        </unique-constraints>

        <id name="id" type="road_transport_emission_factor_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>

        <embedded name="emissionFactor" class="App\CarbonFootprint\Domain\Model\EmissionFactor\EmissionFactor" use-column-prefix="false"/>

        <many-to-one field="roadTransport" target-entity="App\CarbonFootprint\Domain\Model\RoadTransport\RoadTransport" inversed-by="emissionFactors">
            <join-column name="road_transport_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
