<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\ElectricityMix\ElectricityMix" table="electricity_mixes">
        <indexes>
            <index name="idx_electricity_mixes_country" columns="country_id"/>
        </indexes>

        <id name="id" type="electricity_mix_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="countryId" type="country_id" column="country_id" nullable="false"/>
        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>

        <one-to-many field="emissionFactors"
                     target-entity="App\CarbonFootprint\Domain\Model\ElectricityMix\ElectricityMixEmissionFactor"
                     mapped-by="electricityMix"
                     orphan-removal="true"
                     fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
