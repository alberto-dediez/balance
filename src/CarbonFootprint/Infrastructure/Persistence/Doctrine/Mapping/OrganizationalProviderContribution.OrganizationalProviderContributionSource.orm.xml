<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\OrganizationalProviderContribution\OrganizationalProviderContributionSource" table="organizational_provider_contribution_sources">
        <unique-constraints>
            <unique-constraint columns="contribution_id,source" name="UNIQ_opcs_contribution_source"/>
        </unique-constraints>

        <id name="id" type="organizational_provider_contribution_source_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="source" type="string" length="50" enum-type="App\CarbonFootprint\Domain\Model\CarbonFootprint\Source" nullable="false"/>

        <many-to-one field="contribution" target-entity="App\CarbonFootprint\Domain\Model\OrganizationalProviderContribution\OrganizationalProviderContribution" inversed-by="sources">
            <join-column name="contribution_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
