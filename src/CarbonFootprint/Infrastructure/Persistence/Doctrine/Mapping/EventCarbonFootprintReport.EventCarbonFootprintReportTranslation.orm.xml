<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\EventCarbonFootprintReport\EventCarbonFootprintReportTranslation" table="event_carbon_footprint_report_translation">
        <id name="locale" type="locale" length="5" />
        <field name="filePath" type="string" column="file_path" length="255" nullable="false" />
        <id name="translatable" association-key="true" />

        <many-to-one field="translatable" target-entity="App\CarbonFootprint\Domain\Model\EventCarbonFootprintReport\EventCarbonFootprintReport" inversed-by="translations">
            <join-column name="event_carbon_footprint_report_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
