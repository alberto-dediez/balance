<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\ExchangeRate\ExchangeRate" table="exchange_rates">
        <unique-constraints>
            <unique-constraint name="uq_exchange_rates_currency" columns="currency"/>
        </unique-constraints>

        <id name="id" type="exchange_rate_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="currency" type="string" length="3" nullable="false" enum-type="App\CarbonFootprint\Domain\Model\Unit"/>
        <field name="date" type="date_immutable" nullable="false"/>
        <field name="rate" type="decimal" precision="18" scale="8" nullable="false"/>
        <field name="fetchedAt" type="datetime_immutable" column="fetched_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
    </entity>
</doctrine-mapping>
