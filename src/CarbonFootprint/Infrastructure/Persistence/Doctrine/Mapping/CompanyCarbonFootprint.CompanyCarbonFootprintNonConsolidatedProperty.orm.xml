<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\CompanyCarbonFootprint\CompanyCarbonFootprintNonConsolidatedProperty" table="company_carbon_footprint_non_consolidated_properties">
        <unique-constraints>
            <unique-constraint name="UNIQ_ccf_ncp_property" columns="company_carbon_footprint_id,property_id" />
        </unique-constraints>

        <id name="id" type="company_carbon_footprint_non_consolidated_property_id" column="id">
            <generator strategy="NONE" />
        </id>

        <many-to-one field="companyCarbonFootprint" target-entity="App\CarbonFootprint\Domain\Model\CompanyCarbonFootprint\CompanyCarbonFootprint" inversed-by="nonConsolidatedProperties">
            <join-column name="company_carbon_footprint_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <field name="propertyId" type="property_id" column="property_id" nullable="false" />
        <field name="source" type="string" enum-type="App\CarbonFootprint\Domain\Model\CarbonFootprint\Source" nullable="false" />
        <field name="propertyCarbonFootprintId" type="property_carbon_footprint_id" column="property_carbon_footprint_id" nullable="true" />

        <embedded name="calculatedEmissions" class="App\CarbonFootprint\Domain\Model\Emissions" use-column-prefix="true" column-prefix="calculated_emissions_" />

        <field name="manualCo2eq" type="string" column="manual_co2eq" nullable="true" />
        <field name="recordedAt" type="datetime_immutable" column="recorded_at" nullable="false" />
    </entity>

</doctrine-mapping>
