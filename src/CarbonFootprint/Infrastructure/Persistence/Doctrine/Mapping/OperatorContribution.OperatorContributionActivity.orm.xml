<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\OperatorContribution\OperatorContributionActivity" table="operator_contribution_activities">
        <indexes>
            <index name="IDX_oca_contribution" columns="operator_contribution_id"/>
        </indexes>

        <id name="id" type="operator_contribution_activity_id" column="id">
            <generator strategy="NONE" />
        </id>

        <many-to-one field="contribution" target-entity="App\CarbonFootprint\Domain\Model\OperatorContribution\OperatorContribution" inversed-by="activities">
            <join-column name="operator_contribution_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <field name="activityId" type="activity_id" column="activity_id" nullable="false" />
        <field name="scope" type="string" length="20" enum-type="App\CarbonFootprint\Domain\Model\OrganizationalCarbonFootprint\Scope" nullable="false" />
        <field name="source" type="string" length="50" enum-type="App\CarbonFootprint\Domain\Model\CarbonFootprint\Source" nullable="false" />
        <field name="addedAt" type="datetime_immutable" column="added_at" nullable="false" />
    </entity>

</doctrine-mapping>
