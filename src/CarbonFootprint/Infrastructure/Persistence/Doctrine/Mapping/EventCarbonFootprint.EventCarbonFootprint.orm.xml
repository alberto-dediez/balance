<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\EventCarbonFootprint\EventCarbonFootprint" table="event_carbon_footprints">
        <id name="id" type="event_carbon_footprint_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="eventId" type="event_id" column="event_id" nullable="false" />
        <field name="accountId" type="account_id" column="account_id" nullable="false" />
        <field name="emissionFactorGroupId" type="emission_factor_group_id" column="emission_factor_group_id" nullable="false" />

        <embedded name="calculationPeriod" class="App\EventOperations\Domain\Model\Event\DateRange" use-column-prefix="true" column-prefix="calculation_period_" />
        <embedded name="totalEmissions" class="App\CarbonFootprint\Domain\Model\Emissions" use-column-prefix="true" column-prefix="total_emissions_" />
        <embedded name="emissionsPerAttendee" class="App\CarbonFootprint\Domain\Model\Emissions" use-column-prefix="true" column-prefix="emissions_per_attendee_" />

        <field name="status" type="string" enum-type="App\CarbonFootprint\Domain\Model\EventCarbonFootprint\EventCarbonFootprintStatus" nullable="false" />

        <field name="removed" type="boolean" nullable="false" />
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true" />
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true" />

        <one-to-many field="activities" target-entity="App\CarbonFootprint\Domain\Model\EventCarbonFootprint\EventCarbonFootprintActivity" mapped-by="eventCarbonFootprint" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>

        <one-to-many field="exclusions" target-entity="App\CarbonFootprint\Domain\Model\EventCarbonFootprint\EventCarbonFootprintExclusion" mapped-by="eventCarbonFootprint" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
        </one-to-many>
    </entity>

</doctrine-mapping>
