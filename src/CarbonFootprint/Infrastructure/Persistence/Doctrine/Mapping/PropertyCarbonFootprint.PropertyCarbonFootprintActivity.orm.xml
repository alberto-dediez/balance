<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\PropertyCarbonFootprint\PropertyCarbonFootprintActivity" table="property_carbon_footprint_activities">
        <id name="id" type="property_carbon_footprint_activity_id" column="id">
            <generator strategy="NONE" />
        </id>

        <many-to-one field="propertyCarbonFootprint" target-entity="App\CarbonFootprint\Domain\Model\PropertyCarbonFootprint\PropertyCarbonFootprint" inversed-by="activities">
            <join-column name="property_carbon_footprint_id" referenced-column-name="id" nullable="false" />
        </many-to-one>

        <field name="activityId" type="activity_id" column="activity_id" nullable="false" />
        <field name="scope" type="string" enum-type="App\CarbonFootprint\Domain\Model\OrganizationalCarbonFootprint\Scope" nullable="false" />
        <field name="source" type="string" enum-type="App\CarbonFootprint\Domain\Model\CarbonFootprint\Source" nullable="false" />
        <field name="providerId" type="provider_id" column="provider_id" nullable="true" />
        <field name="fromEmployees" type="boolean" column="from_employees" nullable="false">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="addedAt" type="datetime_immutable" column="added_at" nullable="false" />
    </entity>

</doctrine-mapping>
