<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\OrganizationalEmployeeParticipation\OrganizationalEmployeeParticipation" table="organizational_employee_participations">
        <unique-constraints>
            <unique-constraint columns="subject_type,carbon_footprint_id" name="UNIQ_oep_footprint"/>
        </unique-constraints>

        <indexes>
            <index name="IDX_oep_account" columns="account_id"/>
        </indexes>

        <id name="id" type="organizational_employee_participation_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="subjectType" type="string" length="20" enum-type="App\CarbonFootprint\Domain\Model\CarbonFootprintReport\CarbonFootprintReportSubjectType" column="subject_type" nullable="false"/>
        <field name="carbonFootprintId" type="string" length="36" column="carbon_footprint_id" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="false"/>
        <field name="totalEmployees" type="integer" column="total_employees" nullable="true"/>
        <field name="confidenceLevel" type="smallint" column="confidence_level" enum-type="App\CarbonFootprint\Domain\Model\AttendeeSurvey\ConfidenceLevel" nullable="true"/>
        <field name="marginOfError" type="float" column="margin_of_error" nullable="true"/>
        <field name="answeredCount" type="integer" column="answered_count" nullable="true"/>
        <field name="aggregatedAt" type="datetime_immutable" column="aggregated_at" nullable="true"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
    </entity>

</doctrine-mapping>
