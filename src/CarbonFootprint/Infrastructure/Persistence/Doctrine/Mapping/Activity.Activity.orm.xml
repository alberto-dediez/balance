<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\Activity\Activity" table="activities" inheritance-type="JOINED">
        <discriminator-column name="type" type="string" />
        <discriminator-map>
            <discriminator-mapping value="material" class="App\CarbonFootprint\Domain\Model\Activity\MaterialActivity" />
            <discriminator-mapping value="catering_item" class="App\CarbonFootprint\Domain\Model\Activity\CateringItemActivity" />
            <discriminator-mapping value="merchandising_item" class="App\CarbonFootprint\Domain\Model\Activity\MerchandisingItemActivity" />
            <discriminator-mapping value="purchase_service" class="App\CarbonFootprint\Domain\Model\Activity\PurchaseServiceActivity" />
            <discriminator-mapping value="capital_good" class="App\CarbonFootprint\Domain\Model\Activity\CapitalGoodActivity" />
            <discriminator-mapping value="use_profile" class="App\CarbonFootprint\Domain\Model\Activity\UseProfileActivity" />
            <discriminator-mapping value="process" class="App\CarbonFootprint\Domain\Model\Activity\ProcessActivity" />
            <discriminator-mapping value="economic_sector" class="App\CarbonFootprint\Domain\Model\Activity\EconomicSectorActivity" />
            <discriminator-mapping value="combustible" class="App\CarbonFootprint\Domain\Model\Activity\CombustibleActivity" />
            <discriminator-mapping value="electricity" class="App\CarbonFootprint\Domain\Model\Activity\ElectricityActivity" />
            <discriminator-mapping value="machinery_fuel" class="App\CarbonFootprint\Domain\Model\Activity\MachineryFuelActivity" />
            <discriminator-mapping value="mobility" class="App\CarbonFootprint\Domain\Model\Activity\MobilityActivity" />
            <discriminator-mapping value="overnight_stay" class="App\CarbonFootprint\Domain\Model\Activity\OvernightStayActivity" />
            <discriminator-mapping value="road_transport" class="App\CarbonFootprint\Domain\Model\Activity\RoadTransportActivity" />
            <discriminator-mapping value="waste" class="App\CarbonFootprint\Domain\Model\Activity\WasteActivity" />
            <discriminator-mapping value="refrigerant_gas" class="App\CarbonFootprint\Domain\Model\Activity\RefrigerantGasActivity" />
        </discriminator-map>

        <id name="id" type="activity_id" column="id">
            <generator strategy="NONE" />
        </id>

        <embedded name="emissionFactor" class="App\CarbonFootprint\Domain\Model\EmissionFactor\EmissionFactor" use-column-prefix="true" column-prefix="emission_factor_" />
        <embedded name="emissions" class="App\CarbonFootprint\Domain\Model\Emissions" use-column-prefix="true" column-prefix="emissions_" />

        <embedded name="quantity" class="App\CarbonFootprint\Domain\Model\Quantity" use-column-prefix="false" />
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true" />
        <field name="accountId" type="account_id" column="account_id" nullable="true" />
    </entity>

</doctrine-mapping>
