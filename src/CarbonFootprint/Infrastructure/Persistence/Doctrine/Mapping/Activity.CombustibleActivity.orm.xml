<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\Activity\CombustibleActivity" table="combustible_activities">
        <field name="combustibleId" type="combustible_id" column="combustible_id" nullable="false" />
        <field name="source" type="string" length="255" nullable="true" />
        <embedded name="wellToTankEmissionFactor" class="App\CarbonFootprint\Domain\Model\EmissionFactor\EmissionFactor" use-column-prefix="true" column-prefix="well_to_tank_emission_factor_"/>
        <embedded name="wellToTankEmissions" class="App\CarbonFootprint\Domain\Model\Emissions" use-column-prefix="true" column-prefix="well_to_tank_emissions_"/>
    </entity>

</doctrine-mapping>
