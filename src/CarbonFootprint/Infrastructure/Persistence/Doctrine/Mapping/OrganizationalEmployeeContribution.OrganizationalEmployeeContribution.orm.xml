<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\OrganizationalEmployeeContribution\OrganizationalEmployeeContribution" table="organizational_employee_contributions">
        <indexes>
            <index name="IDX_oec_footprint" columns="subject_type,carbon_footprint_id"/>
            <index name="IDX_oec_account" columns="account_id"/>
        </indexes>

        <id name="id" type="organizational_employee_contribution_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="subjectType" type="string" length="20" enum-type="App\CarbonFootprint\Domain\Model\CarbonFootprintReport\CarbonFootprintReportSubjectType" column="subject_type" nullable="false"/>
        <field name="carbonFootprintId" type="string" length="36" column="carbon_footprint_id" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="false"/>
        <field name="employeeId" type="employee_id" column="employee_id" nullable="false"/>
        <field name="employeeName" type="string" length="255" column="employee_name" nullable="true"/>
        <field name="token" type="string" length="64" nullable="false" unique="true"/>
        <field name="status" type="string" length="20" enum-type="App\CarbonFootprint\Domain\Model\EmployeeContribution\EmployeeContributionStatus" nullable="false"/>
        <field name="stepStatus" type="string" length="30" column="step_status" enum-type="App\CarbonFootprint\Domain\Model\OrganizationalEmployeeContribution\OrganizationalEmployeeContributionStepStatus" nullable="false"/>
        <field name="workplacePropertyId" type="property_id" column="workplace_property_id" nullable="true"/>
        <field name="commutingWeeksPerYear" type="smallint" column="commuting_weeks_per_year" nullable="true"/>
        <field name="answeredAt" type="datetime_immutable" column="answered_at" nullable="true"/>
        <field name="ignoredAt" type="datetime_immutable" column="ignored_at" nullable="true"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>

        <embedded name="consentProof" class="App\Shared\Domain\Model\Consent\ConsentProof" use-column-prefix="true" column-prefix="consent_" />

        <one-to-many field="commutes"
                     target-entity="App\CarbonFootprint\Domain\Model\OrganizationalEmployeeContribution\OrganizationalEmployeeContributionCommute"
                     mapped-by="contribution"
                     orphan-removal="true">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

        <one-to-many field="trips"
                     target-entity="App\CarbonFootprint\Domain\Model\OrganizationalEmployeeContribution\OrganizationalEmployeeContributionTrip"
                     mapped-by="contribution"
                     orphan-removal="true">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>
    </entity>

</doctrine-mapping>
