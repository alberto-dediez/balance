<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\CarbonFootprint\Domain\Model\MachineryFuel\MachineryFuelEmissionFactor" table="machinery_fuel_emission_factor">
        <unique-constraints>
            <unique-constraint columns="machinery_fuel_id,year,emission_factor_group_id" name="uq_machinery_fuel_emission_factor_year"/>
        </unique-constraints>

        <id name="id" type="machinery_fuel_emission_factor_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>

        <embedded name="emissionFactor" class="App\CarbonFootprint\Domain\Model\EmissionFactor\EmissionFactor" use-column-prefix="false"/>
        <embedded name="wellToTankFactor" class="App\CarbonFootprint\Domain\Model\EmissionFactor\EmissionFactor" column-prefix="well_to_tank_"/>

        <many-to-one field="machineryFuel" target-entity="App\CarbonFootprint\Domain\Model\MachineryFuel\MachineryFuel" inversed-by="emissionFactors">
            <join-column name="machinery_fuel_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
