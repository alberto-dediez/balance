<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\CriticalPoint\CriticalPointSurplusCauseLink"
            table="critical_point_surplus_causes">

        <id name="id" type="critical_point_surplus_cause_link_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="surplusCauseId" type="surplus_cause_id" column="surplus_cause_id" nullable="false"/>

        <many-to-one field="criticalPoint"
                     target-entity="App\FoodLoss\Domain\Model\CriticalPoint\CriticalPoint"
                     inversed-by="surplusCauses">
            <join-column name="critical_point_id"
                         referenced-column-name="id"
                         nullable="false"
                         on-delete="CASCADE"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint columns="critical_point_id,surplus_cause_id" name="uq_critical_point_surplus_cause_link"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
