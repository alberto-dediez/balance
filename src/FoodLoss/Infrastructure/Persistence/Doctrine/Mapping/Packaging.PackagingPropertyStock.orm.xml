<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\Packaging\PackagingPropertyStock"
            table="packaging_property_stocks">

        <id name="id" type="packaging_property_stock_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="propertyId" type="property_id" column="property_id" nullable="false"/>
        <field name="stock" type="integer" nullable="false"/>

        <many-to-one field="packaging"
                     target-entity="App\FoodLoss\Domain\Model\Packaging\Packaging"
                     inversed-by="stocks">
            <join-column name="packaging_id"
                         referenced-column-name="id"
                         nullable="false"
                         on-delete="CASCADE"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint columns="packaging_id,property_id" name="uq_packaging_property_stock"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
