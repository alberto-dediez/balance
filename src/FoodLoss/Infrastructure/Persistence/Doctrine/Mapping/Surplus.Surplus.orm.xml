<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\Surplus\Surplus" table="surpluses">
        <id name="id" type="surplus_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="date" type="datetime_immutable" nullable="false"/>
        <field name="serviceCategoryId" type="service_category_id" column="service_category_id" nullable="false"/>
        <field name="criticalPointId" type="critical_point_id" column="critical_point_id" nullable="false"/>
        <field name="surplusCauseId" type="surplus_cause_id" column="surplus_cause_id" nullable="false"/>
        <field name="foodType" type="string" enum-type="App\FoodLoss\Domain\Model\Surplus\FoodType" column="food_type" nullable="false"/>
        <field name="quantity" type="float" nullable="false"/>
        <field name="unit" type="string" enum-type="App\FoodLoss\Domain\Model\DeliveryLog\DeliveryLogUnit" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="false"/>
        <field name="registeredBy" type="user_id" column="registered_by" nullable="false"/>

        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>
    </entity>
</doctrine-mapping>
