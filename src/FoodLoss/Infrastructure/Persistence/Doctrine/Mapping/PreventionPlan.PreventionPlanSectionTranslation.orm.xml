<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanSectionTranslation"
            table="prevention_plan_section_translation">

        <id name="locale" type="locale" length="5"/>
        <id name="translatable" association-key="true"/>

        <field name="title" type="string" length="512" nullable="false"/>
        <field name="content" type="text" nullable="false"/>

        <many-to-one field="translatable"
                     target-entity="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanSection"
                     inversed-by="translations">
            <join-column name="prevention_plan_section_id"
                         referenced-column-name="id"
                         nullable="false"
                         on-delete="CASCADE"/>
        </many-to-one>

    </entity>

</doctrine-mapping>
