<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlan" table="prevention_plans">
        <id name="id" type="prevention_plan_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="name" type="string" length="255" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="false"/>

        <one-to-many field="properties"
                     target-entity="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanPropertyLink"
                     mapped-by="preventionPlan"
                     fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="versions"
                     target-entity="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanVersion"
                     mapped-by="preventionPlan"
                     fetch="EXTRA_LAZY">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
            <order-by>
                <order-by-field name="versionNumber" direction="ASC"/>
            </order-by>
        </one-to-many>

        <field name="currentVersion" type="integer" column="current_version" nullable="false"/>
        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>
    </entity>
</doctrine-mapping>
