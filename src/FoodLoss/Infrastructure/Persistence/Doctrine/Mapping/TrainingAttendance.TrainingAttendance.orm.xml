<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\TrainingAttendance\TrainingAttendance" table="training_attendances">
        <id name="id" type="training_attendance_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="trainingSessionId" type="training_session_id" column="training_session_id" nullable="false"/>
        <field name="employeeId" type="employee_id" column="employee_id" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="false"/>
        <field name="attendedAt" type="datetime_immutable" column="attended_at" nullable="false"/>
        <field name="filePath" type="string" length="255" column="file_path" nullable="false"/>

        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>
    </entity>
</doctrine-mapping>
