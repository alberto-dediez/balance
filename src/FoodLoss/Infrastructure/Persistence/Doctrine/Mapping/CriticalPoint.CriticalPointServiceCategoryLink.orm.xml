<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\CriticalPoint\CriticalPointServiceCategoryLink"
            table="critical_point_service_categories">

        <id name="criticalPoint" association-key="true"/>
        <id name="serviceCategoryId" type="service_category_id" column="service_category_id"/>

        <many-to-one field="criticalPoint"
                     target-entity="App\FoodLoss\Domain\Model\CriticalPoint\CriticalPoint"
                     inversed-by="serviceCategories">
            <join-column name="critical_point_id"
                         referenced-column-name="id"
                         nullable="false"
                         on-delete="CASCADE"/>
        </many-to-one>

    </entity>

</doctrine-mapping>
