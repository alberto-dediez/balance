<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\PreventionPlan\ProposedAction"
            table="prevention_plan_proposed_actions">

        <id name="preventionPlanVersion" association-key="true"/>
        <id name="propertyId" type="property_id" column="property_id"/>
        <id name="actionId" type="action_id" column="action_id"/>
        <id name="criticalPointId" type="critical_point_id" column="critical_point_id"/>

        <many-to-one field="preventionPlanVersion"
                     target-entity="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanVersion"
                     inversed-by="proposedActions">
            <join-column name="prevention_plan_version_id"
                         referenced-column-name="id"
                         nullable="false"
                         on-delete="CASCADE"/>
        </many-to-one>

    </entity>

</doctrine-mapping>
