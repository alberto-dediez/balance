<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\PreventionPlan\ProposedAction"
            table="prevention_plan_proposed_actions">

        <id name="id" type="proposed_action_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <many-to-one field="preventionPlanVersion"
                     target-entity="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanVersion"
                     inversed-by="proposedActions">
            <join-column name="prevention_plan_version_id"
                         referenced-column-name="id"
                         nullable="false"
                         on-delete="CASCADE"/>
        </many-to-one>

        <field name="propertyId" type="property_id" column="property_id" nullable="false"/>
        <field name="actionId" type="action_id" column="action_id" nullable="false"/>
        <field name="criticalPointId" type="critical_point_id" column="critical_point_id" nullable="false"/>

        <unique-constraints>
            <unique-constraint columns="prevention_plan_version_id,property_id,action_id,critical_point_id"
                               name="uq_prevention_plan_proposed_action"/>
        </unique-constraints>

    </entity>

</doctrine-mapping>
