<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\DeliveryLog\DeliveryLog" table="delivery_logs">
        <id name="id" type="delivery_log_id" column="id">
            <generator strategy="NONE" />
        </id>

        <field name="date" type="datetime_immutable" nullable="false"/>
        <field name="quantity" type="float" nullable="false"/>
        <field name="unit" type="string" enum-type="App\FoodLoss\Domain\Model\DeliveryLog\DeliveryLogUnit" nullable="false"/>
        <field name="productType" type="string" enum-type="App\FoodLoss\Domain\Model\DeliveryLog\FoodType" column="product_type" nullable="false"/>
        <field name="batch" type="string" length="255" nullable="false"/>
        <field name="recipientOrganizationId" type="recipient_organization_id" column="recipient_organization_id" nullable="false"/>
        <field name="accountId" type="account_id" column="account_id" nullable="false"/>
        <field name="propertyId" type="property_id" column="property_id" nullable="false"/>

        <field name="surplusId" type="surplus_id" column="surplus_id" nullable="true"/>

        <field name="removed" type="boolean" nullable="false"/>
        <field name="registeredAt" type="datetime_immutable" column="registered_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true"/>
        <field name="removedAt" type="datetime_immutable" column="removed_at" nullable="true"/>
    </entity>
</doctrine-mapping>
