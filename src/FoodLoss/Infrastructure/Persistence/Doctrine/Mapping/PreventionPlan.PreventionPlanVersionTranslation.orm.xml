<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanVersionTranslation"
            table="prevention_plan_version_translations">

        <id name="locale" type="locale" length="5"/>
        <id name="translatable" association-key="true"/>

        <field name="pdfPath" type="string" length="1024" nullable="false" column="pdf_path"/>

        <many-to-one field="translatable"
                     target-entity="App\FoodLoss\Domain\Model\PreventionPlan\PreventionPlanVersion"
                     inversed-by="translations">
            <join-column name="prevention_plan_version_id"
                         referenced-column-name="id"
                         nullable="false"
                         on-delete="CASCADE"/>
        </many-to-one>

    </entity>

</doctrine-mapping>
