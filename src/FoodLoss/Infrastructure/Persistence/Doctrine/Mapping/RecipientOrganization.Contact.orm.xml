<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="App\FoodLoss\Domain\Model\RecipientOrganization\Contact">
        <field name="name" type="string" length="255" nullable="false"/>
        <field name="email" type="string" length="255" nullable="false"/>
        <field name="phone" type="string" length="50" nullable="false"/>
        <field name="preferredLocale" type="locale" column="preferred_locale" nullable="true"/>
        <field name="preferredNotificationChannel" type="string" enum-type="App\Security\Domain\Model\SignatureRequest\NotificationChannel" column="preferred_notification_channel" nullable="false"/>
    </embeddable>
</doctrine-mapping>
