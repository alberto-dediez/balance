{% extends '@shared/layout/action.html.twig' %}

{% set page_title = ('Mis notificaciones' | trans)
    ~ ' > '
    ~ notification.subject %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('notifications') }}" />

    <twig:TopAction path="{{ path('notification_remove', {'id': notification.id, '_token': csrf_token('remove')}) }}"
        class="text-danger"
        data-controller="confirm"
        data-confirm-text-param="{{ '¿Esta seguro de que desea eliminar este elemento? Esta acción no se puede deshacer' | trans }}"
        data-action="confirm#link:prevent"
    >
        <twig:Icon name="solar:close-square-line-duotone" size="lg" class="me-2" />

        {{ 'Eliminar' | trans }}
    </twig:TopAction>
{% endblock %}

{% block content %}
    <twig:Card>
        <div class="row g-4">
            <div class="col-md-6">
                <twig:View:Field label="{{ 'Asunto' | trans }}">{{ notification.subject }}</twig:View:Field>
            </div>
            <div class="col-md-6">
                <twig:View:Field label="{{ 'Fecha' | trans }}">{{ notification.createdAt | date('d/m/Y H:i') }}</twig:View:Field>
            </div>
        </div>

        <div class="mt-3">{{ notification.body | raw }}</div>
    </twig:Card>
{% endblock %}
