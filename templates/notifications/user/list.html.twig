{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Mis notificaciones' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': ''
        }, {
            'label': 'Asunto' | trans
        }, {
            'label': 'Fecha' | trans,
            'sortable': true,
            'sortableBy': 'default'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="notifications">
        <td style="width: 48px;">
            <span class="d-flex align-items-center justify-content-center rounded round {{ element.isRead ? 'bg-body-secondary text-body-secondary' : 'bg-primary-subtle text-primary' }}"
                  data-notification-icon>
                <twig:Icon name="solar:bell-bing-line-duotone" />
            </span>
        </td>
        <td>
            <a href="{{ path('notification_show', {'id': element.id}) }}"
               class="text-decoration-none text-reset {{ element.isRead ? '' : 'fw-semibold' }}"
               data-notification-subject>
                {{ element.subject }}
            </a>

            {% if not element.isRead %}
                <span class="badge text-bg-primary ms-1" data-notification-unread>{% trans -%}Nueva{%- endtrans %}</span>
            {% endif %}

            <div class="text-muted fs-2 text-truncate" style="max-width: 480px;">
                {{ element.body | striptags | trim }}
            </div>
        </td>
        <td>{{ element.createdAt | date('d/m/Y H:i') }}</td>
        <td>
            <twig:List:Action:View path="{{ path('notification_show', {'id': element.id}) }}" />

            <twig:List:Action:Delete path="{{ path('notification_remove', {'id': element.id}) }}" />
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    {% if unreadCount > 0 %}
        <form method="post"
              action="{{ path('notifications_mark_all_read') }}"
              data-controller="mark-all-read"
              data-action="mark-all-read#submit"
              data-notifications-mark-all>
            <button type="submit" class="btn btn-info d-flex">
                <twig:Icon name="solar:check-read-line-duotone" size="lg" class="me-2" />

                {% trans %}Marcar todas como leídas{% endtrans %}
            </button>
        </form>
    {% endif %}
{% endblock list_actions %}
