{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Employees' | trans) ~ ' > ' ~ ('Register' | trans) %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('admin_employees') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.email) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.phone) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.street) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.postalCode) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.city) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.country) }}
                </div>
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="primary" :button="form.register" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form) }}
{% endblock %}
