{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Empleados' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre completo' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Email' | trans,
            'sortable': false
        }, {
            'label': 'Teléfono' | trans,
            'sortable': false
        }, {
            'label': 'Registrado' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="employees" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.email }}</td>
        <td>{{ element.phone ?? '-' }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('admin_employees_edit', {'employeeId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('admin_employees_remove', {'employeeId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_employees_register') }}" />
{% endblock list_actions %}
