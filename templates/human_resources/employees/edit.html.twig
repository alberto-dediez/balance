{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('employees') }}" />
{% endblock %}

{% set page_title = ('Employees' | trans) ~ ' > ' ~ ('Edit' | trans) ~ ' > ' ~ employee.name %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.email) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.phone) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.street) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.postalCode) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.city) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.country) }}
                </div>

                {% if form.accountId is defined %}
                    <div class="col-12">
                        {{ form_row(form.accountId) }}
                    </div>
                {% endif %}
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form) }}
{% endblock %}
