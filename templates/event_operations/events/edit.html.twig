{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('events') }}" />
{% endblock %}

{% set page_title = ('Eventos' | trans)
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ event.name %}

{% block content %}
    {% if event.locked %}
        <twig:Alert type="info">{{ 'La huella de carbono de este evento está completada: los datos solo se pueden consultar.' | trans }}</twig:Alert>
    {% endif %}

    {{ form_start(form) }}
        {% include '@event_operations/events/_form.html.twig' %}

        <twig:Card title="{{ 'Encuesta de asistentes' | trans }}">
            <twig:CarbonFootprint:AttendeeSurveyQr eventId="{{ event.id }}" />
        </twig:Card>

        {% if not event.locked %}
            <twig:Card>
                <twig:ActionBar>
                    <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                    <twig:ActionBar:Button type="primary" :button="form.save" />
                </twig:ActionBar>
            </twig:Card>
        {% else %}
            {% do form.save.setRendered %}
            {% do form.saveAndReturn.setRendered %}
        {% endif %}
    {{ form_end(form) }}
{% endblock %}
