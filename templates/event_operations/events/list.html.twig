{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Eventos' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Ubicación' | trans,
            'sortable': false
        }, {
            'label': 'Tamaño del evento' | trans,
            'sortable': false
        }, {
            'label': 'Sector del evento' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="events" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>
            {% set property_name = element.propertyId ? (element.propertyId | property_name) : '' %}

            {% if property_name is not empty %}
                <b>{{ property_name }}</b><br>
            {% endif %}

            {{ element.location ? (element.location | destination_name) : '' }}
        </td>
        <td>{{ element.size ? (element.size.value | trans({}, 'eventSizeType')) : '' }}</td>
        <td>{{ element.sector ? (element.sector.value | trans({}, 'eventSectorType')) : '' }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% set carbonFootprint = event_carbon_footprint(element.id) %}

            {% if carbonFootprint is null and element | event_carbon_footprint | is_authorized('register') %}
                <twig:List:Action:CarbonFootprint path="{{ path('events_carbon_footprint_register', {'eventId': element.id}) }}" />
            {% elseif carbonFootprint | is_authorized('edit') %}
                <twig:List:Action:CarbonFootprint path="{{ path('events_carbon_footprint_edit', {'eventId': element.id}) }}" />
            {% endif %}

            {% set carbonFootprintReport = carbonFootprint is not null ? event_carbon_footprint_report(element.id) : null %}

            {% if carbonFootprintReport is not null and carbonFootprintReport.status.isGenerated and carbonFootprintReport | is_authorized('view') %}
                <twig:List:Action:Download path="{{ path('carbon_footprint_reports_download', {'reportId': carbonFootprintReport.id}) }}" />
            {% endif %}

            {% if element | is_authorized('edit') %}
                <twig:List:Action:Calculator path="{{ path('events_attendee_survey', {'eventId': element.id}) }}" />
                <twig:List:Action:Responses path="{{ path('events_attendee_survey_responses', {'eventId': element.id}) }}" />
                <twig:List:Action:Edit path="{{ path('events_edit', {'eventId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('events_remove', {'eventId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('events_register') }}" />
{% endblock list_actions %}
