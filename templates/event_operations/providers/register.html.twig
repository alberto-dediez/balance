{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Proveedores' | trans)
    ~ ' > '
    ~ ('Registrar' | trans) %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('providers') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
    {% include '@event_operations/providers/_form.html.twig' %}

    <twig:Card>
        <twig:ActionBar>
            <twig:ActionBar:Button type="primary" :button="form.register" />
        </twig:ActionBar>
    </twig:Card>
    {{ form_end(form) }}
{% endblock %}
