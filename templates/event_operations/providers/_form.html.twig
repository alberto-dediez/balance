<twig:Card title="{{ 'General' | trans }}">
    <div class="row">
        <div class="col-12">
            {{ form_row(form.name) }}
        </div>
        <div class="col-12">
            {{ form_row(form.vatNumber) }}
        </div>
        <div class="col-12">
            {{ form_row(form.street) }}
        </div>
        <div class="col-12">
            {{ form_row(form.postalCode) }}
        </div>
        <div class="col-12">
            {{ form_row(form.city) }}
        </div>
        <div class="col-12">
            {{ form_row(form.country) }}
        </div>
    </div>
</twig:Card>

<twig:Card title="{{ 'Contacto para recogidas' | trans }}">
    <div class="row">
        <div class="col-12">
            {{ form_row(form.contactName) }}
        </div>
        <div class="col-12">
            {{ form_row(form.email) }}
        </div>
        <div class="col-12">
            {{ form_row(form.preferredLocale) }}
        </div>
    </div>
</twig:Card>
