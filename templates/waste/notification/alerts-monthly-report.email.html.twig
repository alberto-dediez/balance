{% extends '@shared/layout/email.html.twig' %}

{% block content %}
    <h3>{% trans with {'{month}': month | date('Y-m')} %}Resumen mensual de alertas: {month}{% endtrans %}</h3>
    <p>{% trans with {'{count}': alerts | length } %}Se han detectado {count} alertas durante el mes.{% endtrans %}</p>

    {% if unreadAlerts | length > 0 %}
        <p>{% trans %}Mostramos algunas de las alertas no vistas del mes.{% endtrans %}</p>
        <table>
            <thead>
                <tr>
                    <th>{% trans %}Tipo{% endtrans %}</th>
                    <th>&nbsp;</th>
                    <th>{% trans %}Propiedad{% endtrans %}</th>
                </tr>
            </thead>
            <tbody>
                {% for alert in unreadAlerts %}
                    {% if loop.index < 5 %}
                        <tr>
                            <td>{{ alert.type.value | trans({}, 'alertType') }}</td>
                            <td>&nbsp;</td>
                            <td>{{ alert.propertyId | property_name }}</td>
                        </tr>
                    {% endif %}

                    {% if loop.index == 5 %}
                        <tr><td colspan="3"><center>...</center></td></tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
    <br>
    <p>{% trans with {'{link}': url('alerts') } %}Puede revisarlas desde su zona de <a href="{link}">alertas</a>.{% endtrans %}</p>
{% endblock %}
