{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Contenedores' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Propiedad' | trans,
        }, {
            'label': 'Tipología de residuo' | trans,
        }, {
            'label': 'Destino' | trans,
        }, {
            'label': 'Gestor de residuos' | trans,
        }, {
            'label': 'Capacidad (l)' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="containers" :bulkForm="bulkForm">
        <td>{{ element.propertyId | property_name }}</td>
        <td>{{ element.wasteId | waste_name }}</td>
        <td>{{ element.purpose.value | trans({}, 'purpose') }}</td>
        <td>{{ element.wasteManagerId | waste_manager_name }}</td>
        <td>
            {% if element.volume > 0 %}
                {{ element.volume }} l
            {% else %}
                ---
            {% endif %}
        </td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('view') %}
                <twig:List:Action path="{{ path('containers_print', {'containerId': element.id}) }}"
                    title="{{ 'Imprimir QR' | trans }}"
                    target="_blank"
                >
                    <twig:Icon name="solar:printer-line-duotone" size="lg" />
                </twig:List:Action>
            {% endif %}

            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('containers_edit', {'containerId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('containers_remove', {'containerId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link path="{{ path('containers_print_all') }}" color="info" target="_blank">
        <twig:Icon name="solar:printer-line-duotone" size="lg" class="me-2" />

        {% trans %}Imprimir QRs{% endtrans %}
    </twig:Link>

    <twig:Link:Register path="{{ path('containers_register') }}" />
{% endblock list_actions %}
