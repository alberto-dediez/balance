{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Alertas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Tipo' | trans,
        }, {
            'label': 'Propiedad' | trans,
        }, {
            'label': 'Residuo' | trans,
        }, {
            'label': 'Valor' | trans,
        }, {
            'label': 'Umbral' | trans,
        }, {
            'label': 'Período' | trans,
        }, {
            'label': 'Detectada' | trans,
            'sortable': true,
            'sortableBy': 'detectedAt'
        }, {
            'label': 'Prioridad' | trans,
        }, {
            'label': 'Estado' | trans,
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="alerts">
        <td>{{ element.type.value | trans({}, 'alertType') }}</td>
        <td>{{ element.propertyId | property_name }}</td>
        <td>{{ element.wasteId ? (element.wasteId | waste_name) : '-' }}</td>
        <td>{{ element.value is not null ? element.value : '-' }}</td>
        <td>{{ element.threshold is not null ? element.threshold : '-' }}</td>
        <td>
            {% if element.singleDayPeriod %}
                {{ element.periodFrom | date('d/m/Y') }}
            {% else %}
                {{ element.periodFrom | date('d/m/Y') }} - {{ element.periodTo | date('d/m/Y') }}
            {% endif %}
        </td>
        <td>{{ element.detectedAt | date('H:i d/m/Y') }}</td>
        <td>
            <span class="badge {{ element.priority.style }}">{{ element.priority.value | trans({}, 'alertPriority') }}</span>
        </td>
        <td>
            <span class="badge {{ element.status.style }}">{{ element.status.value | trans({}, 'alertStatus') }}</span></td>
        <td>
            <twig:List:Action:View path="{{ path('alerts_view', {'alertId': element.id}) }}" />
            {% if element.status.value == 'New' %}
                <twig:List:Action path="{{ path('alerts_acknowledge', {'alertId': element.id}) }}"
                                  title="{{ 'Marcar como vista' | trans }}"
                >
                    <twig:Icon name="solar:check-square-line-duotone" size="lg" />
                </twig:List:Action>
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}
