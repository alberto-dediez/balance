<h4 class="fs-4 mb-1 card-title">{% trans -%}Últimas mediciones{%- endtrans %}</h4>
{% set columns = [
    {
        'label': 'Propiedad' | trans,
    }, {
        'label': 'Tipología' | trans,
    }, {
        'label': 'Fecha' | trans
    }, {
        'label': ''
    }
] %}

<twig:List:Table :columns="columns" :elements="measurements">
    <tr>
        <td>
            {{ element.propertyId | property_name }}
        </td>
        <td>
            {{ element.wasteId | waste_name }}
            <small class="d-block">{{ element.purpose.value | trans({}, 'purpose') }}</small>                            
        </td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('measurements_edit', {'measurementId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('measurements_remove', {'measurementId': element.id}) }}" />
            {% endif %}
        </td>
    </tr>
</twig:List:Table>