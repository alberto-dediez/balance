{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Inicio' | trans %}

{% block content %}
    <div class="row">
        <div class="col-12 col-lg-5 d-grid">
            <div class="card">
                <div class="card-body">
                    {% include '@waste/home/_measurements.html.twig' %}
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7 d-grid">
            <div class="card">
                <div class="card-body">
                    <h4 class="fs-4 mb-1 card-title">{% trans -%}Residuos por propiedad{%- endtrans %}</h4>
                    <twig:Chart:Bar 
                        title="{{ 'Residuo por propiedad' | trans }}"
                        unit="kg"
                        values="{{ statistics.byProperty | map(e => e.load) }}"
                        categories="{{ statistics.byProperty | map(e => e.property.name) }}"
                        dataLabels="1"
                    ></twig:Chart:Bar>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    {% set colors = [
                        "var(--bs-primary)",
                    ] %}

                    <h4 class="fs-4 mb-1 card-title">{% trans -%}Residuos diarios{%- endtrans %}</h4>
                    <twig:Chart:Line 
                        title="{{ 'Residuos diarios' | trans }}"
                        unit="kg"
                        values="{{ statistics.byDate | map(e => e.load) }}"
                        categories="{{ statistics.byDate | map(e => e.date | date('d/m/Y')) }}"
                        colors="{{ colors }}"
                        dataLabels="1"
                    ></twig:Chart:Line>
                </div>
            </div>
        </div>
    </div>
{% endblock %}