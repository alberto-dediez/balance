{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Configuraciones de alertas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Cuenta' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="alertConfigurations" :bulkForm="bulkForm">
        <td>{{ element.accountId | account_name }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('admin_alert_configurations_edit', {'alertConfigurationId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('admin_alert_configurations_remove', {'alertConfigurationId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_alert_configurations_register') }}" />
{% endblock list_actions %}
