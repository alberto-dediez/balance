<div class="row mb-3">
    <div class="col-12 col-md-6">
        {% if form.accountId is defined %}
            {{ form_row(form.accountId) }}
        {% else %}
            <twig:View:Field label="{{ 'Cuenta' | trans }}">{{ alertConfiguration.accountId | account_name }}</twig:View:Field>
        {% endif %}
    </div>
</div>

{% set protoCard %}
    {% with { element: form.items.vars.prototype } %}
        {% include '@waste/admin/alert-configurations/_item_row.html.twig' %}
    {% endwith %}
{% endset %}

<div data-controller="collection"
     data-collection-prototype-value="{{ protoCard | e('html_attr') }}">
    <div class="collection">
        {% for element in form.items %}
            {% include '@waste/admin/alert-configurations/_item_row.html.twig' %}
        {% else %}
            <p class="collection-empty text-muted">{{ 'No hay configuraciones de alerta. Añade una.' | trans }}</p>
        {% endfor %}
    </div>

    <div class="mb-3">
        <button type="button" class="btn btn-outline-info"
                data-action="collection#add">{{ '+ Añadir' | trans }}</button>
    </div>
</div>
