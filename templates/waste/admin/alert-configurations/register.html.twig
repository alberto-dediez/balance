{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Configuraciones de alertas' | trans)
    ~ ' > '
    ~ ('Registrar' | trans) %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('admin_alert_configurations') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            {% include '@waste/admin/alert-configurations/_form.html.twig' %}

            <twig:ActionBar>
                <twig:ActionBar:Button type="primary" :button="form.register" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form) }}
{% endblock %}
