{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Tipologias' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': '¿Es peligroso?' | trans,
            'sortable': false
        }, {
            'label': 'Densidad' | trans
        }, {
            'label': 'Color' | trans
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="wastes" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.isDangerous | show_field_value | trans }}</td>
        <td>{{ element.density }}</td>
        <td>
            <span style="color: {{ element.color }}">
                {{ element.color }}
            </span>
        </td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('admin_wastes_edit', {'wasteId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('admin_wastes_remove', {'wasteId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_wastes_register') }}" />
{% endblock list_actions %}
