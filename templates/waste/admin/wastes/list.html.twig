{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Tipologias' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': '¿Es peligroso?' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="wastes">
        <tr>
            <td>{{ element.name }}</td>
            <td>{{ element.isDangerous | show_field_value }}</td>
            <td>{{ element.registeredAt | date('d/m/Y') }}</td>
            <td>
                {% if element | is_authorized('remove') %}
                    <twig:List:Action:Delete path="{{ path('admin_wastes_remove', {'wasteId': element.id}) }}" />
                {% endif %}
            </td>
        </tr>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_wastes_register') }}" />
{% endblock list_actions %}