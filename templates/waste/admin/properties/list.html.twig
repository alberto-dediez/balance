{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Propiedades' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Cuenta' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="properties">
        <tr>
            <td>{{ element.name }}</td>
            <td>{{ element.account }}</td>
            <td>{{ element.registeredAt | date('d/m/Y') }}</td>
            <td>
                <twig:List:Action:Delete path="{{ path('admin_properties_remove', {'propertyId': element.id}) }}" />
            </td>
        </tr>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_properties_register') }}" />
{% endblock list_actions %}