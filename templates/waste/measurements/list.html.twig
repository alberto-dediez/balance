{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Mediciones' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Propiedad' | trans,
        }, {
            'label': 'Tipología de residuo' | trans,
        }, {
            'label': 'Gestor de residuos' | trans,
        }, {
            'label': 'Cantidad de contenedores' | trans,
        }, {
            'label': 'Carga' | trans,
        }, {
            'label': 'Propósito' | trans,
        }, {
            'label': 'Registrado por' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="measurements" :bulkForm="bulkForm ?? null">
        <td>{{ element.propertyId | property_name }}</td>
        <td>{{ element.wasteId | waste_name }}</td>
        <td>{{ element.wasteManagerId | waste_manager_name }}</td>
        <td>{{ element.quantity }}</td>
        <td>
            {{ element.load }}

            {{ element.unit.value }}
        </td>
        <td>{{ element.purpose.value | trans({}, 'purpose') }}</td>
        <td>{{ element.registeredBy | user_name }}</td>
        <td>{{ element.registeredAt | date('H:i d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('measurements_edit', {'measurementId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('measurements_remove', {'measurementId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('measurements_register') }}" />
{% endblock list_actions %}
