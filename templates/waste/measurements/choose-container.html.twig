{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Mediciones' | trans) 
    ~ ' > '
    ~ ('Registrar' | trans)  %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('measurements') }}" />
{% endblock %}

{% block content %}
    <div class="row">
        {% for container in containers %}
            <div class="col-12 col-md-6 col-lg-3">
                <twig:Card>
                    <h4 class="fs-4 mb-1 card-title">{{ container.propertyId | property_name }}</h4>
                    

                    <div class="d-flex align-items-bottom justify-content-between mt-2 pb-0">
                        <p class="mb-0 card-subtitle">{{ container.wasteId | waste_name }} ({{ container.purpose.value | trans({}, 'purpose') }})</p>
                        <p class="mb-0 fw-normal">{{ container.wasteManagerId | waste_manager_name }}</p>
                    </div>

                    <div class="mt-4">
                        <a href="{{ path('measurements_register_for_container', {'containerId': container.id }) }}" class="btn btn-primary w-100">
                            {% trans %}Seleccionar{% endtrans %}
                        </a>
                    </div>
                </twig:Card>
            </div>
        {% endfor %}
    </div>
{% endblock %}