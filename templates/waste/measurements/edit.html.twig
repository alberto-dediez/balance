{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('measurements') }}" />
{% endblock %}

{% set page_title = ('Mediciones' | trans)
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ measurement.id %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <twig:View:Field label="{{ 'Propiedad' | trans }}">{{ measurement.propertyId | property_name }}</twig:View:Field>
                <twig:View:Field label="{{ 'Tipología de residuo' | trans }}">{{ measurement.wasteId | waste_name }}</twig:View:Field>
                <twig:View:Field label="{{ 'Propósito' | trans }}">{{ measurement.purpose.value | trans({}, 'purpose') }}</twig:View:Field>
                <twig:View:Field label="{{ 'Método de medida' | trans }}">{{ measurement.measurementMethod.value | trans({}, 'measurementMethod') }}</twig:View:Field>
                {{ form_row(form.quantity) }}
                {{ form_row(form.load) }}
                {{ form_row(form.justification) }}
                {{ form_row(form.reference) }}
                <twig:View:Field label="{{ 'Fecha de registro' | trans }}">{{ measurement.day | date('d/m/Y') }}</twig:View:Field>
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
