{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Mediciones' | trans)
    ~ ' > '
    ~ ('Registrar' | trans)  %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('measurements') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <twig:View:Field label="{{ 'Propiedad' | trans }}">{{ container.propertyId | property_name }}</twig:View:Field>
                <twig:View:Field label="{{ 'Tipología de residuo' | trans }}">{{ container.wasteId | waste_name }}</twig:View:Field>
                <twig:View:Field label="{{ 'Propósito' | trans }}">{{ container.purpose.value | trans({}, 'purpose') }}</twig:View:Field>
                <twig:View:Field label="{{ 'Método de medida' | trans }}">{{ container.measurementMethod.value | trans({}, 'measurementMethod') }}</twig:View:Field>
                {{ form_row(form.quantity) }}
                {{ form_row(form.load) }}
                {{ form_row(form.justification) }}
                {{ form_row(form.reference) }}
                {{ form_row(form.day) }}
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.register" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
