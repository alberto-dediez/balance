{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Mediciones' | trans)
    ~ ' > '
    ~ ('Importar' | trans)  %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('measurements') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                {{ form_row(form.file) }}
                {{ form_row(form.offset) }}
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.import" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
