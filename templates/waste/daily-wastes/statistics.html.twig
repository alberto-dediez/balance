{% extends '@shared/layout/app.html.twig' %}

{% set page_title = ('Cantidades totales' | trans)
    ~ ' > '
    ~ ('Estadísticas' | trans)
%}

{% block page_title %}
    {{ parent() }}

    <div class="ms-auto d-flex gap-2" role="group">
        {% block list_actions %}{% endblock list_actions %}
    </div>
{% endblock %}

{% block content %}
    <twig:Card>
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>

    <div class="row">
        <div class="col-12 col-lg-4 d-grid">
            <div class="card">
                <div class="card-body">
                    <h4 class="fs-4 mb-1 card-title">{% trans -%}Tipo de residuo{%- endtrans %}</h4>
                    <twig:Chart:Bar
                        title="{{ 'Residuos por destino' | trans }}"
                        unit="kg"
                        values="{{ statistics.byWaste | map(e => e.load) }}"
                        categories="{{ statistics.byWaste | map(e => e.waste.name) }}"
                        colors="{{ statistics.byWaste | map(e => e.waste.color) }}"
                        dataLabels="1"
                    ></twig:Chart:Bar>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8 d-grid">
            <div class="card">
                <div class="card-body">
                    {% set colors = [
                        "var(--bs-primary)",
                    ] %}

                    <h4 class="fs-4 mb-1 card-title">{% trans -%}Residuos diarios{%- endtrans %}</h4>
                    <twig:Chart:Line
                        title="{{ 'Residuos diarios' | trans }}"
                        unit="kg"
                        values="{{ statistics.byDate | map(e => e.load) }}"
                        categories="{{ statistics.byDate | map(e => e.date | date('d/m/Y')) }}"
                        colors="{{ colors }}"
                        dataLabels="1"
                    ></twig:Chart:Line>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-3 d-grid">
            <div class="card">
                <div class="card-body">
                    <h4 class="fs-4 mb-1 card-title">{% trans -%}Destino{%- endtrans %}</h4>
                    <twig:Chart:Donut
                        title="{{ 'Porcentaje por destino' | trans }}"
                        unit="%"
                        values="{{ statistics.byPurpose | map(e => 100 * e.percentage) }}"
                        categories="{{ statistics.byPurpose | map(e => e.purpose.value | trans({}, 'purpose')) }}"
                        dataLabels="1"
                        legend="1"
                    ></twig:Chart:Donut>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-3 d-grid">
            <div class="card">
                <div class="card-body">
                    <h4 class="fs-4 mb-1 card-title">{% trans -%}Gestor de residuos{%- endtrans %}</h4>
                    <twig:Chart:Donut
                        title="{{ 'Porcentaje por gestor' | trans }}"
                        unit="%"
                        values="{{ statistics.byWasteManager | map(e => 100 * e.percentage) }}"
                        categories="{{ statistics.byWasteManager | map(e => e.wasteManager.name) }}"
                        dataLabels="1"
                        legend="1"
                    ></twig:Chart:Donut>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6 d-grid">
            <div class="card">
                <div class="card-body">
                    <h4 class="fs-4 mb-1 card-title">{% trans -%}Propiedades{%- endtrans %}</h4>
                    <twig:Chart:Bar
                        title="{{ 'Residuo por propiedad' | trans }}"
                        unit="kg"
                        values="{{ statistics.byProperty | map(e => e.load) }}"
                        categories="{{ statistics.byProperty | map(e => e.property.name) }}"
                        dataLabels="1"
                    ></twig:Chart:Bar>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}
