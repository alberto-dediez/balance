{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Totales diarios' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Propiedad' | trans,
        }, {
            'label': 'Tipología de residuo' | trans,
        }, {
            'label': 'Gestor de residuos' | trans,
        }, {
            'label': 'Carga' | trans,
        }, {
            'label': 'Propósito' | trans,
        }, {
            'label': 'Fecha' | trans,
            'sortable': true,
            'sortableBy': 'day'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="dailyWastes">
        <td>{{ element.propertyId | property_name }}</td>
        <td>{{ element.wasteId | waste_name }}</td>
        <td>{{ element.wasteManagerId | waste_manager_name }}</td>
        <td>
            {{ element.load }} Kg
        </td>
        <td>{{ element.purpose.value | trans({}, 'purpose') }}</td>
        <td>{{ element.day | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('view') %}
                <twig:List:Action:View path="{{ path('daily_wastes_view', {'dailyWasteId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_brands_register') }}" />
{% endblock list_actions %}