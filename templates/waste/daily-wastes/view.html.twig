{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('daily_wastes') }}" />
{% endblock %}

{% set page_title = ('Cantidades totales' | trans)
    ~ ' > '
    ~ ('Detalles' | trans)
    ~ ' > '
    ~ dailyWaste.id %}

{% block content %}
    <twig:Card>
        <div class="row">
            <twig:View:Field label="{{ 'Propiedad' | trans }}">{{ dailyWaste.propertyId | property_name }}</twig:View:Field>
            <twig:View:Field label="{{ 'Tipología de residuo' | trans }}">{{ dailyWaste.wasteId | waste_name }}</twig:View:Field>
            <twig:View:Field label="{{ 'Gestor de residuos' | trans }}">{{ dailyWaste.wasteManagerId | waste_manager_name }}</twig:View:Field>
            <twig:View:Field label="{{ 'Destino' | trans }}">{{ dailyWaste.purpose.value | trans({}, 'purpose') }}</twig:View:Field>
            <twig:View:Field label="{{ 'Fecha' | trans }}">{{ dailyWaste.day | date('d/m/Y') }}</twig:View:Field>
            <twig:View:Field label="{{ 'Cantidad' | trans }}">{{ dailyWaste.load | trans({}, 'purpose') }}</twig:View:Field>
        </div>
    </twig:Card>
    <twig:Card>
        <div class="row">
            <div class="col-12">
                <h4 class="fw-semibold fs-4 mb-4 mb-md-0 card-title">{% trans %}Mediciones{% endtrans %}</h4>
            </div>
            <div class="col-12 px-0">
                {{ block('table', '@waste/measurements/list.html.twig') }}
            </div>
        </div>
    </twig:Card>
{% endblock %}
