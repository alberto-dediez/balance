{% props name = '', size = 'md' %}

{% set icon = cva({
    base: 'icon',
    variants: {
        size: {
            md: 'icon-400',
            lg: 'icon-500',
            xl: 'icon-700',
        }
    }
}) %}

<twig:ux:icon name="{{ name }}" class="{{ icon.apply({size}, attributes.render('class')) }}" />