{% set labels = {
    travellers: 'Viajeros' | trans,
    responses: 'Respuestas' | trans,
    distance: 'Distancia media' | trans,
    emissions: 'Emisiones' | trans,
} %}

<div
    data-controller="flows-map"
    data-flows-map-flows-value="{{ flows | json_encode }}"
    data-flows-map-destination-value="{{ destination | json_encode }}"
    data-flows-map-labels-value="{{ labels | json_encode }}"
    data-flows-map-tile-key-value="{{ this.tileKey }}"
    style="height: {{ height }}px;"
></div>
