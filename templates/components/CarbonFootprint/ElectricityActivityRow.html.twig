{% props prefix, index, marketers, gdOFactors, units, row = null, readOnly = false %}

{% if readOnly %}
    {% set selectedMarketer = null %}
    {% for marketer in marketers %}
        {% if row and row.itemId == marketer.id ~ '' %}{% set selectedMarketer = marketer %}{% endif %}
    {% endfor %}
    {% set selectedGdOFactor = null %}
    {% for gdOFactor in gdOFactors %}
        {% if row and row.itemId2 == gdOFactor.id ~ '' %}{% set selectedGdOFactor = gdOFactor %}{% endif %}
    {% endfor %}
    <tr>
        <td>{{ row and row.source ? row.source : '' }}</td>
        <td>{{ selectedMarketer ? selectedMarketer.name : ('Sin especificar' | trans) }}</td>
        <td>{{ selectedGdOFactor ? selectedGdOFactor.name : ('No' | trans) }}</td>
        <td>{{ row ? row.quantity : '—' }} {{ row ? (row.unit | trans({}, 'unitType')) }}</td>
        <td class="text-end text-nowrap">{{ row ? row.co2eq | number_format(2, ',', '.') : '—' }}</td>
        <td></td>
    </tr>
{% else %}
<tr class="collection-element">
    <td>
        <input type="text" name="{{ prefix }}[{{ index }}][source]" class="form-control" value="{{ row and row.source ? row.source : '' }}" data-field="source">
    </td>
    <td>
        <input type="hidden" name="{{ prefix }}[{{ index }}][activityId]" value="{{ row ? row.activityId : '' }}">
        <select name="{{ prefix }}[{{ index }}][itemId]" class="form-select" data-field="itemId" data-controller="autocomplete" data-action="activity-emissions#recalculate">
            <option value="">{{ 'Sin especificar' | trans }}</option>
            {% for marketer in marketers %}
                <option value="{{ marketer.id }}"{{ row and row.itemId == marketer.id ~ '' ? ' selected' }}>{{ marketer.name }}</option>
            {% endfor %}
        </select>
    </td>
    <td>
        <select name="{{ prefix }}[{{ index }}][itemId2]" class="form-select" data-field="itemId2" data-action="activity-emissions#recalculate">
            <option value="">{{ 'No' | trans }}</option>
            {% for gdOFactor in gdOFactors %}
                <option value="{{ gdOFactor.id }}"{{ row and row.itemId2 == gdOFactor.id ~ '' ? ' selected' }}>{{ gdOFactor.name }}</option>
            {% endfor %}
        </select>
    </td>
    <td>
        <div class="input-group">
            <input
                type="number"
                name="{{ prefix }}[{{ index }}][quantity]"
                class="form-control"
                step="any"
                min="0"
                value="{{ row ? row.quantity : '0' }}"
                data-field="quantity"
                data-action="activity-emissions#recalculate"
            >
            <select name="{{ prefix }}[{{ index }}][unit]" class="form-select" data-field="unit" data-action="activity-emissions#recalculate">
                {% for unit in units %}
                    {% if unit.magnitude.value == 'energy' %}
                        <option value="{{ unit.value }}" data-magnitude="{{ unit.magnitude.value }}"{{ (row and row.unit == unit.value) or (not row and unit.value == 'kWh') ? ' selected' }}>{{ unit.value | trans({}, 'unitType') }}</option>
                    {% endif %}
                {% endfor %}
            </select>
        </div>
    </td>
    <td class="text-end text-nowrap">
        <span data-field="emissions">{{ row ? row.co2eq | number_format(2, ',', '.') : '—' }}</span>
    </td>
    <td class="text-end">
        <button type="button" class="btn btn-sm btn-outline-danger" data-action="collection#remove">
            <twig:Icon name="solar:trash-bin-minimalistic-outline" />
        </button>
    </td>
</tr>
{% endif %}
