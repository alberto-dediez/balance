{% props title, prefix, rows, items, units, eventId = null, calculateUrl = null %}

{% set proto %}{{ component('CarbonFootprint:OvernightStayActivityRow', { prefix: prefix, index: '__name__', items: items, units: units }) }}{% endset %}

<twig:Card :title="title">
    <div
        data-controller="collection activity-emissions"
        data-collection-prototype-value="{{ proto | e('html_attr') }}"
        data-activity-emissions-url-value="{{ calculateUrl ?? path('events_carbon_footprint_emissions_calculate', {eventId: eventId}) }}"
        data-activity-emissions-type-value="overnight_stay"
    >
        <div class="table-responsive overflow-visible">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th class="col-2">{{ 'Fuente' | trans }}</th>
                        <th class="col-3">{{ 'Alojamiento' | trans }}</th>
                        <th class="col-3">{{ 'Cantidad' | trans }}</th>
                        <th class="col-2 text-end">{{ 'Emisiones (kg CO₂eq)' | trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="collection">
                    {% for row in rows %}
                        <twig:CarbonFootprint:OvernightStayActivityRow
                            prefix="{{ prefix }}"
                            :index="loop.index0"
                            :row="row"
                            :items="items"
                            :units="units"
                        />
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-2">
            <button type="button" class="btn btn-outline-info" data-action="collection#add">
                <twig:Icon name="solar:add-circle-outline" />
                {{ 'Añadir' | trans }}
            </button>
        </div>
    </div>
    <div class="mt-3">
        <small class="text-muted">{% trans %}Indicar la totalidad de noches que pernocta cada grupo, es decir, el sumatorio de total. Por ejemplo, si tengo 5 proveedores y cada uno duerme dos noches, indicar 10 noches{% endtrans %}</small>
    </div>
</twig:Card>
