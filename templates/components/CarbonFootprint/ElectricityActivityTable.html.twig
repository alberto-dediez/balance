{% props title, prefix, rows, marketers, gdOFactors, units, eventId, readOnly = false %}

{% set proto %}{{ component('CarbonFootprint:ElectricityActivityRow', { prefix: prefix, index: '__name__', marketers: marketers, gdOFactors: gdOFactors, units: units }) }}{% endset %}

<twig:Card :title="title">
    <div
        {% if not readOnly %}
        data-controller="collection activity-emissions"
        data-collection-prototype-value="{{ proto | e('html_attr') }}"
        data-activity-emissions-url-value="{{ path('events_carbon_footprint_emissions_calculate', {eventId: eventId}) }}"
        data-activity-emissions-type-value="electricity"
        {% endif %}
    >
        <div class="table-responsive overflow-visible">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th class="col-2">{{ 'Fuente' | trans }}</th>
                        <th class="col-2">{{ 'Comercializadora' | trans }}</th>
                        <th class="col-2">{{ '¿Dispone de garantía de origen?' | trans }}</th>
                        <th class="col-2">{{ 'Cantidad' | trans }}</th>
                        <th class="col-2 text-end">{{ 'Emisiones (kg CO₂eq)' | trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="collection">
                    {% for row in rows %}
                        <twig:CarbonFootprint:ElectricityActivityRow
                            prefix="{{ prefix }}"
                            :index="loop.index0"
                            :row="row"
                            :marketers="marketers"
                            :gdOFactors="gdOFactors"
                            :units="units"
                            :readOnly="readOnly"
                        />
                    {% else %}
                        {% if readOnly %}
                            <tr><td colspan="6" class="text-muted">{{ 'No hay actividades registradas.' | trans }}</td></tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if not readOnly %}
            <div class="mt-2">
                <button type="button" class="btn btn-outline-info" data-action="collection#add">
                    <twig:Icon name="solar:add-circle-outline" />
                    {{ 'Añadir' | trans }}
                </button>
            </div>
        {% endif %}
    </div>
</twig:Card>
