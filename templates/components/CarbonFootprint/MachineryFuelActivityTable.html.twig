{% props title, prefix, rows, items, units, eventId %}

{% set proto %}{{ component('CarbonFootprint:MachineryFuelActivityRow', { prefix: prefix, index: '__name__', items: items, units: units }) }}{% endset %}

<twig:Card :title="title">
    <div
        data-controller="collection activity-emissions"
        data-collection-prototype-value="{{ proto | e('html_attr') }}"
        data-activity-emissions-url-value="{{ path('events_carbon_footprint_emissions_calculate', {eventId: eventId}) }}"
        data-activity-emissions-type-value="machinery_fuel"
    >
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th class="col-4">{{ 'Combustible' | trans }}</th>
                        <th class="col-2">{{ 'Unidad' | trans }}</th>
                        <th class="col-2">{{ 'Cantidad' | trans }}</th>
                        <th class="col-2 text-end">{{ 'Emisiones (kg CO₂eq)' | trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="collection">
                    {% for row in rows %}
                        <twig:CarbonFootprint:MachineryFuelActivityRow
                            prefix="{{ prefix }}"
                            :index="loop.index0"
                            :row="row"
                            :items="items"
                            :units="units"
                        />
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-2">
            <button type="button" class="btn btn-outline-info" data-action="collection#add">
                <twig:Icon name="solar:add-circle-outline" />
                {{ 'Añadir' | trans }}
            </button>
        </div>
    </div>
</twig:Card>
