{% props label, value, color = null, hint = null %}

<div class="card {{ attributes.render('class') }}" {{ attributes.without('class') }}>
    <div class="card-body">
        <div class="text-muted small">{{ label }}</div>
        <div class="fs-4 fw-semibold {{ color ? 'text-' ~ color : '' }}">{{ value }}</div>

        {% if hint %}
            <div class="text-muted small">{{ hint }}</div>
        {% endif %}
    </div>
</div>
