<aside class="side-mini-panel with-vertical">
    <div class="iconbar">
        <div>
            <div class="mini-nav">
                <div class="brand-logo d-flex align-items-center justify-content-between justify-content-lg-center">
                    <a href="{{ path('home') }}" class="text-nowrap logo-img">
                        <img src="{{ asset('images/logo-sm.png') }}" width="48" alt="{{ company_name }}" />
                    </a>
                </div>
                <ul class="mini-nav-ul" data-simplebar>
                    {% for node in this.nodes %}
                        <twig:Sidebar:Mini node="{{ node }}"></twig:Sidebar:Mini>
                    {% endfor %}
                </ul>
            </div>
            <div class="sidebarmenu">
                {% for node in this.nodes %}
                    <twig:Sidebar:Nav node="{{ node }}"></twig:Sidebar:Nav>
                {% endfor %}
            </div>
        </div>
    </div>
</aside>
