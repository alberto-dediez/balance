<nav class="sidebar-nav {% if node.selected %}d-block{% endif %}" id="menu-right-mini-{{ node.id }}" data-simplebar>
    <ul class="sidebar-menu" id="sidebarnav">
        <li class="nav-small-cap">
            <span class="hide-menu">{{ node.label | trans }}</span>
        </li>

        {% for item in node.items %}
            {% if item.items is not empty %}
                <twig:Sidebar:Group group="{{ item }}" first="{{ loop.first }}"></twig:Sidebar:Group>
            {% else %}
                <twig:Sidebar:Link link="{{ item }}"></twig:Sidebar:Link>
            {% endif %}
        {% endfor %}
    </ul>
</nav>