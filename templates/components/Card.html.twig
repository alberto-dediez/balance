{% props title = null %}

<div class="card {{ attributes.render('class') }}" {{ attributes.without('class') }}>
    {% block title %}
        {% if title %}
            <div class="card-header fw-semibold">{{ title }}</div>
        {% endif %}
    {% endblock title %}
    <div class="card-body">
        {% block content %}{% endblock %}
    </div>
</div>
