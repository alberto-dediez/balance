{% props public = false %}

<!--  Header Start -->
<header class="topbar d-print-none">
    <div class="with-vertical">
        <nav class="navbar navbar-expand-lg p-0">
            {% if not public %}
                <ul class="navbar-nav">
                    <li class="nav-item nav-icon-hover ms-n3">
                        <a class="nav-link sidebartoggler" id="headerCollapse" href="javascript:void(0)">
                            <twig:Icon name="solar:hamburger-menu-line-duotone" size="lg" />
                        </a>
                    </li>
                </ul>
            {% endif %}
            <div class="topbar-logo | d-flex">
                {% if public %}
                    <img src="{{ branding_logo_url() }}" height="36" alt="{{ company_name }}" />
                {% else %}
                    <img src="{{ asset('images/logo-light.png') }}" class="dark-logo" height="36" alt="{{ company_name }}" />
                    <img src="{{ asset('images/logo-dark.png') }}" class="light-logo" height="36" alt="{{ company_name }}" />
                {% endif %}
            </div>
            <twig:Topbar:AccountSwitch></twig:Topbar:AccountSwitch>
            <a class="navbar-toggler p-0 border-0 nav-icon-hover" href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="p-2">
                    <twig:Icon name="ph:dots-three" class="icon" />
                </span>
            </a>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <div class="d-flex align-items-center justify-content-between">
                    <ul class="navbar-nav flex-row mx-auto ms-lg-auto align-items-center justify-content-center">
                        {% if not public %}
                            {% if is_granted('IS_IMPERSONATOR') %}
                                <li class="nav-item me-2">
                                    <a href="{{ path('home', {'_switch_user': '_exit'}) }}" class="badge bg-warning-subtle text-warning d-flex align-items-center gap-1">
                                        <twig:Icon name="solar:masks-line-duotone" />
                                        <span>{% trans -%}Suplantando a{%- endtrans %} {{ app.user.username }}</span>
                                    </a>
                                </li>
                            {% endif %}

                            <twig:Topbar:Search></twig:Topbar:Search>
                            <li class="nav-item nav-icon-hover">
                                <a class="nav-link moon dark-layout" href="javascript:void(0)">
                                    <twig:Icon name="solar:moon-line-duotone" class="moon" />
                                </a>
                                <a class="nav-link sun light-layout" href="javascript:void(0)">
                                    <twig:Icon name="solar:sun-2-line-duotone" class="sun" />
                                </a>
                            </li>
                        {% endif %}

                        <li class="nav-item nav-icon-hover dropdown">
                            <twig:Topbar:LanguageSwitch></twig:Topbar:LanguageSwitch>
                        </li>
                        {% if not public %}
                            <twig:Topbar:Notifications></twig:Topbar:Notifications>
                            <li class="nav-item dropdown">
                                <twig:Topbar:Profile></twig:Topbar:Profile>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    </div>
</header>
