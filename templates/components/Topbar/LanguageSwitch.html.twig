{% set parameters = app.request.get('_route_params') %}

{% if parameters['_locale'] is defined and locale_list is defined %}
    <a class="nav-link position-relative" href="javascript:void(0)" id="drop2" aria-expanded="false">
        <twig:Icon name="circle-flags:{{parameters['_locale']}}"></twig:Icon>
    </a>
    <div class="dropdown-menu content-dd dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
        <div class="d-flex align-items-center justify-content-between py-3 px-7">
            <h5 class="mb-0 fs-5 fw-semibold">{% trans -%}Idioma{%- endtrans %}</h5>
        </div>
        <div class="message-body" data-simplebar>
            {% for language in locale_list | split('|') %}
                <a href="{{ path(app.request.get('_route'), parameters | merge({'_locale': language})) }}" class="py-6 px-7 d-flex align-items-center dropdown-item">
                    <span class="me-3 position-relative">
                        <twig:Icon name="circle-flags:{{language}}" size="xl"></twig:Icon>
                    </span>
                    <div class="w-75 v-middle">
                        <div class="d-flex align-items-center justify-content-between">
                            <h6 class="mb-1">{{ language | locale_name | capitalize }}</h6>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    </div>
{% endif %}