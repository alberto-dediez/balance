{% if this.enabled %}
<li class="nav-item nav-icon-hover dropdown"
    {% if this.liveEnabled %}
        data-controller="notifications-live"
        data-notifications-live-url-value="{{ path('notifications_widget') }}"
        data-notifications-live-interval-value="{{ this.pollingSeconds }}"
        data-notifications-live-new-message-value="{{ 'Tienes una nueva notificación' | trans }}"
    {% endif %}>
    <a class="nav-link position-relative" href="javascript:void(0)" id="drop-notifications" aria-expanded="false" data-bs-toggle="dropdown"
       data-notifications-live-target="toggle">
        <twig:Icon name="solar:bell-line-duotone" />
        <span class="badge rounded-pill bg-danger position-absolute top-0 end-0 fs-1 py-1 px-2 {{ this.count > 0 ? '' : 'd-none' }}"
              style="margin-top: 10px;"
              data-notifications-badge
              data-notifications-count="{{ this.count }}">
            {{ this.count > 99 ? '99+' : this.count }}
            <span class="visually-hidden">{% trans -%}notificaciones sin leer{%- endtrans %}</span>
        </span>
    </a>
    <div class="dropdown-menu content-dd dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop-notifications"
         data-notifications-menu
         data-notifications-live-target="menu">
        <div class="d-flex align-items-center justify-content-between py-3 px-7">
            <h5 class="mb-0 fs-5 fw-semibold">{% trans -%}Notificaciones{%- endtrans %}</h5>
            <span class="badge text-bg-primary rounded-pill {{ this.count > 0 ? '' : 'd-none' }}" data-notifications-pill>
                {{ this.count }} {% trans -%}sin leer{%- endtrans %}
            </span>
        </div>

        <div class="message-body">
            <div data-notifications-list>
                {% for notification in this.latest %}
                    <a href="{{ path('notification_show', {'id': notification.id}) }}" class="py-3 px-7 d-flex align-items-center border-top">
                        <span class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded round">
                            <twig:Icon name="solar:bell-bing-line-duotone" />
                        </span>
                        <div class="ps-3">
                            <h6 class="mb-1 fw-semibold">{{ notification.subject }}</h6>
                            <span class="fs-2 d-block text-body-secondary text-truncate" style="max-width: 220px;">{{ notification.body | striptags }}</span>
                            <span class="fs-1 d-block text-body-secondary">{{ notification.createdAt | date('d/m/Y H:i') }}</span>
                        </div>
                    </a>
                {% endfor %}
            </div>

            <p class="py-6 px-7 mb-0 text-center text-body-secondary {{ this.count > 0 ? 'd-none' : '' }}" data-notifications-empty>
                {% trans -%}No tienes notificaciones sin leer{%- endtrans %}
            </p>
        </div>

        <div class="d-grid py-3 px-7 border-top gap-2">
            {% if this.count > 0 %}
                <form method="post"
                      action="{{ path('notifications_mark_all_read') }}"
                      class="d-grid"
                      data-controller="mark-all-read"
                      data-action="mark-all-read#submit"
                      data-notifications-mark-all>
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_all_read') }}">
                    <button type="submit" class="btn btn-outline-primary">{% trans -%}Marcar todas como leídas{%- endtrans %}</button>
                </form>
            {% endif %}
            <a href="{{ path('notifications') }}" class="btn btn-primary">{% trans -%}Ver todas{%- endtrans %}</a>
        </div>
    </div>
</li>
{% endif %}
