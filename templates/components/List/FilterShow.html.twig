{% props label, value, id %}

<div class="alert alert-info p-2 me-2 mb-0 filter-show" data-controller="filter">
    {{ label }}:

    <b>{{ value | show_field_value | trans }}</b>

    <button 
        type="button" 
        class="btn-close ps-3" 
        aria-label="{{ 'Cerrar' | trans }}"
        data-action="filter#resetField"
        data-filter-field-param="{{ id }}"
    ></button>
</div>