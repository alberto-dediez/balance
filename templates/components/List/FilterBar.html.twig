{% props form %}

<div class="row align-items-center">
    <div class="col-12">
        <div class="d-sm-flex align-items-center justify-space-between">
            {% block content %}
                {% for field in form.vars.value | show_fields %}
                    {% if attribute(form, field) is defined %}
                        {% set formField = attribute(form, field) %}

                        {% set value = attribute(form.vars.value, field) %}

                        {% if field == 'userId' or field == 'impersonatorId' %}
                            {% set value = value | user_name %}
                        {% elseif field == 'accountId' or field == 'consultantAccountId' %}
                            {% set value = value | account_name %}
                        {% elseif field == 'propertyId' %}
                            {% set value = value | property_name %}
                        {% elseif field == 'properties' %}
                            {% set value = value | map(v => v | property_name) | join(', ') %}
                        {% elseif field == 'destinationId' or field == 'location' %}
                            {% set value = value | destination_name %}
                        {% elseif field == 'countryId' %}
                            {% set value = value | country_name %}
                        {% elseif field == 'brandId' %}
                            {% set value = value | brand_name %}
                        {% elseif field == 'categoryId' and 'mitigation_measure_category_choice' in formField.vars.block_prefixes %}
                            {% set value = value | mitigation_measure_category_name %}
                        {% elseif field == 'categoryId' %}
                            {% set value = value | category_name %}
                        {% elseif field == 'companyId' %}
                            {% set value = value | company_name %}
                        {% elseif field == 'projectId' %}
                            {% set value = value | project_name %}
                        {% elseif field == 'topicId' %}
                            {% set value = value | materiality_topic_name %}
                        {% elseif field == 'sectorId' %}
                            {% set value = value | materiality_sector_name %}
                        {% elseif field == 'signatureStatus' %}
                            {% set value = value.value | trans({}, 'signatureRequestStatus') %}
                        {% elseif field == 'status' or field == 'subjectType' %}
                            {% set value = value.value | trans({}, value | enum_domain) %}
                        {% elseif field == 'size' %}
                            {% set value = value.value | trans({}, 'eventSizeType') %}
                        {% elseif field == 'sector' %}
                            {% set value = value.value | trans({}, 'eventSectorType') %}
                        {% elseif field == 'typology' %}
                            {% set value = value.value | trans({}, 'eventTypologyType') %}
                        {% elseif field == 'scope' %}
                            {% set value = value.value | trans({}, 'materialityScopeType') %}
                        {% elseif field == 'direction' %}
                            {% set value = value.value | trans({}, 'materialityTopicDirectionType') %}
                        {% elseif field == 'criterion' %}
                            {% set value = value.value | trans({}, 'materialityCriterionType') %}
                        {% elseif field == 'currency' %}
                            {% set value = value.value | trans({}, 'unitType') %}
                        {% endif %}

                        <twig:List:FilterShow
                            label="{{ formField.vars.label }}"
                            value="{{ value }}"
                            id="#{{ formField.vars.id }}"
                        />
                    {% endif %}
                {% endfor %}
            {% endblock %}

            <button class="btn btn-secondary d-flex align-items-center justify-content-start ms-auto"
                type="button" data-bs-toggle="offcanvas" data-bs-target="#right-bar" aria-controls="filter"
                title="{% trans -%}Filtrar resultados{%- endtrans %}"
            >
                <twig:Icon name="solar:tuning-3-line-duotone" size="lg" class="me-2" />
                {% trans -%}Filtrar{%- endtrans %}
            </button>
        </div>
    </div>
</div>
