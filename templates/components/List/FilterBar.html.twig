{% props form %}

<div class="row align-items-center">
    <div class="col-12">
        <div class="d-sm-flex align-items-center justify-space-between">
            {% block content %}
                {% for field in form.vars.value | show_fields %}
                    {% if attribute(form, field) is defined %}
                        {% set formField = attribute(form, field) %}

                        {% set value = attribute(form.vars.value, field) %}

                        {% if field == 'userId' or field == 'impersonatorId' %}
                            {% set value = value | user_name %}
                        {% elseif field == 'accountId' %}
                            {% set value = value | account_name %}
                        {% elseif field == 'signatureStatus' %}
                            {% set value = value.value | trans({}, 'signatureRequestStatus') %}
                        {% endif %}

                        <twig:List:FilterShow
                            label="{{ formField.vars.label }}"
                            value="{{ value }}"
                            id="#{{ formField.vars.id }}"
                        />
                    {% endif %}
                {% endfor %}
            {% endblock %}

            <button class="btn btn-secondary d-flex align-items-center justify-content-start ms-auto"
                type="button" data-bs-toggle="offcanvas" data-bs-target="#right-bar" aria-controls="filter"
                title="{% trans -%}Filtrar resultados{%- endtrans %}"
            >
                <twig:Icon name="solar:tuning-3-line-duotone" size="lg" class="me-2" />
                {% trans -%}Filtrar{%- endtrans %}
            </button>
        </div>
    </div>
</div>
