{% props path %}

{% set separator = '?' in path ? '&' : '?' %}

<twig:List:Action path="{{ path ~ separator ~ '_token=' ~ csrf_token('contact_request_manage') | url_encode }}"
    title="{{ 'Marcar como gestionada' | trans }}"
    :attributes="attributes"
>
    <twig:Icon name="solar:check-circle-line-duotone" size="lg" />
</twig:List:Action>
