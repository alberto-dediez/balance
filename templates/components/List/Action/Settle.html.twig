{% props path, confirm %}

<twig:List:Action :path="path"
    title="{{ 'Crear liquidación' | trans }}"
    data-controller="confirm"
    data-confirm-text-param="{{ confirm }}"
    data-action="confirm#link:prevent"
    :attributes="attributes"
>
    <twig:Icon name="solar:banknote-2-line-duotone" size="lg" />
</twig:List:Action>
