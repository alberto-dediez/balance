{% props path %}

{% set separator = '?' in path ? '&' : '?' %}

<twig:List:Action path="{{ path ~ separator ~ '_token=' ~ csrf_token('mark_as_read') | url_encode }}"
    title="{{ 'Marcar como leída' | trans }}"
    {{ ...attributes }}
>
    <twig:Icon name="solar:check-read-line-duotone" size="lg" />
</twig:List:Action>
