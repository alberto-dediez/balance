{% props path %}

{% set separator = '?' in path ? '&' : '?' %}

<twig:List:Action path="{{ path ~ separator ~ '_token=' ~ csrf_token('unignore') | url_encode }}"
    title="{{ 'Reactivar' | trans }}"
    :attributes="attributes"
>
    <twig:Icon name="solar:eye-line-duotone" size="lg" />
</twig:List:Action>
