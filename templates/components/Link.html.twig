{% props path, color = 'primary' %}

{% set link = html_cva(
    base: 'btn d-flex justify-content-center',
    variants: {
        color: {
            info: 'btn-info',
            primary: 'btn-primary',
            outlinePrimary: 'btn-outline-primary',
            infoSubtle: 'bg-info-subtle text-info',
            primarySubtle: 'bg-primary-subtle text-primary',
            light: 'btn-light',
            outlineLight: 'btn-outline-light'
        }
    }
) %}

<a href="{{ path }}"
    class="{{ link.apply({color}, attributes.render('class')) }}"
    data-bs-toggle="tooltip"
    {{ attributes.without('class') }}
>
    {% block content %}{% endblock %}
</a>
