{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Huella de empresas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Empresa' | trans
        }, {
            'label': 'Año' | trans,
            'sortable': true,
            'sortableBy': 'year'
        }, {
            'label': 'Estado' | trans
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="companyCarbonFootprints" :bulkForm="bulkForm">
        <td>{{ element.companyId | company_name }}</td>
        <td>{{ element.year }}</td>
        <td>{{ element.status.value | trans({}, 'organizationalCarbonFootprintStatusType') }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('company_carbon_footprints_edit', {'companyCarbonFootprintId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('company_carbon_footprints_remove', {'companyCarbonFootprintId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('company_carbon_footprints_register') }}" />
{% endblock list_actions %}
