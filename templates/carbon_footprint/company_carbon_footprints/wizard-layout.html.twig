{% extends '@shared/layout/wizard.html.twig' %}

{% block top_actions %}
    {% set carbonFootprintReport = carbon_footprint_report('company', companyCarbonFootprintId) %}

    {% if carbonFootprintReport is not null and carbonFootprintReport.status.isGenerated and carbonFootprintReport | is_authorized('view') %}
        <twig:TopAction path="{{ path('carbon_footprint_reports_download', {reportId: carbonFootprintReport.id}) }}" target="_blank">
            <twig:Icon name="solar:file-download-line-duotone" size="lg" class="me-2" />

            {{ 'Descargar informe' | trans }}
        </twig:TopAction>

        {% if carbonFootprintReport | is_authorized('edit') %}
            <twig:TopAction path="{{ path('carbon_footprint_reports_reissue', {reportId: carbonFootprintReport.id, _token: csrf_token('carbon_footprint_report')}) }}"
                data-controller="confirm"
                data-confirm-text-param="{{ '¿Seguro que quieres reemitir el informe?' | trans }}"
                data-action="confirm#link:prevent"
            >
                <twig:Icon name="solar:refresh-line-duotone" size="lg" class="me-2" />

                {{ 'Reemitir informe' | trans }}
            </twig:TopAction>
        {% endif %}
    {% endif %}

    <twig:TopAction:Return path="{{ path('company_carbon_footprints') }}" />
{% endblock %}

{% set page_title = ('Empresas' | trans)
    ~ ' > '
    ~ (companyCarbonFootprint.companyId | company_name)
    ~ ' > '
    ~ ('Huella de Carbono' | trans)
    ~ ' '
    ~ companyCarbonFootprint.year %}

{% set wizard_active = companyCarbonFootprint.status.stepNumber %}

{% block content %}
    {% set wizard_steps = [
        {label: 'Alcance 1' | trans, href: path('company_carbon_footprints_scope_1', {companyCarbonFootprintId: companyCarbonFootprintId})},
        {label: 'Alcance 2' | trans, href: path('company_carbon_footprints_scope_2', {companyCarbonFootprintId: companyCarbonFootprintId})},
        {label: 'Alcance 3' | trans, href: path('company_carbon_footprints_scope_3', {companyCarbonFootprintId: companyCarbonFootprintId})},
        {label: 'Medidas de Reducción y Mitigación' | trans, href: path('company_carbon_footprints_mitigation_plan', {companyCarbonFootprintId: companyCarbonFootprintId})},
        {label: 'Resultados' | trans, href: path('company_carbon_footprints_results', {companyCarbonFootprintId: companyCarbonFootprintId})},
    ] %}
    {{ parent() }}
{% endblock %}
