{% extends '@carbon_footprint/company_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 1 %}

{% block top_actions %}
    {{ parent() }}
    {% if not readOnly %}
        <twig:TopAction:PrecalculatedMode :precalculated="precalculated" path="{{ path('company_carbon_footprints_precalculated_mode', {companyCarbonFootprintId: companyCarbonFootprintId, precalculated: precalculated ? 0 : 1, _token: csrf_token('remove')}) }}" />
    {% endif %}
    {% if not readOnly and not precalculated %}
        <twig:TopAction:BioscoreConsumptions path="{{ path('company_carbon_footprints_bioscore_load', {companyCarbonFootprintId: companyCarbonFootprintId, scope: 'scope_1', _token: csrf_token('bioscore_load_' ~ companyCarbonFootprint.id)}) }}" />
    {% endif %}
{% endblock %}

{% block wizard_panels %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('scope_1_' ~ companyCarbonFootprint.id) }}">

        {% if precalculated and not readOnly %}
            <twig:Alert:Alert type="info">{{ 'Huella ya calculada: introduce por cada fuente las emisiones que ya tienes calculadas (concepto y kg o t de CO₂eq). Para volver a desglosar actividades usa «Introducir datos por actividades».' | trans }}</twig:Alert:Alert>
        {% endif %}

        {% include '@carbon_footprint/organizational_carbon_footprints/_scope_1_sections.html.twig' with {unassignedLabel: 'Sin asignar a propiedad' | trans} %}

        <div class="d-flex justify-content-between mt-3">
            <span></span>
            {% if not readOnly %}
                <button type="submit" class="btn btn-primary">
                    {{ 'Siguiente' | trans }} &rarr;
                </button>
            {% endif %}
        </div>
    </form>
{% endblock %}
