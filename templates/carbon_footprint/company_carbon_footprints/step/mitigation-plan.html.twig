{% extends '@carbon_footprint/company_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 4 %}

{% block top_actions %}
    {{ parent() }}
    {% if not readOnly %}
        <twig:TopAction path="{{ path('mitigation_actions_register', {subjectType: subjectType, carbonFootprintId: companyCarbonFootprintId}) }}">
            <twig:Icon name="solar:add-square-line-duotone" size="lg" class="me-2" />

            {{ 'Añadir medida al plan' | trans }}
        </twig:TopAction>

        {% if hasPreviousFootprint %}
            <twig:TopAction:ImportMitigationActions path="{{ path('mitigation_actions_import', {subjectType: subjectType, carbonFootprintId: companyCarbonFootprintId, _token: csrf_token('mitigation_actions_import')}) }}" />
        {% endif %}
    {% endif %}
{% endblock %}

{% block wizard_panels %}
    {% include '@carbon_footprint/organizational_carbon_footprints/_mitigation_plan.html.twig' with {
        carbonFootprint: companyCarbonFootprint,
        previousPath: path('company_carbon_footprints_scope_3', {companyCarbonFootprintId: companyCarbonFootprintId}),
    } %}
{% endblock %}
