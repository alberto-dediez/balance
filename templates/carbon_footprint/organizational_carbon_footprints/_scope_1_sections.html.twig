{% set readOnly = readOnly | default(false) %}
{% set unassignedLabel = unassignedLabel | default(null) %}
{% set precalculated = precalculated | default(false) %}

<twig:CarbonFootprint:SourceSection
    source="fixed_facilities"
    :exclusion="exclusions['fixed_facilities'] ?? null"
    :reasons="exclusionReasons"
    :readOnly="readOnly"
>
    {% for block in blocks %}
        {% if precalculated %}
            <twig:CarbonFootprint:ReportedEmissionsActivityTable
                title="{{ block.property ? block.property.name : (unassignedLabel ?? ('Instalaciones' | trans)) }}"
                prefix="{{ block.prefixBase is empty ? 'fixed_facilities_reported' : block.prefixBase ~ '[fixed_facilities_reported]' }}"
                :rows="block.sections['fixed_facilities_reported'].rows ?? []"
                :readOnly="readOnly"
            />
        {% else %}
            <twig:CarbonFootprint:CombustibleActivityTable
                title="{{ block.property ? block.property.name : (unassignedLabel ?? ('Instalaciones' | trans)) }}"
                prefix="{{ block.prefixBase is empty ? 'combustibles' : block.prefixBase ~ '[combustibles]' }}"
                :rows="block.combustibleRows"
                :items="block.combustibles"
                :units="block.units"
                :calculateUrl="calculateUrl"
                :readOnly="readOnly"
            />
        {% endif %}
    {% endfor %}
</twig:CarbonFootprint:SourceSection>

