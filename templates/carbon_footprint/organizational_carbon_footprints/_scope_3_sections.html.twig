{% set readOnly = readOnly | default(false) %}
{% set unassignedLabel = unassignedLabel | default(null) %}
{% set precalculated = precalculated | default(false) %}
{% set materialityDecisions = materialityDecisions | default({}) %}

{% if pendingMaterialityReview | default(false) %}
    <twig:Alert:Alert type="warning">{{ 'El análisis de materialidad ha cambiado: hay categorías cuyo veredicto no coincide con lo aplicado. Revisa las exclusiones y guarda el paso.' | trans }}</twig:Alert:Alert>
{% endif %}

<twig:CarbonFootprint:StageExclusion
    stage="scope_3"
    :exclusion="stageExclusion"
    :reasons="exclusionReasons"
    :readOnly="readOnly"
>
    {% for direction in [{title: 'Aguas arriba' | trans, sources: upstreamSources}, {title: 'Aguas abajo' | trans, sources: downstreamSources}] %}
        <h4 class="fw-semibold mb-3">{{ direction.title }}</h4>

        {% for source in direction.sources %}
            <twig:CarbonFootprint:SourceSection
                source="{{ source }}"
                :exclusion="exclusions[source] ?? null"
                :reasons="exclusionReasons"
                :readOnly="readOnly"
                :materiality="materialityDecisions[source] ?? null"
            >
                {% if source == 'fuel_and_energy_related' %}
                    {% if precalculated %}
                        {% for block in blocks %}
                            <twig:CarbonFootprint:ReportedEmissionsActivityTable
                                title="{{ block.property ? block.property.name : (unassignedLabel ?? ('Emisiones aguas arriba de combustibles y energía' | trans)) }}"
                                prefix="{{ block.prefixBase is empty ? 'fuel_and_energy_related_reported' : block.prefixBase ~ '[fuel_and_energy_related_reported]' }}"
                                :rows="block.sections['fuel_and_energy_related_reported'].rows ?? []"
                                :readOnly="readOnly"
                            />
                        {% endfor %}
                    {% else %}
                        <twig:Card title="{{ 'Emisiones aguas arriba de combustibles y energía' | trans }}">
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Alcance' | trans }}</th>
                                            <th>{{ 'Fuente' | trans }}</th>
                                            <th>{{ 'Tipo' | trans }}</th>
                                            <th class="text-end">{{ 'Emisiones (kg CO₂eq)' | trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for line in derivedLines %}
                                            <tr>
                                                <td>{{ line.origin.stage.value | trans({}, 'scope') }}</td>
                                                <td>{{ line.origin.source.value | trans({}, 'source') }}</td>
                                                <td>{{ line.activityType.value | trans({}, 'activityType') }}</td>
                                                <td class="text-end">{{ line.emissions.co2eq | number_format(2, ',', '.') }}</td>
                                            </tr>
                                        {% else %}
                                            <tr><td colspan="4" class="text-muted">{{ 'No hay actividades registradas.' | trans }}</td></tr>
                                        {% endfor %}
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3">{{ 'Total' | trans }}</th>
                                            <th class="text-end">{{ (derivedEmissions[source] ?? null) ? derivedEmissions[source].co2eq | number_format(2, ',', '.') : '---' }}</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </twig:Card>
                    {% endif %}
                {% elseif source in ['downstream_leased_assets', 'franchises'] %}
                    {% set nonConsolidatedSource = (nonConsolidated | default({}))[source] ?? {rows: [], total: '0'} %}
                    <twig:Card title="{{ source == 'franchises' ? 'Propiedades franquiciadas' | trans : 'Propiedades arrendadas a terceros' | trans }}">
                        {% if nonConsolidatedSource.rows is empty %}
                            <p class="mb-0">{{ 'No hay propiedades de la empresa con este régimen de explotación.' | trans }}</p>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Propiedad' | trans }}</th>
                                            <th>{{ 'Origen' | trans }}</th>
                                            <th>{{ 'Franquiciado / arrendatario' | trans }}</th>
                                            <th class="text-end">{{ 'Emisiones calculadas (kg CO₂eq)' | trans }}</th>
                                            <th>{{ 'Emisiones a aplicar (kg CO₂eq)' | trans }}</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for row in nonConsolidatedSource.rows %}
                                            <tr>
                                                <td>{{ row.propertyName }}</td>
                                                <td>
                                                    {% if row.originType == 'footprint' %}
                                                        {{ 'Huella {year} completada' | trans({'{year}': row.year}) }}
                                                    {% elseif row.originType == 'operator' %}
                                                        {{ 'Aportación del franquiciado o arrendatario' | trans }}
                                                    {% else %}
                                                        <span class="badge bg-secondary">{{ 'Sin datos' | trans }}</span>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {{ row.contactEmail ?? '---' }}
                                                    {% if row.status %}
                                                        <span class="badge {{ row.status.style }}">{{ row.status.value | trans({}, 'providerContributionStatus') }}</span>
                                                        {% if row.precalculated %}
                                                            <span class="badge bg-info">{{ 'Huella ya calculada' | trans }}</span>
                                                        {% endif %}
                                                    {% endif %}
                                                </td>
                                                <td class="text-end">{{ row.calculated | number_format(2, ',', '.') }}</td>
                                                <td{% if readOnly %} class="text-end"{% endif %}>
                                                    {% if readOnly %}
                                                        {{ row.applied | number_format(2, ',', '.') }}
                                                    {% else %}
                                                        <input type="number" step="0.01" min="0" class="form-control" name="nonConsolidated[{{ row.propertyId }}][co2eq]" value="{{ row.manual }}" placeholder="{{ row.calculated }}">
                                                    {% endif %}
                                                </td>
                                                <td class="text-end text-nowrap">
                                                    {% if row.contributionId %}
                                                        {% set operatorRouteParameters = {companyCarbonFootprintId: companyCarbonFootprintId, contributionId: row.contributionId} %}
                                                        <twig:List:Action:Responses path="{{ path('company_carbon_footprints_operators_show', operatorRouteParameters) }}" />
                                                        {% if not readOnly %}
                                                            {% if not row.isIgnored %}
                                                                <twig:List:Action:Resend path="{{ path('company_carbon_footprints_operators_resend', operatorRouteParameters) }}" />
                                                            {% endif %}
                                                            {% if row.isIgnored %}
                                                                <twig:List:Action:Unignore path="{{ path('company_carbon_footprints_operators_unignore', operatorRouteParameters) }}" />
                                                            {% else %}
                                                                <twig:List:Action:Ignore path="{{ path('company_carbon_footprints_operators_ignore', operatorRouteParameters) }}" />
                                                            {% endif %}
                                                            <twig:List:Action:Delete
                                                                path="{{ path('company_carbon_footprints_operators_remove', operatorRouteParameters) }}"
                                                                confirmText="{{ 'Se eliminarán también los datos aportados por el franquiciado o arrendatario' | trans }}"
                                                            />
                                                        {% endif %}
                                                    {% elseif not readOnly %}
                                                        <twig:List:Action:Invite path="{{ path('company_carbon_footprints_operators_invite', {companyCarbonFootprintId: companyCarbonFootprintId, propertyId: row.propertyId}) }}" />
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="4">{{ 'Total' | trans }}</th>
                                            <th class="text-end">{{ nonConsolidatedSource.total | number_format(2, ',', '.') }}</th>
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        {% endif %}
                    </twig:Card>
                {% else %}
                    {% include '@carbon_footprint/organizational_carbon_footprints/_scope_3_tables.html.twig' with {source: source, blocks: blocks, unassignedLabel: unassignedLabel, calculateUrl: calculateUrl, readOnly: readOnly} %}

                    {% include '@carbon_footprint/organizational_carbon_footprints/_scope_3_provider_contributions.html.twig' with {source: source, providerContributions: providerContributions | default([])} %}

                    {% include '@carbon_footprint/organizational_carbon_footprints/_scope_3_employee_contributions.html.twig' with {source: source, employeeContributions: employeeContributions | default(null), unassignedLabel: unassignedLabel} %}
                {% endif %}
            </twig:CarbonFootprint:SourceSection>
        {% endfor %}
    {% endfor %}
</twig:CarbonFootprint:StageExclusion>
