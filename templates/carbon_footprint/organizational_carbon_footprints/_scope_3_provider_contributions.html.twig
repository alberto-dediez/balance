{% set coveringContributions = providerContributions | filter(summary => source in (summary.contribution.sources | map(covered => covered.value))) %}

{% if coveringContributions is not empty %}
    <twig:Card title="{{ 'Datos de proveedores' | trans }}">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>{{ 'Proveedor' | trans }}</th>
                        <th>{{ 'Modo' | trans }}</th>
                        <th>{{ 'Estado' | trans }}</th>
                        <th class="text-end">{{ 'Emisiones (kg CO₂eq)' | trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% set total = 0 %}
                    {% for summary in coveringContributions %}
                        {% set contribution = summary.contribution %}
                        {% set emissions = summary.emissionsFor(source).co2eq %}
                        {% set total = total + emissions %}
                        <tr>
                            <td>{{ summary.provider ? summary.provider.name : (contribution.companyName ?? '---') }}</td>
                            <td>{{ contribution.mode.value | trans({}, 'providerContributionMode') }}</td>
                            <td>
                                <span class="badge {{ contribution.status.style }}">{{ contribution.status.value | trans({}, 'providerContributionStatus') }}</span>
                            </td>
                            <td class="text-end">{{ emissions | number_format(2, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">{{ 'Total' | trans }}</th>
                        <th class="text-end">{{ total | number_format(2, ',', '.') }}</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </twig:Card>
{% endif %}
