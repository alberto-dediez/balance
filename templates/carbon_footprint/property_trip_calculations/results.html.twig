{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    {% if is_granted('ROLE_OWNER') %}
        <twig:TopAction path="{{ path('owner_contribution_choose', {origin: 'property', originId: property.id}) }}" target="_blank">
            <twig:Icon name="solar:hand-heart-bold" size="lg" class="me-2" />

            {{ 'Compensar emisiones' | trans }}
        </twig:TopAction>
    {% endif %}

    <twig:TopAction:Return path="{{ path('properties') }}" />
{% endblock %}

{% set page_title = ('Propiedades' | trans)
    ~ ' > '
    ~ ('Respuestas' | trans)
    ~ ' > '
    ~ property.name %}

{% block content %}
    {% include '@carbon_footprint/property_trip_calculations/_stats.html.twig' %}
{% endblock %}
