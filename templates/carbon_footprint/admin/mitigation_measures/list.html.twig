{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Medidas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Categoría' | trans,
            'sortable': false
        }, {
            'label': 'Efectos' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="mitigationMeasures" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.categoryId | mitigation_measure_category_name }}</td>
        <td>
            {% for effect in element.effects %}
                <div>
                    {{ effect.source.value | trans({}, 'source') }}:
                    {{ (effect.minimumReduction * 100) | number_format(2, ',', '.') }} % – {{ (effect.maximumReduction * 100) | number_format(2, ',', '.') }} %
                </div>
            {% endfor %}
        </td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('admin_mitigation_measures_edit', {'mitigationMeasureId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('admin_mitigation_measures_remove', {'mitigationMeasureId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_mitigation_measures_register') }}" />
{% endblock list_actions %}
