{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Bienes y servicios comprados' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Categoría' | trans,
            'sortable': false
        }, {
            'label': 'Unidad' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': 'Fecha de actualización' | trans,
            'sortable': true,
            'sortableBy': 'updatedAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="purchaseServices" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.category.value | trans({}, 'purchaseServiceCategoryType') }}</td>
        <td>{{ element.unit.value | trans({}, 'unitType') }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>{{ element.updatedAt ? element.updatedAt | date('d/m/Y') : '' }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('admin_purchase_services_edit', {'purchaseServiceId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('admin_purchase_services_remove', {'purchaseServiceId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:EmissionFactors path="{{ path('admin_purchase_services_emission_factors') }}" />
    <twig:Link:Import path="{{ path('import', {'code': 'purchase_services'}) }}" />
    <twig:Link:Export path="{{ path('export', {'code': 'purchase_services'}) }}" />
    <twig:Link:Register path="{{ path('admin_purchase_services_register') }}" />
{% endblock list_actions %}
