{% extends routes.layout %}

{% set page_title = 'Compensar emisiones' | trans %}

{% block card_body %}
    <div class="mb-4">
        <h5 class="mb-1">{{ project.name }}</h5>
        <p class="text-muted small mb-0">
            {{ 'Compensas con tus propios lotes de crédito, así que no se te cobra nada.' | trans }}
        </p>
    </div>

    <form method="post" name="contribution" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token(routes.csrfTokenId) }}">

        <fieldset class="mb-4">
            <legend class="fs-6 fw-semibold">{{ '¿Cuánto quieres compensar?' | trans }}</legend>

            <div class="mb-2">
                <label class="form-label" for="contribution_co2eq">{{ 'Emisiones (kg CO₂eq)' | trans }}</label>
                <input class="form-control" type="number" min="0.01" step="0.01" required
                       id="contribution_co2eq" name="contribution[co2eqKg]"
                       value="{{ contribution.co2eqKg | default('') }}">
                {% if suggestedCo2eqKg is not null %}
                    <div class="form-text">
                        {{ 'La huella calculada es de {kg} kg CO₂eq.' | trans({'{kg}': suggestedCo2eqKg | number_format(2, ',', '.')}) }}
                    </div>
                {% endif %}
            </div>

        </fieldset>

        <fieldset class="mb-4">
            <legend class="fs-6 fw-semibold">{{ 'Datos del certificado' | trans }}</legend>

            <div class="mb-2">
                <label class="form-label" for="contribution_name">{{ 'Nombre' | trans }}</label>
                <input class="form-control" type="text" required
                       id="contribution_name" name="contribution[name]"
                       value="{{ contribution.name | default('') }}">
            </div>

            <div class="mb-2">
                <label class="form-label" for="contribution_email">{{ 'Email' | trans }}</label>
                <input class="form-control" type="email" required
                       id="contribution_email" name="contribution[email]"
                       value="{{ contribution.email | default('') }}">
            </div>

            <div class="mb-2">
                <label class="form-label" for="contribution_country">{{ 'País' | trans }}</label>
                <select class="form-select" required id="contribution_country" name="contribution[country]">
                    <option value="">{{ 'Elige un país' | trans }}</option>
                    {% for iso, name in countries %}
                        <option value="{{ iso }}" {{ iso == country ? 'selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" value="1"
                       id="contribution_is_company" name="contribution[isCompany]"
                       {{ contribution.isCompany | default(false) ? 'checked' : '' }}>
                <label class="form-check-label" for="contribution_is_company">
                    {{ 'Compenso como empresa' | trans }}
                </label>
            </div>

            <div class="mb-2 contribution-company-field">
                <label class="form-label" for="contribution_company_name">{{ 'Razón social' | trans }}</label>
                <input class="form-control" type="text"
                       id="contribution_company_name" name="contribution[companyName]"
                       value="{{ contribution.companyName | default('') }}">
            </div>

            <div class="mb-2 contribution-company-field">
                <label class="form-label" for="contribution_vat_number">{{ 'NIF / NIF-IVA' | trans }}</label>
                <input class="form-control text-uppercase" type="text"
                       id="contribution_vat_number" name="contribution[vatNumber]"
                       value="{{ contribution.vatNumber | default('') }}">
            </div>
        </fieldset>

        <div id="contribution_summary">
            {{ include('@carbon_footprint/owner_contribution/_summary.html.twig') }}
        </div>
    </form>

    <script>
        (function () {
            var form = document.forms.contribution;
            var summary = document.getElementById('contribution_summary');
            var isCompany = document.getElementById('contribution_is_company');
            var companyFields = document.querySelectorAll('.contribution-company-field');
            var pending = null;

            function toggle() {
                companyFields.forEach(function (field) {
                    field.style.display = isCompany.checked ? '' : 'none';
                });
            }

            // The valuation depends on the emissions typed, so every change of them asks for it
            // again instead of leaving the owner to work it out by hand. Only the valuation is
            // replaced: what they have typed stays as it is.
            function recalculate() {
                toggle();
                summary.setAttribute('aria-busy', 'true');

                var request = fetch(window.location.href, {
                    method: 'POST',
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                    body: new FormData(form),
                });

                pending = request;

                request
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('The valuation could not be refreshed.');
                        }

                        return response.text();
                    })
                    .then(function (html) {
                        // A slower answer to an older change must not overwrite the last one.
                        if (pending === request) {
                            summary.innerHTML = html;
                            summary.removeAttribute('aria-busy');
                        }
                    })
                    .catch(function () {
                        if (pending === request) {
                            summary.removeAttribute('aria-busy');
                            form.submit();
                        }
                    });
            }

            document.getElementById('contribution_co2eq').addEventListener('change', recalculate);
            isCompany.addEventListener('change', toggle);

            toggle();
        })();
    </script>

    <div class="text-center mt-4">
        <a class="btn btn-link btn-sm text-muted" href="{{ path(routes.choose, routes.routeParams) }}">
            {{ 'Elegir otro proyecto' | trans }}
        </a>
    </div>
{% endblock %}
