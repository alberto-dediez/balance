{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('events') }}" />
{% endblock %}

{% set page_title = ('Eventos' | trans)
    ~ ' > '
    ~ event.name
    ~ ' > '
    ~ ('Cálculo de Huella de Carbono' | trans) %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.calculationPeriodStartDate) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.calculationPeriodEndDate) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.status) }}
                </div>

                <div class="col-12">
                    <div class="mb-3">
                        <label class="form-label">{{ 'Emisiones totales' | trans }}</label>
                        <div class="form-control-plaintext">
                            <dl class="row mb-0">
                                <dt class="col-sm-3">{{ 'CO₂ equivalente (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.totalEmissions.co2eq }}</dd>
                                <dt class="col-sm-3">{{ 'CO₂ (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.totalEmissions.co2 }}</dd>
                                <dt class="col-sm-3">{{ 'CH₄ (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.totalEmissions.ch4 }}</dd>
                                <dt class="col-sm-3">{{ 'N₂O (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.totalEmissions.n2o }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="mb-3">
                        <label class="form-label">{{ 'Emisiones por asistente' | trans }}</label>
                        <div class="form-control-plaintext">
                            <dl class="row mb-0">
                                <dt class="col-sm-3">{{ 'CO₂ equivalente (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.emissionsPerAttendee.co2eq }}</dd>
                                <dt class="col-sm-3">{{ 'CO₂ (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.emissionsPerAttendee.co2 }}</dd>
                                <dt class="col-sm-3">{{ 'CH₄ (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.emissionsPerAttendee.ch4 }}</dd>
                                <dt class="col-sm-3">{{ 'N₂O (kg)' | trans }}</dt>
                                <dd class="col-sm-9">{{ eventCarbonFootprint.emissionsPerAttendee.n2o }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
