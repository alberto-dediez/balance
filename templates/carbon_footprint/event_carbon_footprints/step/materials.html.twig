{% extends '@carbon_footprint/event_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 1 %}
{% set readOnly = readOnly | default(false) %}

{% block wizard_panels %}
    {% if not readOnly %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('materials_' ~ eventCarbonFootprint.id) }}">
    {% endif %}

        <twig:CarbonFootprint:SourceSection
            source="materials"
            :exclusion="exclusions['materials'] ?? null"
            :reasons="exclusionReasons"
            :readOnly="readOnly"
        >
            <twig:CarbonFootprint:MaterialActivityTable
                title="{{ 'Materiales fabricados y utilizados para el evento' | trans }}"
                prefix="materials"
                :rows="activityRows['material']"
                :items="materials"
                :units="units"
                :eventId="eventId"
                :readOnly="readOnly"
            />

            <twig:CarbonFootprint:MerchandisingItemActivityTable
                title="{{ 'Merchandising fabricado y utilizado para el evento' | trans }}"
                prefix="merchandisingItems"
                :rows="activityRows['merchandising_item']"
                :items="merchandisingItems"
                :units="units"
                :eventId="eventId"
                :readOnly="readOnly"
            />

            <twig:CarbonFootprint:CateringItemActivityTable
                title="{{ 'Catering adquirido para el evento' | trans }}"
                prefix="cateringItems"
                :rows="activityRows['catering_item']"
                :items="cateringItems"
                :units="units"
                :eventId="eventId"
                :readOnly="readOnly"
            />
        </twig:CarbonFootprint:SourceSection>

    {% if not readOnly %}
        <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-primary">
                {{ 'Siguiente' | trans }} &rarr;
            </button>
        </div>
    </form>
    {% else %}
        <div class="d-flex justify-content-end mt-3">
            <a href="{{ path('events_carbon_footprint_results', {eventId: eventId, step: 'assembly'}) }}" class="btn btn-primary">
                {{ 'Siguiente' | trans }} &rarr;
            </a>
        </div>
    {% endif %}
{% endblock %}
