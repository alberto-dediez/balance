{% extends '@carbon_footprint/event_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 2 %}

{% block wizard_panels %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('assembly_' ~ eventCarbonFootprint.id) }}">

        <twig:CarbonFootprint:ActivityTable
            title="{{ 'Combustibles fijos en instalaciones' | trans }}"
            prefix="combustibles"
            type="combustible"
            mainLabel="Combustible"
            :rows="combustibleRows"
            :items="combustibles"
            :units="units"
            :eventId="eventId"
            :showCondition="false"
        />
        <twig:CarbonFootprint:ActivityTable
            title="{{ 'Transporte de mercancías' | trans }}"
            prefix="roadTransports"
            type="road_transport"
            mainLabel="Transporte"
            :rows="roadTransportRows"
            :items="roadTransports"
            :units="units"
            :eventId="eventId"
            :showCondition="false"
        />
        <twig:CarbonFootprint:ActivityTable
            title="{{ 'Combustible de maquinaria' | trans }}"
            prefix="machineryFuels"
            type="machinery_fuel"
            :rows="machineryFuelRows"
            :items="machineryFuels"
            :units="units"
            :eventId="eventId"
            :showCondition="false"
        />
        <twig:CarbonFootprint:ElectricityActivityTable
            title="{{ 'Electricidad de maquinaria' | trans }}"
            prefix="machineryElectricity"
            :rows="machineryElectricityRows"
            :marketers="electricityMarketers"
            :gdOFactors="gdOFactors"
            :eventId="eventId"
        />
        <twig:CarbonFootprint:ElectricityActivityTable
            title="{{ 'Electricidad de instalaciones' | trans }}"
            prefix="buildingElectricity"
            :rows="buildingElectricityRows"
            :marketers="electricityMarketers"
            :gdOFactors="gdOFactors"
            :eventId="eventId"
        />
        <twig:CarbonFootprint:ActivityTable
            title="{{ 'Pernoctaciones' | trans }}"
            prefix="overnightStays"
            type="overnight_stay"
            :rows="overnightStayRows"
            :items="overnightStays"
            :units="units"
            :eventId="eventId"
            :showCondition="false"
        />
        <twig:CarbonFootprint:ActivityTable
            title="{{ 'Movilidad de proveedores y equipo' | trans }}"
            prefix="mobilities"
            type="mobility"
            :rows="mobilityRows"
            :items="mobilities"
            :units="units"
            :eventId="eventId"
            :showCondition="false"
        />
        <twig:CarbonFootprint:ActivityTable
            title="{{ 'Gestión de residuos' | trans }}"
            prefix="wastes"
            type="waste"
            :rows="wasteRows"
            :items="wastes"
            :units="units"
            :eventId="eventId"
            :showCondition="false"
        />

        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('events_carbon_footprint_materials', {eventId: eventId}) }}" class="btn btn-outline-secondary">
                &larr; {{ 'Anterior' | trans }}
            </a>
            <button type="submit" class="btn btn-primary">
                {{ 'Siguiente' | trans }} &rarr;
            </button>
        </div>
    </form>
{% endblock %}
