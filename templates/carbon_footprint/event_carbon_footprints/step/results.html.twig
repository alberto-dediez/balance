{% extends '@carbon_footprint/event_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 8 %}

{% block wizard_panels %}
    {% if eventCarbonFootprint.status.isCompleted and results is not null %}
        <div class="row">
            <div class="col-9">
                <twig:Card title="{{ 'Totales' | trans }}">
                    <dl class="row mt-3">
                        <dt class="col-sm-4">{{ 'CO₂ equivalente total (kg)' | trans }}</dt>
                        <dd class="col-sm-8">{{ results.totalEmissions.co2eq | number_format(2, ',', '.') }}</dd>

                        <dt class="col-sm-4">{{ 'CO₂ (kg)' | trans }}</dt>
                        <dd class="col-sm-8">{{ results.totalEmissions.co2 | number_format(2, ',', '.') }}</dd>

                        <dt class="col-sm-4">{{ 'CH₄ (kg)' | trans }}</dt>
                        <dd class="col-sm-8">{{ results.totalEmissions.ch4 | number_format(2, ',', '.') }}</dd>

                        <dt class="col-sm-4">{{ 'N₂O (kg)' | trans }}</dt>
                        <dd class="col-sm-8">{{ results.totalEmissions.n2o | number_format(2, ',', '.') }}</dd>
                    </dl>

                    {% if results.electricityActivities > 0 %}
                        <dl class="row">
                            <dt class="col-sm-4">{{ 'Electricidad · método de mercado (kg CO₂eq)' | trans }}</dt>
                            <dd class="col-sm-8">{{ results.marketBasedElectricityEmissions.co2eq | number_format(2, ',', '.') }}</dd>

                            <dt class="col-sm-4">{{ 'Electricidad · método de localización (kg CO₂eq)' | trans }}</dt>
                            <dd class="col-sm-8">{{ results.locationBasedElectricityEmissions.co2eq | number_format(2, ',', '.') }}</dd>

                            <dt class="col-sm-4">{{ 'Total · método de localización (kg CO₂eq)' | trans }}</dt>
                            <dd class="col-sm-8">{{ results.locationBasedTotalEmissions.co2eq | number_format(2, ',', '.') }}</dd>
                        </dl>

                        {% if results.electricityActivitiesWithoutLocationBased > 0 %}
                            <twig:Alert:Alert type="warning">{{ 'Actividades de electricidad sin factor de mix eléctrico para su país y año: {count}. No se incluyen en el método de localización y conservan su valor de mercado en el total por localización.' | trans({'{count}': results.electricityActivitiesWithoutLocationBased}) }}</twig:Alert:Alert>
                        {% endif %}
                    {% endif %}

                    {% if attendeesUsed is not empty and attendeesUsed > 0 %}
                        <dl class="row">
                            <dt class="col-sm-4">{{ 'CO₂ equivalente por asistente (kg)' | trans }}</dt>
                            <dd class="col-sm-8">{{ results.emissionsPerAttendee.co2eq | number_format(3, ',', '.') }}</dd>

                            <dt class="col-sm-4">{{ 'Asistentes considerados' | trans }}</dt>
                            <dd class="col-sm-8">{{ attendeesUsed }}</dd>
                        </dl>
                    {% else %}
                        <twig:Alert:Alert type="warning">{{ 'No hay asistentes reales ni estimados disponibles, por lo que no se ha podido calcular la huella por asistente.' | trans }}</twig:Alert:Alert>
                    {% endif %}
                </twig:Card>

                <div class="row">
                    <div class="col-lg-6 d-flex">
                        <div class="card flex-fill">
                            <div class="card-header fw-semibold">{{ 'Emisiones por fuente' | trans }} <span class="text-muted fw-normal">(kg CO₂eq)</span></div>
                            <div class="card-body">
                                {% if sourceChart.values is not empty %}
                                    <twig:Chart:Donut
                                        title="{{ 'Emisiones por fuente' | trans }}"
                                        :values="sourceChart.values"
                                        :categories="sourceChart.labels"
                                        unit="kg"
                                        :decimals="0"
                                        :legend="true"
                                    />
                                {% else %}
                                    <p class="text-muted mb-0">{{ 'No hay emisiones registradas por fuente.' | trans }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 d-flex">
                        <div class="card flex-fill">
                            <div class="card-header fw-semibold">{{ 'Emisiones por fase' | trans }} <span class="text-muted fw-normal">(kg CO₂eq)</span></div>
                            <div class="card-body">
                                <twig:Chart:Bar
                                    title="{{ 'Emisiones' | trans }}"
                                    :values="phaseChart.values"
                                    :categories="phaseChart.labels"
                                    :colors="['var(--bs-info)', 'var(--bs-warning)', 'var(--bs-primary)', 'var(--bs-success)']"
                                    unit="kg"
                                    :decimals="0"
                                />
                            </div>
                        </div>
                    </div>

                    {% if originsChart.values is not empty %}
                        <div class="col-lg-12 d-flex">
                            <div class="card flex-fill">
                                <div class="card-header fw-semibold">{{ 'Principales orígenes de los asistentes' | trans }} <span class="text-muted fw-normal">({{ 'respuestas' | trans }})</span></div>
                                <div class="card-body">
                                    <twig:Chart:Bar
                                        title="{{ 'Respuestas' | trans }}"
                                        :values="originsChart.values"
                                        :categories="originsChart.categories"
                                        :colors="['var(--bs-info)']"
                                        :decimals="0"
                                        :labelDecimals="0"
                                    />
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="col-3">
                <twig:CarbonFootprint:ReportStatus :report="report" :canEdit="eventCarbonFootprint | is_authorized('edit')" />

                {% if report is not null and report.status.isGenerated and reportOutdated %}
                    <twig:Card title="{{ 'Informe de huella de carbono' | trans }}">
                        <twig:Alert:Alert type="warning">{{ 'Se han registrado compensaciones posteriores a la última emisión del informe. Reemítelo para incluirlas.' | trans }}</twig:Alert:Alert>

                        {% if eventCarbonFootprint | is_authorized('edit') %}
                            <a href="{{ path('carbon_footprint_reports_reissue', {reportId: report.id, _token: csrf_token('carbon_footprint_report')}) }}"
                               class="btn btn-outline-secondary mt-2"
                               data-controller="confirm"
                               data-confirm-text-param="{{ '¿Seguro que quieres reemitir el informe?' | trans }}"
                               data-action="confirm#link:prevent"
                            >
                                <twig:Icon name="solar:refresh-line-duotone" />
                                {{ 'Reemitir informe' | trans }}
                            </a>
                        {% endif %}
                    </twig:Card>
                {% endif %}

                {% if eventCarbonFootprint | is_authorized('edit') %}
                    <twig:Card title="{{ 'Reabrir cálculo' | trans }}">
                        <p class="text-muted">
                            {{ 'Al reabrir el cálculo podrás volver a editar todas las fases. Se conservarán los datos introducidos, pero se eliminará el informe generado.' | trans }}
                        </p>

                        <form method="post" action="{{ path('events_carbon_footprint_reopen', {eventId: eventId}) }}" onsubmit="return confirm('{{ '¿Seguro que quieres reabrir el cálculo? Se eliminará el informe generado.' | trans | e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('reopen_' ~ eventCarbonFootprint.id) }}">
                            <button type="submit" class="btn btn-outline-danger">
                                <twig:Icon name="solar:restart-line-duotone" />
                                {{ 'Reabrir cálculo' | trans }}
                            </button>
                        </form>
                    </twig:Card>
                {% endif %}

                {% if compensation is defined and compensation is not null and compensation.hasCompensations %}
                    <twig:Card title="{{ 'Compensación de emisiones' | trans }}">
                        {% if compensationChart.values is not empty %}
                            <twig:Chart:SemiDonut
                                title="{{ 'Compensación' | trans }}"
                                :values="compensationChart.values"
                                :categories="compensationChart.categories"
                                :colors="['var(--bs-success)', 'var(--bs-info)', 'var(--bs-light)']"
                                unit="t"
                                :decimals="3"
                                :legend="true"
                            />
                        {% endif %}

                        <dl class="row mt-3">
                            <dt class="col-sm-7">{{ 'Compensado por la empresa (t CO₂eq)' | trans }}</dt>
                            <dd class="col-sm-5">{{ compensation.ownTonnes | number_format(3, ',', '.') }}</dd>

                            <dt class="col-sm-7">{{ 'Compensado por los asistentes (t CO₂eq)' | trans }}</dt>
                            <dd class="col-sm-5">{{ compensation.attendeesTonnes | number_format(3, ',', '.') }}</dd>

                            <dt class="col-sm-7">{{ 'Total compensado (t CO₂eq)' | trans }}</dt>
                            <dd class="col-sm-5">{{ compensation.totalTonnes | number_format(3, ',', '.') }}</dd>

                            <dt class="col-sm-7">{{ 'Cobertura sobre las emisiones totales' | trans }}</dt>
                            <dd class="col-sm-5">{{ min(compensation.coveragePercentage, 100) | number_format(2, ',', '.') }} %</dd>
                        </dl>
                    </twig:Card>
                {% endif %}

                {% if surveyStats is not null %}
                    <twig:Card title="{{ 'Encuesta de asistentes' | trans }}">
                        <dl class="row">
                            <dt class="col-sm-8">{{ 'Respuestas recibidas' | trans }}</dt>
                            <dd class="col-sm-4">{{ surveyStats.responsesCount }}</dd>

                            <dt class="col-sm-8">{{ 'Asistentes reales' | trans }}</dt>
                            <dd class="col-sm-4">{{ surveyStats.attendeeSurvey.realAttendees ?? '-' }}</dd>

                            <dt class="col-sm-8">{{ '% encuestados' | trans }}</dt>
                            <dd class="col-sm-4">{{ surveyStats.surveyedPercentage is not null ? (surveyStats.surveyedPercentage | number_format(1)) ~ ' %' : '-' }}</dd>

                            {% if surveyStats.attendeeSurvey.confidenceLevel is not null %}
                                <dt class="col-sm-8">{{ 'Nivel de confianza' | trans }}</dt>
                                <dd class="col-sm-4">{{ surveyStats.attendeeSurvey.confidenceLevel.value }}%</dd>
                            {% endif %}

                            {% if surveyStats.attendeeSurvey.marginOfError is not null %}
                                <dt class="col-sm-8">{{ 'Margen de error' | trans }}</dt>
                                <dd class="col-sm-4">{{ (surveyStats.attendeeSurvey.marginOfError * 100) | number_format(2) }}%</dd>
                            {% endif %}
                        </dl>
                    </twig:Card>
                {% endif %}
            </div>
        </div>

        <twig:Card title="{{ 'Desglose por fase' | trans }}">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>{{ 'Fase' | trans }}</th>
                        <th class="text-end">{{ 'CO₂eq (kg)' | trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for phase, emissions in results.emissionsByPhase %}
                        <tr>
                            <td>{{ phase | trans({}, 'phase') }}</td>
                            <td class="text-end">{{ emissions.co2eq | number_format(2, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card>

        <twig:Card title="{{ 'Desglose por fuente' | trans }}">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>{{ 'Fuente' | trans }}</th>
                        <th class="text-end">{{ 'CO₂eq (kg)' | trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for source, emissions in results.emissionsBySource %}
                        <tr>
                            <td>{{ source | trans({}, 'source') }}</td>
                            <td class="text-end">{{ emissions.co2eq | number_format(2, ',', '.') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card>

        {% if exclusions is not empty %}
            <twig:Card title="{{ 'Fuentes de emisión excluidas' | trans }}">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                        <tr>
                            <th>{{ 'Fase' | trans }}</th>
                            <th>{{ 'Fuente' | trans }}</th>
                            <th>{{ 'Motivo' | trans }}</th>
                            <th>{{ 'Comentario' | trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for exclusion in exclusions %}
                            <tr>
                                <td>{{ exclusion.phase }}</td>
                                <td>{{ exclusion.source }}</td>
                                <td>{{ exclusion.reason }}</td>
                                <td>{{ exclusion.comment ?? '-' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </twig:Card>
        {% endif %}

        <twig:Card title="{{ 'Matriz fase × fuente' | trans }}">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>{{ 'Fase' | trans }}</th>
                            <th>{{ 'Fuente' | trans }}</th>
                            <th class="text-end">{{ 'CO₂eq (kg)' | trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for phase, sources in results.emissionsByPhaseAndSource %}
                            {% for source, emissions in sources %}
                                <tr>
                                    <td>{{ phase | trans({}, 'phase') }}</td>
                                    <td>{{ source | trans({}, 'source') }}</td>
                                    <td class="text-end">{{ emissions.co2eq | number_format(2, ',', '.') }}</td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card>
    {% else %}
        <div class="alert alert-info mt-3" role="alert">
            {{ 'Estamos procesando su Huella de Carbono, en breve tendrá los resultados disponibles.' | trans }}
        </div>
    {% endif %}
{% endblock %}
