{% extends '@shared/layout/wizard.html.twig' %}

{% block top_actions %}
    {% set carbonFootprintReport = event_carbon_footprint_report(eventId) %}

    {% if carbonFootprintReport is not null and carbonFootprintReport.status.isGenerated and carbonFootprintReport | is_authorized('view') %}
        <twig:TopAction path="{{ path('carbon_footprint_reports_download', {reportId: carbonFootprintReport.id}) }}" target="_blank">
            <twig:Icon name="solar:file-download-line-duotone" size="lg" class="me-2" />

            {{ 'Descargar informe' | trans }}
        </twig:TopAction>

        {% if carbonFootprintReport | is_authorized('edit') %}
            <twig:TopAction path="{{ path('carbon_footprint_reports_reissue', {reportId: carbonFootprintReport.id, _token: csrf_token('carbon_footprint_report')}) }}"
                data-controller="confirm"
                data-confirm-text-param="{{ '¿Seguro que quieres reemitir el informe?' | trans }}"
                data-action="confirm#link:prevent"
            >
                <twig:Icon name="solar:refresh-line-duotone" size="lg" class="me-2" />

                {{ 'Reemitir informe' | trans }}
            </twig:TopAction>
        {% endif %}

        {% if is_granted('ROLE_OWNER') %}
            <twig:TopAction path="{{ path('owner_contribution_choose', {origin: 'event_carbon_footprint', originId: eventId}) }}" target="_blank">
                <twig:Icon name="solar:hand-heart-bold" size="lg" class="me-2" />

                {{ 'Compensar emisiones' | trans }}
            </twig:TopAction>
        {% endif %}
    {% endif %}

    <twig:TopAction:Return path="{{ path('events') }}" />
{% endblock %}

{% set page_title = ('Eventos' | trans)
    ~ ' > '
    ~ event.name
    ~ ' > '
    ~ ('Huella de Carbono' | trans) %}

{% set wizard_active = eventCarbonFootprint.status.activeStepNumber %}

{% block content %}
    {% set rejectedReport = event_carbon_footprint_report(eventId) %}

    {% if rejectedReport is not null and rejectedReport.status.isRejected %}
        <twig:Alert:Alert type="danger">
            {{ 'El informe ha sido rechazado: {comment}' | trans({'{comment}': rejectedReport.reviewComment}) }}
            {{ 'Revisa los datos de la huella; al completarla de nuevo se generará un informe nuevo.' | trans }}
        </twig:Alert:Alert>
    {% endif %}

    {% set isCompleted = eventCarbonFootprint.status.isCompleted %}
    {% set wizard_steps = [
        {label: 'Materiales' | trans, href: isCompleted ? path('events_carbon_footprint_results', {eventId: eventId, step: 'materials'}) : path('events_carbon_footprint_materials', {eventId: eventId})},
        {label: 'Montaje'  | trans, href: isCompleted ? path('events_carbon_footprint_results', {eventId: eventId, step: 'assembly'}) : path('events_carbon_footprint_assembly',  {eventId: eventId})},
        {label: 'Celebracion' | trans, href: isCompleted ? path('events_carbon_footprint_results', {eventId: eventId, step: 'celebration'}) : path('events_carbon_footprint_celebration', {eventId: eventId})},
        {label: 'Desmontaje' | trans, href: isCompleted ? path('events_carbon_footprint_results', {eventId: eventId, step: 'breakdown'}) : path('events_carbon_footprint_breakdown', {eventId: eventId})},
        {label: 'Proveedores' | trans, href: isCompleted ? path('events_carbon_footprint_results', {eventId: eventId, step: 'providers'}) : path('events_carbon_footprint_providers', {eventId: eventId})},
        {label: 'Empleados' | trans, href: isCompleted ? path('events_carbon_footprint_results', {eventId: eventId, step: 'employees'}) : path('events_carbon_footprint_employees', {eventId: eventId})},
        {label: 'Asistentes' | trans, href: isCompleted ? path('events_carbon_footprint_results', {eventId: eventId, step: 'attendees'}) : path('events_carbon_footprint_attendees', {eventId: eventId})},
        {label: 'Resultados'   | trans, href: path('events_carbon_footprint_results',   {eventId: eventId})},
    ] %}
    {{ parent() }}
{% endblock %}
