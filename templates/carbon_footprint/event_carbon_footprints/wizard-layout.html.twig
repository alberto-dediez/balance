{% extends '@shared/layout/wizard.html.twig' %}

{% block top_actions %}
    {% set carbonFootprintReport = event_carbon_footprint_report(eventId) %}

    {% if carbonFootprintReport is not null and carbonFootprintReport.status.isGenerated and carbonFootprintReport | is_authorized('view') %}
        <twig:TopAction path="{{ path('events_carbon_footprint_report_download', {eventId: eventId}) }}" target="_blank">
            <twig:Icon name="solar:file-download-line-duotone" size="lg" class="me-2" />

            {{ 'Descargar informe' | trans }}
        </twig:TopAction>
    {% endif %}

    <twig:TopAction:Return path="{{ path('events') }}" />
{% endblock %}

{% set page_title = ('Eventos' | trans)
    ~ ' > '
    ~ event.name
    ~ ' > '
    ~ ('Huella de Carbono' | trans) %}

{% set wizard_active = eventCarbonFootprint.status.activeStepNumber %}

{% block content %}
    {% set wizard_steps = [
        {label: 'Materiales' | trans, href: path('events_carbon_footprint_materials', {eventId: eventId})},
        {label: 'Montaje'  | trans, href: path('events_carbon_footprint_assembly',  {eventId: eventId})},
        {label: 'Celebracion' | trans, href: path('events_carbon_footprint_celebration', {eventId: eventId})},
        {label: 'Desmontaje' | trans, href: path('events_carbon_footprint_breakdown', {eventId: eventId})},
        {label: 'Proveedores' | trans, href: path('events_carbon_footprint_providers', {eventId: eventId})},
        {label: 'Asistentes' | trans, href: path('events_carbon_footprint_attendees', {eventId: eventId})},
        {label: 'Resultados'   | trans, href: path('events_carbon_footprint_results',   {eventId: eventId})},
    ] %}
    {{ parent() }}
{% endblock %}
