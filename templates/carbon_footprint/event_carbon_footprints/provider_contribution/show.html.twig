{% extends '@shared/layout/action.html.twig' %}

{% set page_title = ('Eventos' | trans)
    ~ ' > '
    ~ event.name
    ~ ' > '
    ~ ('Huella de Carbono' | trans)
    ~ ' > '
    ~ ('Contribución de proveedor' | trans)
    ~ ' > '
    ~ (providerContribution.companyName ?? '')
%}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('events_carbon_footprint_providers', {eventId: eventId}) }}" />
{% endblock %}

{% block content %}
    <twig:Card title="{{ 'Datos de la empresa' | trans }}">
        <dl class="row">
            <dt class="col-sm-3">{{ 'Empresa' | trans }}</dt>
            <dd class="col-sm-9">{{ providerContribution.companyName ?? '-' }}</dd>

            <dt class="col-sm-3">{{ 'Tipo de empresa' | trans }}</dt>
            <dd class="col-sm-9">{{ providerContribution.companyType ?? '-' }}</dd>

            <dt class="col-sm-3">{{ 'Servicio prestado' | trans }}</dt>
            <dd class="col-sm-9">{{ providerContribution.service ?? '-' }}</dd>

            <dt class="col-sm-3">{{ 'Trabajadores (Montaje / Celebración / Desmontaje)' | trans }}</dt>
            <dd class="col-sm-9">
                {{ providerContribution.workersAssembly ?? '-' }} /
                {{ providerContribution.workersCelebration ?? '-' }} /
                {{ providerContribution.workersBreakdown ?? '-' }}
            </dd>
        </dl>
    </twig:Card>

    {% for phaseLabel, phaseKey in {'Montaje': 'assembly', 'Celebración': 'celebration', 'Desmontaje': 'breakdown'} %}
        {% set view = viewByPhase[phaseKey] %}
        <twig:Card title="{{ phaseLabel | trans }}">
            {% for sectionLabel, rowsKey in {'Combustible': 'combustibleRows', 'Combustible de maquinaria': 'machineryFuelRows', 'Pernoctación': 'overnightStayRows', 'Movilidad': 'mobilityRows'} %}
                <h6 class="mt-2">{{ sectionLabel | trans }}</h6>
                {% if view[rowsKey] is empty %}
                    <p class="text-muted">{{ 'Sin actividades' | trans }}</p>
                {% else %}
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>{{ 'Cantidad' | trans }}</th>
                                <th>{{ 'Unidad' | trans }}</th>
                                <th>{{ 'Emisiones (kg CO₂eq)' | trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in view[rowsKey] %}
                                <tr>
                                    <td>{{ row.quantity }}</td>
                                    <td>{{ row.unit }}</td>
                                    <td>{{ row.co2eq }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            {% endfor %}
        </twig:Card>
    {% endfor %}
{% endblock %}
