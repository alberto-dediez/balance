{% extends '@shared/layout/email.html.twig' %}

{% block content %}
    <h3>{% trans -%}Aporta tus datos de emisiones para el evento{%- endtrans %}</h3>
    <p>
        {% trans with {'{name}': contactName ?? companyName ?? ''} -%}
            Hola {name}, se te ha solicitado aportar los datos de emisiones de tu empresa para este evento (combustible, combustible de maquinaria, pernoctación y movilidad).
        {%- endtrans %}
    </p>
    <p>{% trans -%}Por favor, accede al siguiente enlace para completar los datos:{%- endtrans %}</p>
    <p>
        <a href="{{ url('public_carbon_footprint_contribution', {token: token}) }}" class="btn btn-primary">
            {% trans -%}Aportar datos{%- endtrans %}
        </a>
    </p>
{% endblock %}
