<div class="mb-3" data-legs-block="{{ prefix }}" data-legs-geo="{{ geoEnabled ? '1' : '0' }}">
    <p class="text-muted small">{{ chainHelp }}</p>

    <div class="mb-3">
        <label class="form-label d-block">{{ '¿Usaste más de un medio de transporte?' | trans }}</label>
        <div class="btn-group w-100" role="group">
            <input class="btn-check" type="radio" name="{{ prefix }}[multimodal]" id="{{ prefix }}_multimodal_yes" value="yes">
            <label class="btn btn-outline-primary" for="{{ prefix }}_multimodal_yes">{{ 'Sí' | trans }}</label>
            <input class="btn-check" type="radio" name="{{ prefix }}[multimodal]" id="{{ prefix }}_multimodal_no" value="no" checked>
            <label class="btn btn-outline-primary" for="{{ prefix }}_multimodal_no">{{ 'No' | trans }}</label>
        </div>
    </div>

    <div class="legs-collection">
        {% for index in 0..(maxLegs - 1) %}
            <div class="leg-row card card-body mb-2 {{ index > 0 ? 'd-none' : '' }}">
                <div class="mb-2">
                    <label class="form-label">{{ 'Medio de transporte' | trans }}</label>
                    <select class="form-select" name="{{ prefix }}[legs][{{ index }}][mobilityId]">
                        <option value="">{{ 'Selecciona un medio de transporte' | trans }}</option>
                        {% for mobility in mobilities %}
                            <option value="{{ mobility.id }}">{{ mobility.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-2">
                    <label class="form-label">{{ 'Ocupantes del vehículo' | trans }}</label>
                    <input type="number" min="1" step="1" inputmode="numeric" class="form-control"
                           name="{{ prefix }}[legs][{{ index }}][vehicleOccupants]" value="1">
                </div>

                <div class="mb-2 leg-destination d-none">
                    <label class="form-label">{{ '¿Hasta dónde llegaste en este medio?' | trans }}</label>
                    <input type="text"
                           class="form-control"
                           name="{{ prefix }}[legs][{{ index }}][destinationPlaceReference]"
                           data-controller="autocomplete"
                           data-autocomplete-path-value="{{ path('public_carbon_footprint_attendee_survey_places', {token: token, kind: destinationKind}) }}">
                </div>

                <details class="mb-2" {{ geoEnabled ? '' : 'open' }}>
                    <summary class="small text-muted">{{ 'No encuentro mi ubicación' | trans }}</summary>
                    <label class="form-label mt-2">{{ 'Distancia de este tramo, solo ida (km)' | trans }}</label>
                    <input type="number" min="0" step="0.1" inputmode="decimal" class="form-control"
                           name="{{ prefix }}[legs][{{ index }}][manualDistanceKm]">
                </details>
            </div>
        {% endfor %}
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm d-none" data-legs-add>{{ 'Añadir tramo' | trans }}</button>
        <button type="button" class="btn btn-outline-danger btn-sm d-none" data-legs-remove>{{ 'Quitar tramo' | trans }}</button>
    </div>
</div>
