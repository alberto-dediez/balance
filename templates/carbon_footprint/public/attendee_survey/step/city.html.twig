{% extends '@carbon_footprint/public/attendee_survey/layout.html.twig' %}

{% set page_title = 'Encuesta de movilidad' | trans %}
{% set survey_step = 2 %}

{% block survey_body %}
    <p class="text-muted">
        {{ 'Cuéntanos cómo te has movido dentro de la ciudad del evento.' | trans }}
    </p>

    <form method="post" name="city">
        <input type="hidden" name="_token" value="{{ csrf_token('attendee_survey_city_' ~ token) }}">

        <div class="mb-3">
            <label class="form-label d-block">{{ '¿Te desplazaste dentro de la ciudad del evento?' | trans }}</label>
            <div class="btn-group w-100" role="group" aria-label="{{ '¿Te desplazaste dentro de la ciudad del evento?' | trans }}">
                <input class="btn-check" type="radio" name="city[moved]" id="citymoved_yes" value="yes">
                <label class="btn btn-outline-primary" for="citymoved_yes">{{ 'Sí' | trans }}</label>
                <input class="btn-check" type="radio" name="city[moved]" id="citymoved_no" value="no" checked>
                <label class="btn btn-outline-primary" for="citymoved_no">{{ 'No' | trans }}</label>
            </div>
        </div>

        <div id="city-block">
            <div class="mb-3">
                <label class="form-label" for="city-origin">{{ '¿Desde dónde te desplazabas hasta el recinto?' | trans }}</label>
                <input id="city-origin"
                       type="text"
                       class="form-control"
                       name="city[originPlaceReference]"
                       value="{{ accommodationPlaceReference|default('') }}"
                       data-controller="autocomplete"
                       data-autocomplete-selected-label-value="{{ accommodationLabel|default('') }}"
                       data-autocomplete-path-value="{{ path('public_carbon_footprint_attendee_survey_places', {token: token, kind: 'any'}) }}">
            </div>

            {% include '@carbon_footprint/public/trip/_legs.html.twig' with {
                prefix: 'city',
                chainHelp: 'Indica el medio de transporte con el que llegabas al recinto. Si combinabas varios, dinos dónde cambiabas.' | trans,
                mobilities: mobilities,
                placesPath: path('public_carbon_footprint_attendee_survey_places', {token: token, kind: 'any'}),
                maxLegs: maxLegs,
                geoEnabled: geoEnabled,
            } only %}

            <div class="mb-3">
                <label class="form-label d-block">{{ '¿Cada desplazamiento fue de ida y vuelta?' | trans }}</label>
                <div class="btn-group w-100" role="group">
                    <input class="btn-check" type="radio" name="city[roundTrip]" id="city_roundtrip_yes" value="yes" checked>
                    <label class="btn btn-outline-primary" for="city_roundtrip_yes">{{ 'Ida y vuelta' | trans }}</label>
                    <input class="btn-check" type="radio" name="city[roundTrip]" id="city_roundtrip_no" value="no">
                    <label class="btn btn-outline-primary" for="city_roundtrip_no">{{ 'Solo ida' | trans }}</label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">{{ '¿Cuántas veces te desplazaste hasta el recinto?' | trans }}</label>
                <input type="number" min="1" step="1" inputmode="numeric" class="form-control" name="city[trips]" value="1">
            </div>
        </div>

        <div class="d-flex flex-column-reverse flex-md-row justify-content-md-between gap-2 mt-4">
            <a href="{{ path('public_carbon_footprint_attendee_survey_intercity', {token: token}) }}" class="btn btn-outline-primary">
                &larr; {{ 'Anterior' | trans }}
            </a>
            <button type="submit" class="btn btn-primary">{{ 'Enviar respuesta' | trans }}</button>
        </div>
    </form>

    {% include '@carbon_footprint/public/trip/_legs_script.html.twig' %}

    <script>
        (function () {
            var movedRadios = document.querySelectorAll('input[name="city[moved]"]');
            var cityBlock = document.getElementById('city-block');

            function toggle() {
                var checked = document.querySelector('input[name="city[moved]"]:checked');

                cityBlock.style.display = checked && checked.value === 'yes' ? '' : 'none';
            }

            movedRadios.forEach(function (radio) {
                radio.addEventListener('change', toggle);
            });

            toggle();
        })();
    </script>
{% endblock %}
