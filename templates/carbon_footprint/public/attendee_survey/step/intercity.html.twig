{% extends theme_template('@carbon_footprint/public/attendee_survey/layout.html.twig') %}

{% set page_title = 'Encuesta de movilidad' | trans %}
{% set survey_step = 1 %}

{% block card_body %}
    <p class="text-muted">
        {{ 'Ayúdanos a calcular la huella de carbono de este evento respondiendo unas breves preguntas sobre tu movilidad.' | trans }}
    </p>

    <form method="post" name="intercity">
        <input type="hidden" name="_token" value="{{ csrf_token('attendee_survey_intercity_' ~ token) }}">

        <div class="mb-3">
            <label class="form-label d-block">{{ '¿Asistes desde otra ciudad?' | trans }}</label>
            <div class="btn-group w-100" role="group" aria-label="{{ '¿Asistes desde otra ciudad?' | trans }}">
                <input class="btn-check" type="radio" name="intercity[cameFromAnotherCity]" id="camefromanothercity_yes" value="yes" {{ stored.cameFromAnotherCity is defined and stored.cameFromAnotherCity ? 'checked' : '' }}>
                <label class="btn btn-outline-primary" for="camefromanothercity_yes">{{ 'Sí' | trans }}</label>
                <input class="btn-check" type="radio" name="intercity[cameFromAnotherCity]" id="camefromanothercity_no" value="no" {{ stored.cameFromAnotherCity is defined and not stored.cameFromAnotherCity ? 'checked' : '' }}>
                <label class="btn btn-outline-primary" for="camefromanothercity_no">{{ 'No' | trans }}</label>
            </div>
        </div>

        <div id="intercity-block">
            <div class="mb-3">
                <label class="form-label" for="intercity-origin">{{ '¿Desde dónde viajaste al evento?' | trans }}</label>
                <input id="intercity-origin"
                       type="text"
                       class="form-control"
                       name="intercity[originPlaceReference]"
                       value="{{ stored.originPlaceReference|default('') }}"
                       data-controller="autocomplete"
                       data-autocomplete-path-value="{{ path('public_carbon_footprint_attendee_survey_places', {token: token, kind: 'city'}) }}">
            </div>

            {% include '@carbon_footprint/public/trip/_legs.html.twig' with {
                prefix: 'intercity',
                chainHelp: 'Indica el medio de transporte de tu viaje. Si cambiaste de medio por el camino, dinos dónde lo hiciste.' | trans,
                mobilities: mobilities,
                placesPath: path('public_carbon_footprint_attendee_survey_places', {token: token, kind: 'city'}),
                maxLegs: maxLegs,
                geoEnabled: geoEnabled,
            } only %}

            <div class="mb-3">
                <label class="form-label d-block">{{ '¿Fue un viaje de ida y vuelta?' | trans }}</label>
                <div class="btn-group w-100" role="group">
                    <input class="btn-check" type="radio" name="intercity[roundTrip]" id="intercity_roundtrip_yes" value="yes" {{ stored.intercityRoundTrip is defined and stored.intercityRoundTrip ? 'checked' : '' }}>
                    <label class="btn btn-outline-primary" for="intercity_roundtrip_yes">{{ 'Ida y vuelta' | trans }}</label>
                    <input class="btn-check" type="radio" name="intercity[roundTrip]" id="intercity_roundtrip_no" value="no" {{ stored.intercityRoundTrip is defined and not stored.intercityRoundTrip ? 'checked' : '' }}>
                    <label class="btn btn-outline-primary" for="intercity_roundtrip_no">{{ 'Solo ida' | trans }}</label>
                </div>
            </div>
        </div>

        <div class="mb-3" id="hotel-question-block">
            <label class="form-label d-block">{{ '¿Te alojaste en la ciudad del evento?' | trans }}</label>
            <div class="btn-group w-100" role="group" aria-label="{{ '¿Te alojaste en la ciudad del evento?' | trans }}">
                <input class="btn-check" type="radio" name="intercity[usedHotel]" id="usedhotel_yes" value="yes" {{ stored.usedHotel is defined and stored.usedHotel ? 'checked' : '' }}>
                <label class="btn btn-outline-primary" for="usedhotel_yes">{{ 'Sí' | trans }}</label>
                <input class="btn-check" type="radio" name="intercity[usedHotel]" id="usedhotel_no" value="no" {{ stored.usedHotel is defined and not stored.usedHotel ? 'checked' : '' }}>
                <label class="btn btn-outline-primary" for="usedhotel_no">{{ 'No' | trans }}</label>
            </div>
        </div>

        <div class="mb-3" id="intercity-trips-block">
            <label class="form-label">{{ '¿Cuántas veces hiciste este viaje?' | trans }}</label>
            <input type="number" min="1" step="1" inputmode="numeric" class="form-control" name="intercity[trips]" value="{{ stored.intercityTrips|default(1) }}">
        </div>

        <div id="hotel-block">
            <div class="mb-3">
                <label class="form-label" for="intercity-accommodation">{{ '¿Dónde te alojaste?' | trans }}</label>
                <input id="intercity-accommodation"
                       type="text"
                       class="form-control"
                       name="intercity[accommodationPlaceReference]"
                       value="{{ stored.accommodationPlaceReference|default('') }}"
                       data-controller="autocomplete"
                       data-autocomplete-selected-label-value="{{ stored.accommodationLabel|default('') }}"
                       data-autocomplete-path-value="{{ path('public_carbon_footprint_attendee_survey_places', {token: token, kind: 'lodging'}) }}">
                <input type="hidden" name="intercity[accommodationLabel]" id="intercity-accommodation-label" value="{{ stored.accommodationLabel|default('') }}">
            </div>

            <div class="mb-3">
                <label class="form-label">{{ 'Nº de noches' | trans }}</label>
                <input type="number" min="1" step="1" inputmode="numeric" class="form-control" name="intercity[hotelNights]" value="{{ stored.hotelNights|default('') }}">
            </div>
        </div>

        <div class="d-grid d-md-flex justify-content-md-end mt-4">
            <button type="submit" class="btn btn-primary">{{ 'Continuar' | trans }} &rarr;</button>
        </div>
    </form>

    {% include '@carbon_footprint/public/trip/_legs_script.html.twig' %}

    <script>
        (function () {
            var intercityRadios = document.querySelectorAll('input[name="intercity[cameFromAnotherCity]"]');
            var intercityBlock = document.getElementById('intercity-block');
            var hotelRadios = document.querySelectorAll('input[name="intercity[usedHotel]"]');
            var hotelBlock = document.getElementById('hotel-block');
            var hotelQuestionBlock = document.getElementById('hotel-question-block');
            var tripsBlock = document.getElementById('intercity-trips-block');
            var accommodationInput = document.getElementById('intercity-accommodation');
            var accommodationLabel = document.getElementById('intercity-accommodation-label');

            function isYes(radios) {
                var checked = document.querySelector('input[name="' + radios[0].name + '"]:checked');

                return checked !== null && checked.value === 'yes';
            }

            function isNo(radios) {
                var checked = document.querySelector('input[name="' + radios[0].name + '"]:checked');

                return checked !== null && checked.value === 'no';
            }

            function refresh() {
                var fromAnotherCity = isYes(intercityRadios);

                intercityBlock.style.display = fromAnotherCity ? '' : 'none';
                hotelQuestionBlock.style.display = fromAnotherCity ? '' : 'none';
                hotelBlock.style.display = fromAnotherCity && isYes(hotelRadios) ? '' : 'none';
                tripsBlock.style.display = fromAnotherCity && isNo(hotelRadios) ? 'block' : 'none';
            }

            intercityRadios.forEach(function (radio) {
                radio.addEventListener('change', refresh);
            });
            hotelRadios.forEach(function (radio) {
                radio.addEventListener('change', refresh);
            });

            accommodationInput.addEventListener('change', function () {
                var control = accommodationInput.tomselect;
                var selected = control ? control.options[control.getValue()] : null;

                accommodationLabel.value = selected ? selected.label : accommodationInput.value;
            });

            refresh();
        })();
    </script>
{% endblock %}
