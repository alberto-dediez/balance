{#
    Variables expected: token, attendeeSurveyResponse, hasContributionOptions
#}
{% if hasContributionOptions %}
    <div class="border-top pt-4 mt-4 text-center">
        <h6 class="fw-semibold mb-2">{{ 'Compensa tu huella' | trans }}</h6>
        <p class="text-muted small">
            {{ 'Puedes contribuir a uno de los proyectos ambientales y sociales de este evento.' | trans }}
        </p>
        <a class="btn btn-success"
           href="{{ path('public_carbon_footprint_attendee_survey_contribution_choose', {
               token: token,
               responseId: attendeeSurveyResponse.id,
           }) }}">
            <twig:Icon name="solar:hand-heart-bold" class="me-1" />
            {{ 'Compensar mi huella' | trans }}
        </a>
    </div>
{% endif %}
