{% extends theme_template('@carbon_footprint/public/attendee_survey/layout.html.twig') %}

{% set page_title = 'Tu huella de carbono' | trans %}

{% block card_body %}
    <div class="text-center mb-4">
        <twig:Icon name="solar:leaf-bold" size="xl" class="text-success mb-3" />
        <h3 class="text-success mb-1">{{ attendeeSurveyResponse.emissions.co2eq | number_format(2, ',', '.') }} {{ 'kg CO₂eq' | trans }}</h3>
        <p class="text-muted mb-0">{{ 'Esta es la huella de carbono de tu asistencia al evento.' | trans }}</p>
        {% if attendeeSurveyResponse.emissions.co2eq - emissionsPerPerson.co2eq > 0.005 %}
            <p class="text-muted small mb-0 mt-2">
                {{ 'Equivale a {emissions} kg CO₂eq por persona.' | trans({'{emissions}': emissionsPerPerson.co2eq | number_format(2, ',', '.')}) }}
            </p>
        {% endif %}
    </div>

    <table class="table table-sm mb-4">
        <tbody>
            <tr>
                <th scope="row" class="fw-normal">{{ 'Desplazamientos' | trans }}</th>
                <td class="text-end text-nowrap">{{ attendeeSurveyResponse.mobilityEmissions.co2eq | number_format(2, ',', '.') }} {{ 'kg CO₂eq' | trans }}</td>
            </tr>
            <tr>
                <th scope="row" class="fw-normal">{{ 'Pernoctaciones' | trans }}</th>
                <td class="text-end text-nowrap">{{ attendeeSurveyResponse.overnightEmissions.co2eq | number_format(2, ',', '.') }} {{ 'kg CO₂eq' | trans }}</td>
            </tr>
        </tbody>
    </table>

    {% if attendeeSurveyResponse.legs is not empty %}
        <h6 class="text-muted">{{ 'Tramos de tu viaje' | trans }}</h6>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th scope="col">{{ 'Medio de transporte' | trans }}</th>
                    <th scope="col" class="text-end">{{ 'Distancia (km)' | trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for leg in attendeeSurveyResponse.legs %}
                    <tr>
                        <td>{{ mobilityNames[leg.mobilityId] | default('—') }}</td>
                        <td class="text-end text-nowrap">{{ leg.distanceKm ? leg.distanceKm | number_format(2, ',', '.') : '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if attendeeSurveyResponse.hotelNights %}
        <p class="text-muted small mb-0">
            {{ 'Noches declaradas: {nights} · Personas alojadas: {people}' | trans({'{nights}': attendeeSurveyResponse.hotelNights, '{people}': attendeeSurveyResponse.hotelPeople ?? 1}) }}
        </p>
    {% endif %}

    {{ include(theme_template('@carbon_footprint/public/_compensate_cta.html.twig'), {
        contribution_path: path('public_carbon_footprint_attendee_survey_contribution_choose', {
            token: token,
            responseId: attendeeSurveyResponse.id,
        }),
        contribution_text: 'Puedes contribuir a uno de los proyectos ambientales y sociales de este evento.' | trans,
    }) }}
{% endblock %}
