{% extends '@shared/layout/public.html.twig' %}

{% set page_title = 'Encuesta cerrada' | trans %}

{% block page_header %}{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5 text-center">
            <div class="card">
                <div class="card-body py-5 px-4">
                    <twig:Icon name="solar:lock-keyhole-minimalistic-line-duotone" size="xl" class="text-warning mb-3" />
                    <h3 class="text-warning">{{ 'Esta encuesta ya se ha cerrado' | trans }}</h3>
                    <p class="text-muted mt-3 mb-0">
                        {{ 'Gracias por tu interés. La encuesta de movilidad de este evento ya no admite más respuestas.' | trans }}
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
