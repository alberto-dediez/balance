{% extends theme_template(routes.layout) %}

{% set page_title = 'Participar en el concurso' | trans %}

{% block card_body %}
    <h5 class="mb-1">{{ contest.name }}</h5>
    <p class="text-muted small mb-3">{{ 'Premio: {prize}' | trans({'{prize}': contest.prizeDescription}) }}</p>

    {% if contestPrizesExhausted %}
        <twig:Alert:Alert type="warning">{{ 'Los {n} premios de este concurso ya se han adjudicado. Puedes apuntarte, pero sin premio.' | trans({'{n}': contest.winnersCount}) }}</twig:Alert:Alert>
    {% endif %}

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.phone) }}
        {{ form_row(form.country) }}

        {% if form.adultConfirmed is defined %}
            {{ form_row(form.adultConfirmed) }}
        {% endif %}

        {{ form_row(form.consent) }}

        {{ include(theme_template('@carbon_footprint/public/contest/_organizer.html.twig')) }}

        <div class="mt-3">
            {{ form_widget(form.enter, {attr: {class: 'btn btn-primary'}}) }}
        </div>
    {{ form_end(form) }}

    <div class="text-center mt-4">
        <a class="btn btn-link btn-sm text-muted" href="{{ path(routes.result, routes.resultRouteParams) }}">
            {{ 'Volver al resultado' | trans }}
        </a>
    </div>
{% endblock %}
