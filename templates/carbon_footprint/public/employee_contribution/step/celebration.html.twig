{% extends '@carbon_footprint/public/employee_contribution/layout.html.twig' %}

{% set page_title = 'Contribución de empleado - Celebración' | trans %}
{% set wizard_selected = 2 %}

{% block wizard_panels %}
    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0">{{ event.name }}</h5></div>
        <div class="card-body">
            <p class="text-muted mb-0">
                {{ 'Cuéntanos cómo te has movido y dónde has pernoctado durante la fase de celebración.' | trans }}
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h5 class="mb-0">{{ 'Celebración' | trans }}</h5></div>
        <div class="card-body">
            <form method="post" name="celebration">
                <input type="hidden" name="_token" value="{{ csrf_token('employee_contribution_celebration_' ~ token) }}">

                <div class="form-check form-switch mb-3">
                    <input type="checkbox" class="form-check-input" id="worked" name="worked" value="1" {{ employeeContribution.workedCelebration ? 'checked' : '' }}>
                    <label class="form-check-label" for="worked">{{ '¿Trabajaste en esta fase?' | trans }}</label>
                </div>

                <div data-controller="showable" data-showable-selector-value="#worked" data-showable-condition-value="1" class="{{ employeeContribution.workedCelebration ? '' : 'd-none' }}">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">{{ 'Medio de transporte' | trans }}</label>
                            <select class="form-select" name="mobilityId">
                                <option value="">{{ 'Selecciona un medio de transporte' | trans }}</option>
                                {% for mobility in mobilities %}
                                    <option value="{{ mobility.id }}" {{ employeeContribution.celebrationMobilityId is not null and (employeeContribution.celebrationMobilityId ~ '') == (mobility.id ~ '') ? 'selected' : '' }}>{{ mobility.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">{{ 'Km por trayecto/día' | trans }}</label>
                            <input type="number" min="0" step="0.1" inputmode="decimal" class="form-control" name="distanceKm" value="{{ employeeContribution.celebrationDistanceKm }}">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">{{ 'Ocupantes del vehículo' | trans }}</label>
                            <input type="number" min="1" step="1" inputmode="numeric" class="form-control" name="vehicleOccupants" value="{{ employeeContribution.celebrationVehicleOccupants }}">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">{{ 'Días' | trans }}</label>
                            <input type="number" min="1" step="1" inputmode="numeric" class="form-control" name="days" value="{{ employeeContribution.celebrationDays }}">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">{{ 'Noches de hotel' | trans }}</label>
                            <input type="number" min="0" step="1" inputmode="numeric" class="form-control" name="hotelNights" value="{{ employeeContribution.celebrationHotelNights }}">
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('public_carbon_footprint_employee_contribution_assembly', {token: token}) }}" class="btn btn-outline-primary">
                        &larr; {{ 'Anterior' | trans }}
                    </a>
                    <button type="submit" class="btn btn-primary">{{ 'Siguiente' | trans }} &rarr;</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
