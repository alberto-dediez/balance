{% extends '@carbon_footprint/public/contribution/layout.html.twig' %}

{% set page_title = 'Contribución de proveedor - Desmontaje' | trans %}
{% set wizard_selected = 4 %}

{% block wizard_panels %}
    {% set worked = hasActivities
        ? 'yes'
        : (providerContribution.stepStatus.isCompleted
            ? 'no'
            : (providerContribution.workersBreakdown is null
                ? null
                : (providerContribution.workersBreakdown > 0 ? 'yes' : 'no'))) %}

    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('contribution_breakdown_' ~ token) }}">

        {% include '@carbon_footprint/public/contribution/step/_worked_question.html.twig' with {question: '¿Tu empresa trabajó durante el desmontaje?' | trans, worked: worked} only %}

        <div id="worked-activities">
        <twig:CarbonFootprint:CombustibleActivityTable
            title="{{ 'Combustible (instalaciones fijas, calderas, motores estacionarios, etc)' | trans }}"
            prefix="combustibles"
            :rows="combustibleRows"
            :items="combustibles"
            :units="units"
            calculateUrl="{{ path('public_carbon_footprint_contribution_emissions_calculate', {token: token}) }}"
        />

        <twig:CarbonFootprint:MachineryFuelActivityTable
            title="{{ 'Combustible de maquinaria' | trans }}"
            prefix="machineryFuels"
            :rows="machineryFuelRows"
            :items="machineryFuels"
            :units="units"
            calculateUrl="{{ path('public_carbon_footprint_contribution_emissions_calculate', {token: token}) }}"
        />

        <twig:CarbonFootprint:OvernightStayActivityTable
            title="{{ 'Pernoctación' | trans }}"
            prefix="overnightStays"
            :rows="overnightStayRows"
            :items="overnightStays"
            :units="units"
            calculateUrl="{{ path('public_carbon_footprint_contribution_emissions_calculate', {token: token}) }}"
        />

        <twig:CarbonFootprint:MobilityActivityTable
            title="{{ 'Movilidad (proveedores y equipo)' | trans }}"
            prefix="mobilities"
            :rows="mobilityRows"
            :items="mobilities"
            :units="units"
            calculateUrl="{{ path('public_carbon_footprint_contribution_emissions_calculate', {token: token}) }}"
        />
        </div>

        {% include '@carbon_footprint/public/contribution/step/_worked_note.html.twig' %}

        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('public_carbon_footprint_contribution_celebration', {token: token}) }}" class="btn btn-outline-primary">
                &larr; {{ 'Anterior' | trans }}
            </a>
            <button type="submit" class="btn btn-primary">{{ 'Enviar' | trans }} &rarr;</button>
        </div>
    </form>
{% endblock %}
