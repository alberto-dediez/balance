<p class="text-muted">
    {{ 'Indícanos primero si tu empresa trabajó en esta fase del evento. Solo si es así te pediremos el detalle de actividades.' | trans }}
</p>

<div class="col-12 col-md-4 col-lg-3 mb-3">
    <label class="form-label d-block">{{ question }}</label>
    <div class="btn-group w-100" role="group" aria-label="{{ question }}">
        <input class="btn-check" type="radio" name="worked" id="worked_yes" value="yes" required {{ worked == 'yes' ? 'checked' : '' }}>
        <label class="btn btn-outline-primary" for="worked_yes">{{ 'Sí' | trans }}</label>
        <input class="btn-check" type="radio" name="worked" id="worked_no" value="no" {{ worked == 'no' ? 'checked' : '' }}>
        <label class="btn btn-outline-primary" for="worked_no">{{ 'No' | trans }}</label>
    </div>
</div>
