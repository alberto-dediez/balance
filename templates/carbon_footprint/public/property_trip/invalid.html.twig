{% extends '@shared/layout/public.html.twig' %}

{% set page_title = 'Enlace inválido' | trans %}

{% block page_header %}{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5 text-center">
            <div class="card">
                <div class="card-body py-5 px-4">
                    <twig:Icon name="solar:close-circle-line-duotone" size="xl" class="text-danger mb-3" />
                    <h3 class="text-danger">{{ 'Este enlace no es válido' | trans }}</h3>
                    <p class="text-muted mt-3 mb-0">
                        {{ 'El enlace de la calculadora que has utilizado no es válido o ya no está disponible.' | trans }}
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
