{% extends '@carbon_footprint/property_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 3 %}

{% block top_actions %}
    {{ parent() }}
{% endblock %}

{% block wizard_panels %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('scope_3_' ~ propertyCarbonFootprint.id) }}">

        {% include '@carbon_footprint/organizational_carbon_footprints/_scope_3_sections.html.twig' %}

        <div class="d-flex justify-content-between mt-3">
            <a href="{{ path('property_carbon_footprints_scope_2', {propertyCarbonFootprintId: propertyCarbonFootprintId}) }}" class="btn btn-outline-primary">
                &larr; {{ 'Anterior' | trans }}
            </a>
            {% if not readOnly %}
                <button type="submit" class="btn btn-primary">
                    {{ 'Siguiente' | trans }} &rarr;
                </button>
            {% endif %}
        </div>
    </form>
{% endblock %}
