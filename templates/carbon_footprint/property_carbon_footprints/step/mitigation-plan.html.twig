{% extends '@carbon_footprint/property_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = propertyCarbonFootprint.scope3Excluded ? 4 : 5 %}

{% block top_actions %}
    {{ parent() }}
    {% if not readOnly %}
        <twig:TopAction path="{{ path('mitigation_actions_register', {subjectType: subjectType, carbonFootprintId: propertyCarbonFootprintId}) }}">
            <twig:Icon name="solar:add-square-line-duotone" size="lg" class="me-2" />

            {{ 'Añadir medida al plan' | trans }}
        </twig:TopAction>

        {% if hasPreviousFootprint %}
            <twig:TopAction:ImportMitigationActions path="{{ path('mitigation_actions_import', {subjectType: subjectType, carbonFootprintId: propertyCarbonFootprintId, _token: csrf_token('mitigation_actions_import')}) }}" />
        {% endif %}
    {% endif %}
{% endblock %}

{% block wizard_panels %}
    {% include '@carbon_footprint/organizational_carbon_footprints/_mitigation_plan.html.twig' with {
        carbonFootprint: propertyCarbonFootprint,
        previousPath: path(propertyCarbonFootprint.scope3Excluded ? 'property_carbon_footprints_scope_3' : 'property_carbon_footprints_providers', {propertyCarbonFootprintId: propertyCarbonFootprintId}),
    } %}
{% endblock %}
