{% extends '@carbon_footprint/property_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 1 %}

{% block wizard_panels %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('scope_1_' ~ propertyCarbonFootprint.id) }}">

        {% include '@carbon_footprint/organizational_carbon_footprints/_scope_1_sections.html.twig' %}

        <div class="d-flex justify-content-between mt-3">
            <span></span>
            <button type="submit" class="btn btn-primary">
                {{ 'Siguiente' | trans }} &rarr;
            </button>
        </div>
    </form>
{% endblock %}
