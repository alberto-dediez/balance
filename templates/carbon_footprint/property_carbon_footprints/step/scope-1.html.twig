{% extends '@carbon_footprint/property_carbon_footprints/wizard-layout.html.twig' %}

{% set wizard_selected = 1 %}

{% block top_actions %}
    {{ parent() }}
    {% if not readOnly %}
        <twig:TopAction:BioscoreConsumptions path="{{ path('property_carbon_footprints_bioscore_load', {propertyCarbonFootprintId: propertyCarbonFootprintId, scope: 'scope_1', _token: csrf_token('bioscore_load_' ~ propertyCarbonFootprint.id)}) }}" />
    {% endif %}
{% endblock %}

{% block wizard_panels %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('scope_1_' ~ propertyCarbonFootprint.id) }}">

        {% include '@carbon_footprint/organizational_carbon_footprints/_scope_1_sections.html.twig' %}

        <div class="d-flex justify-content-between mt-3">
            <span></span>
            {% if not readOnly %}
                <button type="submit" class="btn btn-primary">
                    {{ 'Siguiente' | trans }} &rarr;
                </button>
            {% endif %}
        </div>
    </form>
{% endblock %}
