{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Panel de control' | trans %}

{% block content %}
    {% if dashboard.totalAccounts == 0 %}
        <div class="card">
            <div class="card-body text-center py-5">
                <twig:Icon name="solar:buildings-2-line-duotone" size="xl" class="text-muted" />
                <h5 class="mt-3">{{ 'Aún no hay datos que mostrar' | trans }}</h5>
                <p class="text-muted mb-4">{{ 'Cuando las cuentas registren eventos y calculen sus huellas de carbono, aquí verás las estadísticas globales de la plataforma.' | trans }}</p>
                <a href="{{ path('admin_accounts') }}" class="btn btn-primary">{{ 'Gestionar cuentas' | trans }}</a>
            </div>
        </div>
    {% else %}
        {% set completionPercent = dashboard.totalFootprints > 0 ? (dashboard.completedFootprints * 100 / dashboard.totalFootprints) | round : 0 %}
        {% set totalInTonnes = dashboard.totalEmissionsCo2eq >= 1000 %}

        <div class="row">
            <div class="col-sm-6 col-xl-3 d-flex">
                <div class="card flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-muted fw-normal mb-1">{{ 'Cuentas' | trans }}</h6>
                                <h3 class="fw-semibold mb-0">{{ dashboard.totalAccounts }} <small class="fs-4 text-muted">/ {{ dashboard.activeAccounts }} {{ 'activas' | trans }}</small></h3>
                            </div>
                            <span class="p-2 bg-primary-subtle rounded d-flex">
                                <twig:Icon name="solar:buildings-2-line-duotone" size="lg" class="text-primary" />
                            </span>
                        </div>
                        <small class="text-muted">{{ dashboard.totalUsers }} {{ 'usuarios registrados' | trans }}</small>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3 d-flex">
                <div class="card flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-muted fw-normal mb-1">{{ 'Eventos' | trans }}</h6>
                                <h3 class="fw-semibold mb-0">{{ dashboard.totalEvents }}</h3>
                            </div>
                            <span class="p-2 bg-info-subtle rounded d-flex">
                                <twig:Icon name="ic:twotone-event-available" size="lg" class="text-info" />
                            </span>
                        </div>
                        <small class="text-muted">{{ dashboard.eventsThisYear }} {{ 'este año' | trans }}</small>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3 d-flex">
                <div class="card flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-muted fw-normal mb-1">{{ 'Huellas completadas' | trans }}</h6>
                                <h3 class="fw-semibold mb-0">{{ dashboard.completedFootprints }} <small class="fs-4 text-muted">/ {{ dashboard.totalFootprints }}</small></h3>
                            </div>
                            <span class="p-2 bg-success-subtle rounded d-flex">
                                <twig:Icon name="solar:leaf-line-duotone" size="lg" class="text-success" />
                            </span>
                        </div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: {{ completionPercent }}%" aria-valuenow="{{ completionPercent }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted">{{ dashboard.inProgressFootprints }} {{ 'en curso' | trans }}</small>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3 d-flex">
                <div class="card flex-fill">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="text-muted fw-normal mb-1">{{ 'Emisiones totales' | trans }}</h6>
                                <h3 class="fw-semibold mb-0">
                                    {{ totalInTonnes
                                        ? (dashboard.totalEmissionsCo2eq / 1000) | number_format(2, ',', '.')
                                        : dashboard.totalEmissionsCo2eq | number_format(0, ',', '.') }}
                                    <small class="fs-4 text-muted">{{ totalInTonnes ? 't CO₂eq' : 'kg CO₂eq' }}</small>
                                </h3>
                            </div>
                            <span class="p-2 bg-warning-subtle rounded d-flex">
                                <twig:Icon name="carbon:sustainability" size="lg" class="text-warning" />
                            </span>
                        </div>
                        <small class="text-muted">{{ 'Media por evento' | trans }}: {{ dashboard.averageEmissionsPerEventCo2eq | number_format(0, ',', '.') }} kg</small>
                    </div>
                </div>
            </div>
        </div>

        {{ include('@carbon_footprint/dashboard/_compensations.html.twig') }}

        {{ include('@carbon_footprint/dashboard/_forms.html.twig') }}

        <div class="row">
            <div class="col-lg-8 d-flex">
                <div class="card flex-fill">
                    <div class="card-header fw-semibold">{{ 'Emisiones por año' | trans }} <span class="text-muted fw-normal">(kg CO₂eq)</span></div>
                    <div class="card-body">
                        {% if emissionsYearValues is not empty %}
                            <twig:Chart:Bar
                                title="{{ 'Emisiones' | trans }}"
                                :values="emissionsYearValues"
                                :categories="emissionsYearCategories"
                                :colors="['var(--bs-primary)']"
                                unit="kg"
                                :decimals="0"
                            />
                        {% else %}
                            <p class="text-muted mb-0">{{ 'Todavía no hay huellas de carbono completadas.' | trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-lg-4 d-flex">
                <div class="card flex-fill">
                    <div class="card-header fw-semibold">{{ 'Emisiones por fase' | trans }}</div>
                    <div class="card-body">
                        {% if phaseValues is not empty %}
                            <twig:Chart:Donut
                                title="{{ 'Emisiones por fase' | trans }}"
                                :values="phaseValues"
                                :categories="phaseCategories"
                                unit="kg"
                                :decimals="0"
                                :legend="true"
                            />
                        {% else %}
                            <p class="text-muted mb-0">{{ 'Todavía no hay actividades registradas.' | trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-7 d-flex">
                <div class="card flex-fill">
                    <div class="card-header fw-semibold">{{ 'Cuentas con más emisiones' | trans }} <span class="text-muted fw-normal">(kg CO₂eq)</span></div>
                    <div class="card-body">
                        {% if topAccountValues is not empty %}
                            <twig:Chart:Bar
                                title="{{ 'Emisiones' | trans }}"
                                :values="topAccountValues"
                                :categories="topAccountCategories"
                                :colors="['var(--bs-secondary)']"
                                unit="kg"
                                :decimals="0"
                            />
                        {% else %}
                            <p class="text-muted mb-0">{{ 'Todavía no hay huellas de carbono completadas.' | trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-lg-5 d-flex">
                <div class="card flex-fill">
                    <div class="card-header fw-semibold">{{ 'Emisiones por fuente' | trans }} <span class="text-muted fw-normal">(kg CO₂eq)</span></div>
                    <div class="card-body">
                        {% if sourceValues is not empty %}
                            <twig:Chart:Bar
                                title="{{ 'Emisiones' | trans }}"
                                :values="sourceValues"
                                :categories="sourceCategories"
                                :colors="['var(--bs-info)']"
                                unit="kg"
                                :decimals="0"
                            />
                        {% else %}
                            <p class="text-muted mb-0">{{ 'Todavía no hay actividades registradas.' | trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 d-flex">
                <div class="card flex-fill">
                    <div class="card-header fw-semibold">{{ 'Últimas huellas de carbono' | trans }}</div>
                    <div class="card-body">
                        {% if dashboard.latestFootprints is not empty %}
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>{{ 'Cuenta' | trans }}</th>
                                            <th>{{ 'Evento' | trans }}</th>
                                            <th>{{ 'Año' | trans }}</th>
                                            <th>{{ 'Estado' | trans }}</th>
                                            <th class="text-end">{{ 'Emisiones (kg CO₂eq)' | trans }}</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for overview in dashboard.latestFootprints %}
                                            {% set footprint = overview.eventCarbonFootprint %}
                                            <tr>
                                                <td>{{ overview.account ? overview.account.name : '—' }}</td>
                                                <td>{{ overview.event ? overview.event.name : '—' }}</td>
                                                <td>{{ footprint.calculationYear }}</td>
                                                <td>
                                                    {% set badgeClass = footprint.status.isCompleted
                                                        ? 'text-bg-success'
                                                        : (footprint.status.value == 'started' ? 'text-bg-secondary' : 'text-bg-warning') %}
                                                    <span class="badge {{ badgeClass }}">{{ footprint.status.value | trans({}, 'eventCarbonFootprintStatusType') }}</span>
                                                </td>
                                                <td class="text-end">{{ footprint.status.isCompleted ? footprint.totalEmissions.co2eq | number_format(0, ',', '.') : '—' }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p class="text-muted mb-0">{{ 'Todavía no se ha calculado ninguna huella de carbono en la plataforma.' | trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-lg-4 d-flex">
                <div class="card flex-fill">
                    <div class="card-header fw-semibold">{{ 'Eventos por tipología' | trans }}</div>
                    <div class="card-body">
                        {% if typologyValues is not empty %}
                            <twig:Chart:Donut
                                title="{{ 'Eventos' | trans }}"
                                :values="typologyValues"
                                :categories="typologyCategories"
                                :decimals="0"
                                :labelDecimals="0"
                                :legend="true"
                            />
                        {% else %}
                            <p class="text-muted mb-0">{{ 'Todavía no hay eventos con tipología indicada.' | trans }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
