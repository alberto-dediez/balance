{% set organizational = dashboard.organizational %}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h5 class="fw-semibold mb-0">{{ 'Huella organizacional' | trans }}</h5>
    <a class="btn btn-sm btn-light" href="{{ path('property_carbon_footprint_kpis') }}">
        <twig:Icon name="solar:chart-square-line-duotone" class="me-1" />
        {{ 'Ver indicadores' | trans }}
    </a>
</div>

{% if organizational.totalFootprints == 0 %}
    <div class="card">
        <div class="card-body text-center py-5">
            <twig:Icon name="solar:buildings-2-line-duotone" size="xl" class="text-muted" />
            <h5 class="mt-3">{{ 'Aún no hay huellas organizacionales' | trans }}</h5>
            <p class="text-muted mb-4">{{ 'Calcula la huella de carbono de tus propiedades para ver estadísticas.' | trans }}</p>
            <a class="btn btn-primary" href="{{ path('property_carbon_footprints') }}">{{ 'Ir a huellas de carbono' | trans }}</a>
        </div>
    </div>
{% else %}
    {% set organizationalCompletionPercent = (organizational.completedFootprints * 100 / organizational.totalFootprints) | round %}
    {% set emissionsLabel = organizational.referenceYear is not null
        ? ('Emisiones {year}' | trans({'{year}': organizational.referenceYear ~ ''}))
        : ('Emisiones' | trans) %}
    {% set scopesFooter = [
        ('scope_1' | trans({}, 'scope')) ~ ': ' ~ ((organizational.referenceYearByScopeKg['scope_1'] ?? 0) / 1000) | number_format(2, ',', '.'),
        ('scope_2' | trans({}, 'scope')) ~ ': ' ~ ((organizational.referenceYearByScopeKg['scope_2'] ?? 0) / 1000) | number_format(2, ',', '.'),
        ('scope_3' | trans({}, 'scope')) ~ ': ' ~ ((organizational.referenceYearByScopeKg['scope_3'] ?? 0) / 1000) | number_format(2, ',', '.'),
    ] | join(' · ') %}
    {% set mitigationFooter = organizational.footprintsWithMitigationPlan ~ ' ' ~ ('con plan de mitigación' | trans) %}
    {% set variation = organizational.variationVsPreviousYearPercent %}

    <div class="row">
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Kpi:Tile
                label="{{ 'Propiedades con huella' | trans }}"
                value="{{ organizational.propertiesWithCompletedFootprint }}"
                unit="{{ '/ ' ~ organizational.totalProperties }}"
                icon="solar:buildings-2-line-duotone"
                color="primary"
                footer="{{ organizational.companiesWithCompletedFootprint ~ ' / ' ~ organizational.totalCompanies ~ ' ' ~ ('empresas con huella' | trans) }}"
            />
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Kpi:Tile
                label="{{ 'Huellas completadas' | trans }}"
                value="{{ organizational.completedFootprints }}"
                unit="{{ '/ ' ~ organizational.totalFootprints }}"
                icon="solar:leaf-line-duotone"
                color="success"
                footer="{{ organizational.inProgressFootprints ~ ' ' ~ ('en curso' | trans) }}"
            >
                <twig:block name="content">
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: {{ organizationalCompletionPercent }}%" aria-valuenow="{{ organizationalCompletionPercent }}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </twig:block>
            </twig:Kpi:Tile>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Kpi:Tile
                label="{{ emissionsLabel }}"
                value="{{ (organizational.referenceYearTotalKg / 1000) | number_format(2, ',', '.') }}"
                unit="t CO₂eq"
                icon="carbon:sustainability"
                color="warning"
                footer="{{ scopesFooter }}"
            />
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            {% if variation is not null %}
                <twig:Kpi:Tile
                    label="{{ 'Variación interanual' | trans }}"
                    value="{{ (variation | number_format(1, ',', '.')) ~ ' %' }}"
                    valueClass="{{ variation > 0 ? 'text-danger' : 'text-success' }}"
                    icon="solar:graph-up-line-duotone"
                    color="info"
                    footer="{{ ('Respecto a {year}' | trans({'{year}': organizational.previousYear ~ ''})) ~ ' · ' ~ mitigationFooter }}"
                />
            {% else %}
                <twig:Kpi:Tile
                    label="{{ 'Variación interanual' | trans }}"
                    value="---"
                    icon="solar:graph-up-line-duotone"
                    color="info"
                    footer="{{ ('Sin año anterior calculado' | trans) ~ ' · ' ~ mitigationFooter }}"
                />
            {% endif %}
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 d-flex">
            <div class="card flex-fill">
                <div class="card-header fw-semibold">{{ 'Emisiones organizacionales por año' | trans }} <span class="text-muted fw-normal">(kg CO₂eq)</span></div>
                <div class="card-body">
                    {% if organizationalYearValues is not empty %}
                        <twig:Chart:Bar
                            title="{{ 'Emisiones' | trans }}"
                            :values="organizationalYearValues"
                            :categories="organizationalYearCategories"
                            :colors="['var(--bs-success)']"
                            unit="kg"
                            :decimals="0"
                        />
                    {% else %}
                        <p class="text-muted mb-0">{{ 'Completa tu primera huella organizacional para ver la evolución anual.' | trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-4 d-flex">
            <div class="card flex-fill">
                <div class="card-header fw-semibold">
                    {{ organizational.referenceYear is not null
                        ? ('Emisiones por alcance {year}' | trans({'{year}': organizational.referenceYear ~ ''}))
                        : ('Emisiones por alcance' | trans) }}
                </div>
                <div class="card-body">
                    {% if organizationalScopeValues is not empty %}
                        <twig:Chart:Donut
                            title="{{ 'Emisiones' | trans }}"
                            :values="organizationalScopeValues"
                            :categories="organizationalScopeCategories"
                            unit="kg"
                            :decimals="0"
                            :legend="true"
                        />
                    {% else %}
                        <p class="text-muted mb-0">{{ 'Todavía no hay actividades registradas.' | trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5 d-flex">
            <div class="card flex-fill">
                <div class="card-header fw-semibold">{{ 'Propiedades con más emisiones' | trans }} <span class="text-muted fw-normal">(kg CO₂eq)</span></div>
                <div class="card-body">
                    {% if organizationalPropertyValues is not empty %}
                        <twig:Chart:Bar
                            title="{{ 'Emisiones' | trans }}"
                            :values="organizationalPropertyValues"
                            :categories="organizationalPropertyCategories"
                            :colors="['var(--bs-secondary)']"
                            unit="kg"
                            :decimals="0"
                        />
                    {% else %}
                        <p class="text-muted mb-0">{{ 'Completa la huella de una propiedad para ver este ranking.' | trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-7 d-flex">
            <div class="card flex-fill">
                <div class="card-header fw-semibold">{{ 'Últimas huellas organizacionales' | trans }}</div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>{{ 'Propiedad / Empresa' | trans }}</th>
                                    <th>{{ 'Tipo' | trans }}</th>
                                    <th>{{ 'Año' | trans }}</th>
                                    <th>{{ 'Estado' | trans }}</th>
                                    <th class="text-end">{{ 'Emisiones (t CO₂eq)' | trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for overview in organizational.latestFootprints %}
                                    {% set footprint = overview.footprint %}
                                    {% set isCompany = overview.subjectType.value == 'company' %}
                                    {% set footprintParameters = isCompany ? {companyCarbonFootprintId: footprint.id} : {propertyCarbonFootprintId: footprint.id} %}
                                    {% set footprintRoute = (isCompany ? 'company' : 'property') ~ '_carbon_footprints_' ~ (footprint.completed ? 'results' : 'edit') %}
                                    <tr>
                                        <td>{{ overview.subjectName ?? '---' }}</td>
                                        <td>{{ overview.subjectType.value | trans({}, 'carbonFootprintReportSubjectType') }}</td>
                                        <td>{{ footprint.year }}</td>
                                        <td>
                                            <span class="badge {{ footprint.status.style }}">{{ footprint.status.value | trans({}, 'organizationalCarbonFootprintStatusType') }}</span>
                                        </td>
                                        <td class="text-end">{{ footprint.completed ? (footprint.totalEmissions.co2eq / 1000) | number_format(2, ',', '.') : '---' }}</td>
                                        <td class="text-end">
                                            <a href="{{ path(footprintRoute, footprintParameters) }}" class="btn btn-sm btn-light">{{ 'Ver' | trans }}</a>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
