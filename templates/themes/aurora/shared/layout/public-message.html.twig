{% extends '@shared/layout/public.html.twig' %}

{#
    Aurora renders status pages as a full-width banner instead of a centred card.
    Same variables as the core @shared/layout/public-message.html.twig.
#}

{% block page_header %}{% endblock %}

{% block content %}
    {% set message_variant = message_variant ?? 'info' %}
    <div class="card border-0">
        <div class="card-body text-center py-6 px-4">
            {% if message_icon is defined and message_icon %}
                <twig:Icon :name="message_icon" size="xl" :class="'text-' ~ message_variant ~ ' mb-4'" />
            {% endif %}
            <h2 class="text-{{ message_variant }} mb-3">{{ message_title }}</h2>
            <p class="text-muted mb-0 mx-auto" style="max-width: 42rem">{{ message_text }}</p>
            {% block message_actions %}{% endblock %}
        </div>
    </div>
{% endblock %}
