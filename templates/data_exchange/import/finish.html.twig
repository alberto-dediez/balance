{% extends '@shared/layout/register.html.twig' %}

{% set page_title = importationType.name
    ~ ' > '
    ~ ('Importar' | trans)
    ~ ' > '
    ~ ('En curso' | trans)
%}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path(importationType.returnRoute) }}" />
{% endblock %}

{% block content %}
    <twig:Card>
        <h4 class="mt-0">{% trans %}Importación en curso{% endtrans %}</h4>
        <p>{% trans %}El proceso de importación ha comenzado en segundo plano, por lo que puedes seguir trabajando en otras cosas mientras tanto. Le enviaremos un correo electrónico en cuanto finalice.{% endtrans %}</p>
    </twig:Card>
{% endblock %}
