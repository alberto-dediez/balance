<h3>{% trans with {
        '{file}': importation.name
    } -%}Importación de {file} finalizada{%- endtrans -%}</h3>
<p>{% trans -%}El proceso de importación ha finalizado. Puede comprobar el resultado en el siguiente enlace:{%- endtrans %}</p>
<a href="{{ url('import_view', {'code': importation.type, 'id': importation.id}) }}" class="btn btn-primary">
    {% trans -%}Ver resultado{%- endtrans -%}
</a>
