{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Segundo factor > Aplicación de autenticación' | trans %}

{% block content %}
    <twig:Card>
        {{ form_start(form) }}
        <div class="row">
            <div class="col-12">
                <p>{% trans -%}Escanea este código con Google Authenticator (o cualquier app compatible) e introduce el código que muestra.{%- endtrans %}</p>

                {% if qrSvg %}
                    <div class="text-center mb-3">{{ qrSvg | raw }}</div>
                {% endif %}

                <p class="text-center"><small class="text-muted">{{ 'Clave manual: {key}' | trans({'key': manualKey}) }}</small></p>

                {% if currentMethod %}
                    <twig:Alert type="info">{% trans -%}Tu segundo factor actual seguirá activo hasta que verifiques el nuevo código. Si cancelas, no se modifica.{%- endtrans %}</twig:Alert>
                {% endif %}

                {{ form_row(form.code) }}
            </div>
        </div>

        <twig:ActionBar>
            <div class="col-sm-6 col-md-3 col-lg-2">
                <a href="{{ path('profile_two_factor_cancel', {'_token': csrf_token('two-factor-cancel')}) }}" class="w-100 btn btn-link">{% trans -%}Cancelar{%- endtrans %}</a>
            </div>
            <twig:ActionBar:Button type="primary" :button="form.verify" />
        </twig:ActionBar>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
