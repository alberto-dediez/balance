<h3>
    {% trans with {
        '{user}': username
    } -%}Bienvenido {user}{%- endtrans -%}
</h3>
<p>
    {% if account is not empty %}
        {% trans with {
            '{user}': username,
            '{account}': account | account_name
        } -%}Se ha dado de alta un usuario con el email {user} en la cuenta {account}.{%- endtrans %}
    {% else %}
        {% trans with {
            '{user}': username,
        } -%}Se ha dado de alta un usuario con el email {user} sin cuenta asignada.{%- endtrans %}
    {% endif %}
</p>
<p>{% trans -%}Si no dispone de la contraseña para acceder puede generar una nueva contraseña visitando el siguiente enlace:{%- endtrans %}</p>
<a href="{{ url('app_recover_password') }}" class="btn btn-primary">
    {% trans -%}Generar nueva contraseña{%- endtrans -%}
</a>
