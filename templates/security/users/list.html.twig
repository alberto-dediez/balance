{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Lista de usuarios' | trans %}

{% block content %}
    <twig:Card>
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>
    <twig:Card>
        <table class="table">
            <tr>
                <twig:List:SortableHead 
                    order="{{ form.vars.value.orderBy }}" 
                    way="{{ form.vars.value.orderWay }}" 
                    value="username"
                >
                    {% trans %}Nombre de usuario{% endtrans %}
                </twig:List:SortableHead>
                <th>
                    {% trans %}Roles{% endtrans %}
                </th>
                <th>
                    {% trans %}Cuenta{% endtrans %}
                </th>
                <twig:List:SortableHead 
                    order="{{ form.vars.value.orderBy }}" 
                    way="{{ form.vars.value.orderWay }}" 
                    value="registeredAt"
                >
                    {% trans %}Fecha de registro{% endtrans %}
                </twig:List:SortableHead>
                <th>&nbsp;</th>
            </tr>
            {% for user in users %}
                <tr>
                    <td>{{ user.username }}</td>
                    <td>{{ user.roles | map(t => t | trans({}, 'roles')) | join(', ') }}</td>
                    <td>{{ user.account }}</td>
                    <td>{{ user.registeredAt | date('d/m/Y') }}</td>
                    <td></td>
                </tr>
            {% endfor %}
        </table>
        <twig:List:Pagination totalResults="{{ totalResults }}" page="{{ form.vars.value.page + 1 }}" limit="{{ form.vars.value.limit }}" />
    </twig:Card>
{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}