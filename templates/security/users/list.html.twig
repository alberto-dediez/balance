{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Lista de usuarios' | trans %}

{% block content %}
    <twig:Card>
        <twig:List:FilterBar>
            {% if form.vars.value.username is not empty %}
                <twig:Alert type="info">{{ form.vars.value.username }}</twig:Alert>
            {% endif %}
        </twig:List:FilterBar>
    </twig:Card>
    <twig:Card>
        <table class="table">
            <tr>
                <th>{% trans %}Nombre de usuario{% endtrans %}</th>
                <th>{% trans %}Fecha de registro{% endtrans %}</th>
                <th>&nbsp;</th>
            </tr>
            {% for user in users %}
                <tr>
                    <td>{{ user.username }}</td>
                    <td>{{ user.registeredAt | date('d/m/Y') }}</td>
                    <td></td>
                </tr>
            {% endfor %}
        </table>
        <twig:List:Pagination totalResults="{{ totalResults }}" page="{{ form.vars.value.page + 1 }}" limit="{{ form.vars.value.limit }}" />
    </twig:Card>
{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}