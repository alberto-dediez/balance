{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Cuentas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Activa' | trans
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="accounts">
        <tr>
            <td>{{ element.name }}</td>
            <td>{{ element.active | show_field_value }}</td>
            <td>{{ element.registeredAt | date('d/m/Y') }}</td>
            <td>
                <twig:List:Action:Edit path="{{ path('admin_accounts_edit', {'accountId': element.id}) }}" />
                <twig:List:Action:Delete path="{{ path('admin_accounts_remove', {'accountId': element.id}) }}" />
            </td>
        </tr>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_accounts_register') }}" />
{% endblock list_actions %}