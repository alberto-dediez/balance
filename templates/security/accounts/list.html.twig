{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Cuentas' | trans %}

{% block content %}
    <twig:Card>
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>
    <twig:Card>
        <table class="table">
            <tr>
                <twig:List:SortableHead 
                    order="{{ form.vars.value.orderBy }}" 
                    way="{{ form.vars.value.orderWay }}" 
                    value="name"
                >
                    {% trans %}Nombre{% endtrans %}
                </twig:List:SortableHead>
                <th>
                    {% trans %}Estado{% endtrans %}
                </th>
                <twig:List:SortableHead 
                    order="{{ form.vars.value.orderBy }}" 
                    way="{{ form.vars.value.orderWay }}" 
                    value="registeredAt"
                >
                    {% trans %}Fecha de registro{% endtrans %}
                </twig:List:SortableHead>
                <th>&nbsp;</th>
            </tr>
            {% for account in accounts %}
                <tr>
                    <td>{{ account.name }}</td>
                    <td>{{ account.active | show_field_value }}</td>
                    <td>{{ account.registeredAt | date('d/m/Y') }}</td>
                    <td></td>
                </tr>
            {% endfor %}
        </table>
        <twig:List:Pagination totalResults="{{ totalResults }}" page="{{ form.vars.value.page + 1 }}" limit="{{ form.vars.value.limit }}" />
    </twig:Card>
{% endblock %}