{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Eventos' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Detalle' | trans
        }, {
            'label': 'Usuario' | trans
        }, {
            'label': 'Suplantado por' | trans
        }, {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'eventName'
        }, {
            'label': 'Contexto' | trans,
            'sortable': true,
            'sortableBy': 'context'
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'occurredOn'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="events">
        <td>
            {% include [
                '@security/admin/events/detail/' ~ element.context ~ '.' ~ element.eventName ~ '.html.twig',
                '@security/admin/events/detail/default.html.twig'
            ] with {
                'event': element.rebuild()
            } %}
        </td>
        <td>{{ element.userId | user_name | trans | raw }}</td>
        <td>
            {% if element.isImpersonated %}
                <span class="badge bg-warning-subtle text-warning">{{ element.impersonatorId | user_name | trans | raw }}</span>
            {% endif %}
        </td>
        <td>{{ element.eventName }}</td>
        <td>{{ element.context }}</td>
        <td>{{ element.occurredOn | date('H:i d/m/Y') }}</td>
        <td>
        </td>
    </twig:List:Table>
{% endblock %}