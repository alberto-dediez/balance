{% if event.propertyId is not null %}
    {% trans with {
        '{name}': event.name,
        '{property}': event.propertyId | property_name,
        '{user}': element.userId | user_name
    } %}Se ha registrado el cartel doggy bag "{name}" para la propiedad {property} por el usuario {user}{% endtrans %}
{% else %}
    {% trans with {
        '{name}': event.name,
        '{user}': element.userId | user_name
    } %}Se ha registrado el cartel doggy bag "{name}" por el usuario {user}{% endtrans %}
{% endif %}
