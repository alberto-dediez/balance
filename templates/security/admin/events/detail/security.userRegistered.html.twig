{% if event.accountId is not empty %}
    {% trans with {
        '{user}': event.username,
        '{account}': event.accountId | account_name
    } %}Registrado el usuario {user} para la cuenta {account}{% endtrans %}
{% else %}
    {% trans with {
        '{user}': event.username
    } %}Registrado el usuario {user} sin cuenta{% endtrans %}
{% endif %}

