{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('admin_users') }}" />
{% endblock %}

{% set page_title = ('Usuarios' | trans)
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ user.username %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    <twig:View:Field label="{{ 'Nombre de usuario' | trans }}">{{ user.username }}</twig:View:Field>
                    <twig:View:Field label="{{ 'Cuenta' | trans }}">{{ user.account != null ? user.account.name : '---' }}</twig:View:Field>

                    {{ form_row(form.roles) }}
                    {{ form_row(form.preferredLocale) }}
                </div>
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
