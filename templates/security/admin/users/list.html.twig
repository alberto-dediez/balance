{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Usuarios' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre de usuario' | trans,
            'sortable': true,
            'sortableBy': 'username'
        }, {
            'label': 'Roles' | trans
        }, {
            'label': 'Cuenta' | trans
        }, {
            'label': 'Activo' | trans
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="users">
        <tr>
            <td>{{ element.username }}</td>
            <td>{{ element.roles | map(t => t.value | trans({}, 'roles')) | join(', ') }}</td>
            <td>{{ element.account }}</td>
            <td>{{ element.active | show_field_value }}</td>
            <td>{{ element.registeredAt | date('d/m/Y') }}</td>
            <td>
                <twig:List:Action:Edit path="{{ path('admin_users_edit', {'userId': element.id}) }}" />
                <twig:List:Action:Delete path="{{ path('admin_users_remove', {'userId': element.id}) }}" />
            </td>
        </tr>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_users_register') }}" />
{% endblock list_actions %}