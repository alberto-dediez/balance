{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Usuarios' | trans %}

{% block content %}
    <twig:Card>
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>
    <twig:Card>
        <table class="table">
            <tr>
                <twig:List:SortableHead 
                    order="{{ form.vars.value.orderBy }}" 
                    way="{{ form.vars.value.orderWay }}" 
                    value="username"
                >
                    {% trans %}Nombre de usuario{% endtrans %}
                </twig:List:SortableHead>
                <th>
                    {% trans %}Roles{% endtrans %}
                </th>
                <th>
                    {% trans %}Cuenta{% endtrans %}
                </th>
                <th>
                    {% trans %}Activo{% endtrans %}
                </th>
                <twig:List:SortableHead 
                    order="{{ form.vars.value.orderBy }}" 
                    way="{{ form.vars.value.orderWay }}" 
                    value="registeredAt"
                >
                    {% trans %}Fecha de registro{% endtrans %}
                </twig:List:SortableHead>
                <th>&nbsp;</th>
            </tr>
            {% for user in users %}
                <tr>
                    <td>{{ user.username }}</td>
                    <td>{{ user.roles | map(t => t.value | trans({}, 'roles')) | join(', ') }}</td>
                    <td>{{ user.account }}</td>
                    <td>{{ user.active | show_field_value }}</td>
                    <td>{{ user.registeredAt | date('d/m/Y') }}</td>
                    <td>
                        <twig:List:Action:Edit path="{{ path('admin_users_edit', {'userId': user.id}) }}" />
                        <twig:List:Action:Delete path="{{ path('admin_users_remove', {'userId': user.id}) }}" />
                    </td>
                </tr>
            {% endfor %}
        </table>
        <twig:List:Pagination totalResults="{{ totalResults }}" page="{{ form.vars.value.page + 1 }}" limit="{{ form.vars.value.limit }}" />
    </twig:Card>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_users_register') }}" />
{% endblock list_actions %}