{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('admin_accounts') }}" />
{% endblock %}

{% set page_title = ('Cuentas' | trans) 
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ account.name %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.name) }}
                    {{ form_row(form.active) }}
                    {{ form_row(form.emissionFactorGroupId) }}
                    {{ form_row(form.consultant) }}
                    {{ form_row(form.consultantAccountId) }}

                    <h6 class="fw-semibold mb-3 mt-4">{{ 'Informe de huella de carbono' | trans }}</h6>
                    {{ form_row(form.reportCanEditTexts) }}
                    {{ form_row(form.reportAutoReview) }}
                </div>
            </div>    

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}