{% extends '@shared/base.html.twig' %}

{% set page_title = 'Verificación de identidad' | trans %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">{{ 'Verificación de identidad' | trans }}</h5>
                </div>
                <div class="card-body">
                    {% if error == 'locked' %}
                        <div class="alert alert-danger">
                            {{ 'Has superado el número máximo de intentos. El enlace ha quedado bloqueado.' | trans }}
                        </div>
                    {% else %}
                        {% if resent is defined and resent %}
                            <div class="alert alert-success">
                                {{ 'Se ha enviado un nuevo código.' | trans }}
                            </div>
                        {% endif %}

                        <p class="text-muted">
                            {% if notificationChannel == 'Sms' %}
                                {{ 'Hemos enviado un código de 6 dígitos al número ' | trans }}<strong>{{ maskedDestination }}</strong>.
                            {% else %}
                                {{ 'Hemos enviado un código de 6 dígitos al email ' | trans }}<strong>{{ maskedDestination }}</strong>.
                            {% endif %}
                        </p>

                        {% if error == 'invalid' %}
                            <div class="alert alert-warning">
                                {{ 'Código incorrecto.' | trans }}
                                {% if attemptsLeft is not null %}
                                    {{ 'Te quedan %n% intentos.' | trans({'%n%': attemptsLeft}) }}
                                {% endif %}
                            </div>
                        {% endif %}

                        <form method="POST" action="{{ path('public_sign_otp_post', {'token': token}) }}">
                            <input type="hidden" name="action" value="verify">

                            <div class="mb-3">
                                <label for="otp_code" class="form-label">{{ 'Código de verificación' | trans }}</label>
                                <input type="text"
                                       id="otp_code"
                                       name="otp_code"
                                       class="form-control form-control-lg text-center"
                                       inputmode="numeric"
                                       autocomplete="one-time-code"
                                       maxlength="6"
                                       pattern="\d{6}"
                                       required
                                       autofocus>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    {{ 'Verificar' | trans }}
                                </button>
                            </div>
                        </form>

                        <hr>

                        <form method="POST" action="{{ path('public_sign_otp_post', {'token': token}) }}">
                            <input type="hidden" name="action" value="resend">
                            <div class="text-center">
                                <button type="submit" class="btn btn-link">
                                    {{ '¿No has recibido el código? Reenviar' | trans }}
                                </button>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
