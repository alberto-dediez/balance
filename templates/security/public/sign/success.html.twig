{% extends '@shared/layout/public-message.html.twig' %}

{% set page_title = 'Documento firmado' | trans %}
{% set message_variant = 'success' %}
{% set message_icon = 'solar:check-circle-bold' %}
{% set message_title = 'Documento firmado correctamente' | trans %}
{% set message_text = ('La firma ha quedado registrada.' | trans) ~ ' ' ~ (signatureRequest.signatureProof.signedAt | date('d/m/Y H:i:s')) %}

{% block message_actions %}
    <p class="text-muted mt-2 mb-0">
        {{ 'ID de la solicitud' | trans }}: <code>{{ signatureRequest.id }}</code>
    </p>
    <p class="mt-4 mb-0">
        <a href="{{ path('public_sign_verify', {'signatureRequestId': signatureRequest.id}) }}" class="btn btn-outline-primary">
            {{ 'Verificar la firma' | trans }}
        </a>
    </p>
{% endblock %}
