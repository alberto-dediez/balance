{% extends '@shared/base.html.twig' %}

{% set page_title = 'Enlace inválido' | trans %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card">
                <div class="card-body py-5">
                    <h3 class="text-danger">{{ 'Este enlace no es válido o ha expirado' | trans }}</h3>
                    <p class="text-muted mt-3">
                        {{ 'El enlace de firma que ha utilizado no es válido, ha expirado o ya no está disponible.' | trans }}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
