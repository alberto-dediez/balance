{% extends '@shared/base.html.twig' %}

{% set page_title = 'Documento ya firmado' | trans %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card">
                <div class="card-body py-5">
                    <h3 class="text-info">{{ 'Este documento ya ha sido firmado' | trans }}</h3>
                    <p class="text-muted mt-3">
                        {% if signatureRequest.signatureProof and signatureRequest.signatureProof.signedAt %}
                            {{ 'Firmado el' | trans }}: <strong>{{ signatureRequest.signatureProof.signedAt | date('d/m/Y H:i') }}</strong>
                        {% endif %}
                    </p>
                    <p>
                        <a href="{{ path('public_sign_verify', {'signatureRequestId': signatureRequest.id}) }}" class="btn btn-outline-primary">
                            {{ 'Verificar la firma' | trans }}
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
