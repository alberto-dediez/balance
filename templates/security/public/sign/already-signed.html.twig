{% extends '@shared/layout/public-message.html.twig' %}

{% set page_title = 'Documento ya firmado' | trans %}
{% set message_variant = 'info' %}
{% set message_icon = 'solar:document-text-line-duotone' %}
{% set message_title = 'Este documento ya ha sido firmado' | trans %}
{% set message_text = signatureRequest.signatureProof and signatureRequest.signatureProof.signedAt
    ? ('Firmado el' | trans) ~ ': ' ~ (signatureRequest.signatureProof.signedAt | date('d/m/Y H:i'))
    : '' %}

{% block message_actions %}
    <p class="mt-4 mb-0">
        <a href="{{ path('public_sign_verify', {'signatureRequestId': signatureRequest.id}) }}" class="btn btn-outline-primary">
            {{ 'Verificar la firma' | trans }}
        </a>
    </p>
{% endblock %}
