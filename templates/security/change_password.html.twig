{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Cambiar contraseña' | trans %}

{% block content %}
    <twig:Card>
        {{ form_start(form) }}
        <div class="row">
            <div class="col-12">
                <twig:View:Field label="{{ 'Nombre de usuario' | trans }}">{{ user.username }}</twig:View:Field>

                {{ form_row(form.oldPassword) }}
                {{ form_row(form.password) }}
            </div>
        </div>

        <twig:ActionBar>
            <twig:ActionBar:Button type="primary" :button="form.save" />
        </twig:ActionBar>
        {{ form_end(form) }}
    </twig:Card>
{% endblock %}
