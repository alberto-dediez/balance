{% extends '@security/layout.html.twig' %}

{% block form %}
    <form action="" method="POST">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div class="form-group mb-3">
            <label class="form-label" for="username">{% trans -%}Email{%- endtrans %}</label>
            <input
                class="form-control"
                type="text"
                id="username"
                required=""
                name="_username"
                placeholder="{% trans -%}Introduce tu email{%- endtrans %}"
            >
        </div>

        <div class="form-group mb-3">
            <label class="form-label" for="password">{% trans -%}Contraseña{%- endtrans %}</label>
            <div class="input-group" data-controller="password">
                <input
                    class="form-control"
                    type="password"
                    required=""
                    id="password"
                    name="_password"
                    placeholder="{% trans -%}Introduce tu contraseña{%- endtrans %}"
                >
                <button class="btn btn-light reveal rounded-end"
                    type="button"
                    title="{% trans -%}Mostrar / ocultar contraseña{%- endtrans %}"
                    data-action="click->password#toogleVisibility"
                >
                    <twig:Icon name="ph:eye-slash-duotone" class="see" />
                    <twig:Icon name="ph:eye-duotone" class="hide d-none" />
                </button>
            </div>
        </div>

        <div class="form-group mb-3">
            <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input" name="_remember_me" id="checkbox-signin">
                <label class="form-check-label" for="checkbox-signin">{% trans -%}Recuerdame{%- endtrans %}</label>
            </div>
        </div>

        <div class="form-group mb-0 text-center">
            <button class="btn btn-primary w-100 py-8 mb-4 rounded-2" name="submit" type="submit">{% trans -%}Acceder{%- endtrans %}</button>
        </div>

        <div class="form-group mb-4 text-center">
            <a href="{{ path('app_login_bioscore') }}" class="btn btn-outline-primary w-100 py-8 rounded-2 d-flex align-items-center justify-content-center">
                {% trans -%}Login con Bioscore{%- endtrans %}
            </a>
        </div>

        <input type="hidden" name="_csrf_token"
            value="{{ csrf_token('authenticate') }}"
        >
    </form>

    <div class="row">
        <div class="col-12 text-center">
            <a href="{{ path('app_recover_password') }}" class="text-muted ms-1 d-flex justify-content-center">
                <iconify-icon icon="solar:lock-keyhole-minimalistic-line-duotone" class="fs-5 me-2"></iconify-icon>
                {% trans -%}¿Ha olvidado su contraseña?{%- endtrans %}
            </a>
        </div>
    </div>
{% endblock form %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
