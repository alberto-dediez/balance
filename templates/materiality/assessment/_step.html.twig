{% set assessment = step.assessment %}

<twig:Card title="{{ 'Evaluación de materialidad' | trans }}">
    {% if assessment is null %}
        <p class="text-muted">{{ 'La evaluación de materialidad mide la relevancia de cada categoría de emisiones para la organización a partir de un breve cuestionario.' | trans }} {{ 'Al completarla se obtiene una puntuación de relevancia por categoría que ayuda a decidir qué categorías incluir en el cálculo.' | trans }}</p>

        {% if step.sectors is empty %}
            <p class="text-muted">{{ 'No hay sectores definidos: se aplicarán las preguntas comunes.' | trans }}</p>
        {% endif %}

        {% if readOnly %}
            <twig:Alert:Alert type="info">{{ 'La huella se completó sin evaluación de materialidad.' | trans }}</twig:Alert:Alert>
        {% elseif startForm is not null %}
            {{ form_start(startForm) }}
                <div class="row">
                    {% if startForm.sectorId is defined %}
                        <div class="col-md-6">
                            {{ form_row(startForm.sectorId) }}
                        </div>
                    {% endif %}
                    {% if startForm.copyPreviousAnswers is defined %}
                        <div class="col-md-6">
                            {{ form_row(startForm.copyPreviousAnswers) }}
                        </div>
                    {% endif %}
                </div>

                <twig:ActionBar>
                    <twig:ActionBar:Button type="primary" :button="startForm.start" />
                </twig:ActionBar>
            {{ form_end(startForm) }}
        {% endif %}
    {% else %}
        <p class="mb-2">
            <span class="badge {{ assessment.status.style }}">{{ assessment.status.value | trans({}, 'materialityAssessmentStatusType') }}</span>
        </p>
        <p class="mb-1">{{ 'Sector' | trans }}: {{ assessment.sectorName ?? '---' }}</p>
        {% if assessment.isCompleted %}
            <p class="mb-3">{% trans with {'{date}': assessment.completedAt | date('d/m/Y H:i'), '{user}': assessment.completedBy | user_name} %}Completada el {date} por {user}{% endtrans %}</p>
        {% else %}
            <p class="mb-3">{{ 'Progreso' | trans }}: {% trans with {'{answered}': assessment.answeredCount, '{total}': assessment.totalAnswers} %}{answered} de {total} respuestas{% endtrans %}</p>
        {% endif %}

        {% if step.stageExcluded and step.summaryRows is not empty %}
            <twig:Alert:Alert type="info">{{ 'Alcance 3 excluido: las recomendaciones no se aplican' | trans }}</twig:Alert:Alert>
        {% endif %}

        {% if step.pendingReview %}
            <twig:Alert:Alert type="warning">
                {{ 'Hay categorías del alcance 3 pendientes de revisión tras el último análisis de materialidad.' | trans }}
                <a href="{{ scope3Path }}" class="alert-link">{{ 'Revisar el alcance 3' | trans }}</a>
            </twig:Alert:Alert>
        {% endif %}

        {% if step.summaryRows is not empty %}
            {% set topicsById = {} %}
            {% for topic in assessment.topics %}
                {% set topicsById = topicsById | merge({(topic.topicId ~ ''): topic}) %}
            {% endfor %}

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'Alcance' | trans }}</th>
                            <th>{{ 'Dirección' | trans }}</th>
                            <th>{{ 'Categoría' | trans }}</th>
                            <th>{{ 'Respondidas' | trans }}</th>
                            <th>{{ 'Relevancia' | trans }}</th>
                            <th>{{ 'Umbral' | trans }}</th>
                            <th>{{ 'Veredicto' | trans }}</th>
                            <th>{{ 'Estado en la huella' | trans }}</th>
                            <th>{{ 'Anulación' | trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in step.summaryRows %}
                            {% set topic = row.topicId is not null ? (topicsById[row.topicId] ?? null) : null %}
                            <tr>
                                {% if topic is not null %}
                                    {% set topicAnswers = assessment.answersOf(topic.topicId) %}
                                    <td>{{ topic.scope.value | trans({}, 'materialityScopeType') }}</td>
                                    <td>{{ topic.direction is not null ? topic.direction.value | trans({}, 'materialityTopicDirectionType') : '---' }}</td>
                                    <td>{{ topic.topicNumber is not null ? topic.topicNumber ~ '. ' : '' }}{{ (topic.topicId | materiality_topic_name).name ?? topic.name }}</td>
                                    <td>{{ topicAnswers | filter(answer => answer.isAnswered) | length }} / {{ topicAnswers | length }}</td>
                                {% else %}
                                    <td>{{ 'Alcance 3' | trans }}</td>
                                    <td>---</td>
                                    <td>{{ row.topicNumber is not null ? row.topicNumber ~ '. ' : '' }}{{ row.source.value | trans({}, 'source') }}</td>
                                    <td>---</td>
                                {% endif %}
                                <td>
                                    {% if row.scorePercent is null %}
                                        ---
                                    {% else %}
                                        {{ row.scorePercent | number_format(2, ',', '.') }} %
                                        <div class="progress">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: {{ row.scorePercent | round }}%" aria-valuenow="{{ row.scorePercent | round }}" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>{{ row.thresholdPercent is not null ? row.thresholdPercent ~ ' %' : '---' }}</td>
                                <td>
                                    {% if row.verdict is null %}
                                        ---
                                    {% else %}
                                        <span class="badge {{ row.verdict.style }}">{{ row.verdict.value | trans({}, 'materialityVerdictType') }}</span>
                                        {% if row.forcedByHighMagnitude %}
                                            <span class="badge bg-warning text-dark">{{ 'Magnitud alta' | trans }}</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td><span class="badge {{ row.state.style }}">{{ row.state.value | trans({}, 'materialityCategoryStateType') }}</span></td>
                                <td>
                                    {% if row.decision is not null and row.decision.isOverridden %}
                                        {{ row.decision.overriddenByUserId | user_name }}, {{ row.decision.overriddenAt | date('d/m/Y H:i') }}
                                        <div class="text-muted">{{ row.decision.overrideJustification }}</div>
                                    {% else %}
                                        ---
                                    {% endif %}
                                </td>
                                <td>
                                    {% if topic is not null %}
                                        {% set topicPath = path('materiality_assessments_topic', {materialityAssessmentId: assessment.id, assessmentTopicId: topic.id}) %}
                                        {% if readOnly or assessment.isCompleted %}
                                            <twig:List:Action:View path="{{ topicPath }}" />
                                        {% else %}
                                            <twig:List:Action:Edit path="{{ topicPath }}" />
                                        {% endif %}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>{{ 'Alcance' | trans }}</th>
                            <th>{{ 'Dirección' | trans }}</th>
                            <th>{{ 'Categoría' | trans }}</th>
                            <th>{{ 'Respondidas' | trans }}</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for topic in assessment.topics %}
                            {% set topicAnswers = assessment.answersOf(topic.topicId) %}
                            {% set topicPath = path('materiality_assessments_topic', {materialityAssessmentId: assessment.id, assessmentTopicId: topic.id}) %}
                            <tr>
                                <td>{{ topic.scope.value | trans({}, 'materialityScopeType') }}</td>
                                <td>{{ topic.direction is not null ? topic.direction.value | trans({}, 'materialityTopicDirectionType') : '---' }}</td>
                                <td>{{ topic.topicNumber is not null ? topic.topicNumber ~ '. ' : '' }}{{ (topic.topicId | materiality_topic_name).name ?? topic.name }}</td>
                                <td>{{ topicAnswers | filter(answer => answer.isAnswered) | length }} / {{ topicAnswers | length }}</td>
                                <td>
                                    {% if readOnly or assessment.isCompleted %}
                                        <twig:List:Action:View path="{{ topicPath }}" />
                                    {% else %}
                                        <twig:List:Action:Edit path="{{ topicPath }}" />
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if not readOnly %}
            <div class="d-flex justify-content-between">
                <form method="post" action="{{ path('materiality_assessments_remove', {materialityAssessmentId: assessment.id}) }}"
                    data-controller="confirm"
                    data-confirm-text-param="{{ '¿Seguro que quieres reiniciar el cuestionario? Se perderán las respuestas.' | trans }}"
                    data-action="confirm#submit"
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('materiality_assessment_remove_' ~ assessment.id) }}">
                    <button type="submit" class="btn btn-outline-danger">{{ 'Reiniciar cuestionario' | trans }}</button>
                </form>

                {% if assessment.isCompleted %}
                    <form method="post" action="{{ path('materiality_assessments_reopen', {materialityAssessmentId: assessment.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('materiality_assessment_reopen_' ~ assessment.id) }}">
                        <button type="submit" class="btn btn-outline-primary">{{ 'Reabrir evaluación' | trans }}</button>
                    </form>
                {% else %}
                    <form method="post" action="{{ path('materiality_assessments_complete', {materialityAssessmentId: assessment.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('materiality_assessment_complete_' ~ assessment.id) }}">
                        <button type="submit" class="btn btn-primary">{{ 'Completar evaluación' | trans }}</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}
    {% endif %}
</twig:Card>

<div class="d-flex justify-content-between mt-3">
    <a href="{{ previousPath }}" class="btn btn-outline-primary">
        &larr; {{ 'Anterior' | trans }}
    </a>
    {% if step.materialityAnswered or (assessment is not null and assessment.isCompleted) %}
        <a href="{{ nextPath }}" class="btn btn-primary">
            {{ 'Siguiente' | trans }} &rarr;
        </a>
    {% elseif not readOnly %}
        <form method="post" name="materiality_skip">
            <input type="hidden" name="_token" value="{{ skipToken }}">
            <button type="submit" class="btn btn-outline-secondary">{{ 'Continuar sin evaluar' | trans }} &rarr;</button>
        </form>
    {% endif %}
</div>
