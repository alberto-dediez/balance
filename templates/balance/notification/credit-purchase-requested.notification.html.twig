<p>
    {% trans with {
        '{project}': projectName,
        '{tonnes}': requestedTonnes
    } -%}
        Se ha solicitado la compra de {tonnes} toneladas de CO2 para el proyecto {project}.
    {%- endtrans %}
    {% if projectMitecoId %}
        {% trans with {'{mitecoId}': projectMitecoId} -%}(Registro Miteco {mitecoId}){%- endtrans %}
    {% endif %}
</p>
<p>
    <a href="{{ path('admin_credit_purchases_validate', {'creditPurchaseId': creditPurchaseId}) }}">
        {% trans -%}Ver solicitud{%- endtrans -%}
    </a>
</p>
