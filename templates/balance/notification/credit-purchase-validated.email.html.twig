<h3>{% trans -%}Su compra de créditos ha sido validada{%- endtrans -%}</h3>
<p>
    {% trans with {
        '{project}': projectName,
        '{tonnes}': purchasedTonnes,
        '{amount}': amount,
        '{reference}': reference
    } -%}
        Su compra de {tonnes} toneladas de CO2 del proyecto {project} ha sido validada por un importe de {amount} € (identificador {reference}).
    {%- endtrans %}
    {% if projectMitecoId %}
        {% trans with {'{mitecoId}': projectMitecoId} -%}(Registro Miteco {mitecoId}){%- endtrans %}
    {% endif %}
</p>
<a href="{{ url('credit_purchases_view', {'creditPurchaseId': creditPurchaseId}) }}" class="btn btn-primary">
    {% trans -%}Ver el detalle de la compra{%- endtrans -%}
</a>
