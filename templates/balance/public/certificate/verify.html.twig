{% extends theme_template('@shared/layout/public.html.twig') %}

{% set page_title = 'Verificación de certificado' | trans %}

{% block page_header %}{% endblock %}

{% block content %}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card mb-4">
                <div class="card-body">
                    <div class="text-center mb-4">
                        {% if certificate.valid %}
                            <twig:Icon name="solar:verified-check-bold" size="xl" class="text-success mb-3" />
                            <h5 class="text-success mb-1">{{ 'Certificado válido' | trans }}</h5>
                        {% else %}
                            <twig:Icon name="solar:clock-circle-bold" size="xl" class="text-warning mb-3" />
                            <h5 class="mb-1">{{ 'Certificado en preparación' | trans }}</h5>
                        {% endif %}
                        <p class="mb-1"><code class="text-break">{{ certificate.code }}</code></p>
                        <p class="text-muted small mb-0">
                            {{ 'Esta referencia debe coincidir con la impresa en el documento' | trans }}
                        </p>
                    </div>

                    <div class="border-top">
                        <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                            <div class="text-muted small flex-shrink-0">{{ 'Tipo de documento' | trans }}</div>
                            <div class="text-sm-end text-break">
                                {{ certificate.type.value | trans({}, 'contributionCertificateType') }}
                            </div>
                        </div>
                        <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                            <div class="text-muted small flex-shrink-0">{{ 'Beneficiario' | trans }}</div>
                            <div class="text-sm-end text-break">{{ certificate.beneficiaryName }}</div>
                        </div>
                        <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                            <div class="text-muted small flex-shrink-0">{{ 'Proyecto' | trans }}</div>
                            <div class="text-sm-end text-break">{{ certificate.projectName }}</div>
                        </div>
                        {% if certificate.projectLocation %}
                            <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                                <div class="text-muted small flex-shrink-0">{{ 'Ubicación' | trans }}</div>
                                <div class="text-sm-end text-break">{{ certificate.projectLocation }}</div>
                            </div>
                        {% endif %}
                        {% if certificate.projectRegistryId %}
                            <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                                <div class="text-muted small flex-shrink-0">{{ 'Registro oficial' | trans }}</div>
                                <div class="text-sm-end text-break">{{ certificate.projectRegistryId }}</div>
                            </div>
                        {% endif %}
                        {% if certificate.co2eqKg is not null %}
                            <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                                <div class="text-muted small flex-shrink-0">{{ 'Emisiones compensadas' | trans }}</div>
                                <div class="text-sm-end text-nowrap">
                                    {{ certificate.co2eqKg | number_format(2, ',', '.') }} {{ 'kg CO₂eq' | trans }}
                                </div>
                            </div>
                        {% endif %}
                        {% if certificate.creditLots is not empty %}
                            <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                                <div class="text-muted small flex-shrink-0">{{ 'Lotes de créditos' | trans }}</div>
                                <div class="text-sm-end text-break">
                                    {% for lot in certificate.creditLots %}
                                        <code class="d-block text-break">{{ lot.serial }}</code>
                                        <span class="d-block small text-muted mb-2">
                                            {{ lot.startTonnes | number_format(6, ',', '.') }} –
                                            {{ lot.endTonnes | number_format(6, ',', '.') }} t
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% elseif certificate.masterSerials is not empty %}
                            <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                                <div class="text-muted small flex-shrink-0">{{ 'Números de serie maestros' | trans }}</div>
                                <div class="text-sm-end text-break">
                                    {% for serial in certificate.masterSerials %}
                                        <code class="d-block text-break">{{ serial }}</code>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1 gap-sm-3 py-2 border-bottom">
                            <div class="text-muted small flex-shrink-0">{{ 'Fecha de emisión' | trans }}</div>
                            <div class="text-sm-end">{{ certificate.issuedAt | date('d/m/Y') }}</div>
                        </div>
                    </div>

                    {% if certificate.creditLots is not empty %}
                        <p class="text-muted small mt-3 mb-0">
                            {{ 'Cada lote identifica un tramo de toneladas dentro de un serial de compra. Ningún otro certificado emitido puede reclamar el mismo tramo. La retirada de los créditos en el registro oficial debe verificarse en el propio registro.' | trans }}
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
