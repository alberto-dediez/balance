{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Historial de solicitudes de créditos' | trans %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('credits') }}" />
{% endblock %}

{% block table %}
    {% set columns = [
        {
            'label': 'Proyecto' | trans,
            'sortable': false
        }, {
            'label': 'Solicitadas' | trans,
            'sortable': false
        }, {
            'label': 'Compradas' | trans,
            'sortable': false
        }, {
            'label': 'Importe' | trans,
            'sortable': false
        }, {
            'label': 'Identificador' | trans,
            'sortable': false
        }, {
            'label': 'Estado' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de solicitud' | trans,
            'sortable': true,
            'sortableBy': 'requestedAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="creditPurchases">
        <td>{{ element.projectId | project_name }}</td>
        <td>{{ element.requestedTonnes }}</td>
        <td>{{ element.purchasedTonnes ?? '-' }}</td>
        <td>{{ element.amount is not null ? (element.amount ~ ' €') : '-' }}</td>
        <td>{{ element.reference ?? '-' }}</td>
        <td>
            {{ element.status.value | trans({}, 'creditPurchaseStatus') }}
            {% if element.isPartiallyFulfilled %}
                <span class="badge bg-warning text-dark">{{ 'Parcial' | trans }}</span>
            {% endif %}
        </td>
        <td>{{ element.requestedAt | date('d/m/Y') }}</td>
        <td>
            {% if element.status.value == 'pending' %}
                <a href="{{ path('credit_purchases_cancel', {'creditPurchaseId': element.id}) }}"
                   class="btn btn-sm btn-outline-danger"
                   data-controller="confirm"
                   data-confirm-text-param="{{ '¿Está seguro de que desea cancelar esta solicitud?' | trans }}"
                   data-action="confirm#link:prevent">
                    {{ 'Cancelar' | trans }}
                </a>
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}
