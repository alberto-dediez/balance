{#
    Variables expected: allocations, purchasedTonnes, availableTonnes; optional: offsetTonnes, upperOffsetTonnes, voidedTonnes, height, labels
#}
{% macro segment(tonnes, purchasedTonnes, labels, label, classes) %}
    {% if tonnes > 0 and purchasedTonnes > 0 %}
        {% set percent = tonnes / purchasedTonnes * 100 %}
        <div class="progress-bar {{ classes }}"
             role="progressbar"
             style="width: {{ percent }}%"
             aria-valuenow="{{ percent }}"
             aria-valuemin="0"
             aria-valuemax="100"
             title="{{ label }}: {{ tonnes | number_format(4, ',', '.') }} t">
            {% if labels and percent >= 8 %}{{ label }}{% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% import _self as bar %}

{% set colors = ['bg-primary', 'bg-success', 'bg-info', 'bg-warning', 'bg-danger', 'bg-secondary'] %}
{% set height = height | default(12) %}
{% set labels = labels | default(false) %}
{% set offsetTonnes = offsetTonnes | default(0) %}
{% set upperOffsetTonnes = upperOffsetTonnes | default(0) %}
{% set voidedTonnes = voidedTonnes | default(0) %}
{% set transferredClasses = 'progress-bar-striped bg-secondary bg-opacity-50 text-dark' %}
{% set otherLotsClasses = 'bg-dark bg-opacity-10 text-dark' %}

<div class="progress" style="height: {{ height }}px;">
    {{ bar.segment(offsetTonnes, purchasedTonnes, labels, 'Otros lotes del serial' | trans, otherLotsClasses) }}

    {% for allocation in allocations %}
        {% set percent = purchasedTonnes > 0 ? (allocation.tonnes / purchasedTonnes * 100) : 0 %}
        <div class="progress-bar {{ colors[loop.index0 % colors|length] }}"
             role="progressbar"
             style="width: {{ percent }}%"
             aria-valuenow="{{ percent }}"
             aria-valuemin="0"
             aria-valuemax="100"
             title="{{ allocation.projectContribution.originName ?? allocation.projectContribution.contributorName }}: {{ allocation.tonnes | number_format(4, ',', '.') }} t">
            {% if labels and percent >= 8 %}{{ allocation.tonnes | number_format(2, ',', '.') }} t{% endif %}
        </div>
    {% endfor %}

    {% if availableTonnes > 0 and purchasedTonnes > 0 %}
        {% set freePercent = availableTonnes / purchasedTonnes * 100 %}
        <div class="progress-bar bg-light text-dark"
             role="progressbar"
             style="width: {{ freePercent }}%"
             aria-valuenow="{{ freePercent }}"
             aria-valuemin="0"
             aria-valuemax="100"
             title="{{ 'Libre' | trans }}: {{ availableTonnes | number_format(4, ',', '.') }} t">
            {% if labels and freePercent >= 8 %}{{ 'Libre' | trans }}{% endif %}
        </div>
    {% endif %}

    {{ bar.segment(voidedTonnes, purchasedTonnes, labels, 'Transferido' | trans, transferredClasses) }}
    {{ bar.segment(upperOffsetTonnes, purchasedTonnes, labels, 'Otros lotes del serial' | trans, otherLotsClasses) }}
</div>

{% if labels %}
    <div class="d-flex flex-wrap gap-3 small text-muted mt-2">
        {% for allocation in allocations %}
            <span>
                <span class="badge {{ colors[loop.index0 % colors|length] }}">&nbsp;</span>
                {{ allocation.projectContribution.originName ?? allocation.projectContribution.contributorName }}
            </span>
        {% endfor %}

        {% if availableTonnes > 0 %}
            <span>
                <span class="badge bg-light border">&nbsp;</span>
                {{ 'Libre' | trans }}
            </span>
        {% endif %}

        {% if voidedTonnes > 0 %}
            <span>
                <span class="badge bg-secondary bg-opacity-50 border">&nbsp;</span>
                {{ 'Transferido' | trans }}
            </span>
        {% endif %}

        {% if offsetTonnes + upperOffsetTonnes > 0 %}
            <span>
                <span class="badge bg-dark bg-opacity-10 border">&nbsp;</span>
                {{ 'Otros lotes del serial' | trans }}
            </span>
        {% endif %}
    </div>
{% endif %}
