{% extends '@shared/layout/edit.html.twig' %}

{% set page_title = 'Mis créditos de CO2' | trans %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('credit_purchases') }}" />
{% endblock %}

{% block content %}
    <twig:Card title="{{ 'Saldo por proyecto' | trans }}">
        {% if balances is empty %}
            <p class="text-muted mb-0">{{ 'Todavía no tiene créditos comprados' | trans }}</p>
        {% else %}
            {% set columns = [
                {'label': 'Proyecto' | trans},
                {'label': 'Toneladas compradas' | trans},
                {'label': 'Toneladas disponibles' | trans},
                {'label': 'Coste / tonelada' | trans},
                {'label': 'Coste total' | trans},
            ] %}

            <twig:List:Table :columns="columns" :elements="balances">
                {% set project = element.projectId | project_name %}
                <td>{{ project }}</td>
                <td>{{ element.purchasedTonnes }}</td>
                <td>{{ element.availableTonnes }}</td>
                <td>{{ project.costPerTonne is not null ? (project.costPerTonne | number_format(2, ',', '.') ~ ' €') : '-' }}</td>
                <td>{{ project.costPerTonne is not null ? ((element.purchasedTonnes * project.costPerTonne) | number_format(2, ',', '.') ~ ' €') : '-' }}</td>
            </twig:List:Table>
        {% endif %}
    </twig:Card>
{% endblock %}
