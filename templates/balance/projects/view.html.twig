{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('projects') }}" />

    {% if accountProject %}
        <twig:TopAction
            class="text-danger"
            path="{{ path('projects_deselect', {'projectId': project.id}) }}"
            data-controller="confirm"
            data-confirm-text-param="{{ '¿Está seguro de que desea retirar este proyecto de su cuenta?' | trans }}"
            data-action="confirm#link:prevent"
        >
            <twig:Icon name="solar:close-square-line-duotone" size="lg" class="me-2" />
            {{ 'Retirar de mi cuenta' | trans }}
        </twig:TopAction>
    {% else %}
        <twig:TopAction path="{{ path('projects_select', {'projectId': project.id}) }}">
            <twig:Icon name="solar:heart-line-duotone" size="lg" class="me-2" />
            {{ 'Adherir a mi cuenta' | trans }}
        </twig:TopAction>
    {% endif %}
{% endblock %}

{% set page_title = ('Proyectos' | trans) ~ ' > ' ~ project.name %}

{% block content %}
    <twig:Card>
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h4 class="mb-1">{{ project.name }}</h4>
            </div>

            <div class="d-flex gap-2">
                {% if project.projectType and project.projectType.value == 'emission_compensation' %}
                    <a href="{{ path('credit_purchases_request', {'projectId': project.id}) }}" class="btn btn-primary">
                        <twig:Icon name="solar:leaf-line-duotone" size="lg" />
                        {{ 'Solicitar créditos' | trans }}
                    </a>
                {% endif %}
            </div>
        </div>

        {% if accountProject %}
            <p class="text-muted mt-3 mb-0">
                {{ 'Adherido a su cuenta desde el' | trans }} {{ accountProject.selectedAt | date('d/m/Y') }}
            </p>
        {% endif %}

        {% if creditBalance and creditBalance.purchasesCount > 0 %}
            <dl class="row text-muted mt-3 mb-0">
                <dt class="col-sm-3 fw-normal">{{ 'Compradas' | trans }}</dt>
                <dd class="col-sm-3">{{ creditBalance.purchasedTonnes | number_format(4, ',', '.') }} t</dd>

                <dt class="col-sm-3 fw-normal">{{ 'Reservadas' | trans }}</dt>
                <dd class="col-sm-3">{{ reservedTonnes | number_format(4, ',', '.') }} t</dd>

                <dt class="col-sm-3 fw-normal">{{ 'Consumidas' | trans }}</dt>
                <dd class="col-sm-3">{{ (creditBalance.consumedTonnes - reservedTonnes) | number_format(4, ',', '.') }} t</dd>

                <dt class="col-sm-3 fw-normal">{{ 'Disponibles' | trans }}</dt>
                <dd class="col-sm-3 fw-semibold">{{ creditBalance.availableTonnes | number_format(4, ',', '.') }} t</dd>
            </dl>
        {% endif %}
    </twig:Card>

    {% if project.projectType and project.projectType.value == 'emission_compensation' %}
        <twig:Card title="{{ 'Transacciones de créditos' | trans }}">
            {% if creditPurchases is empty %}
                <p class="text-muted mb-0">{{ 'Este proyecto no tiene transacciones de créditos' | trans }}</p>
            {% else %}
                {% set columns = [
                    {
                        'label': 'Solicitadas' | trans,
                    }, {
                        'label': 'Compradas' | trans,
                    }, {
                        'label': 'Importe' | trans,
                    }, {
                        'label': 'Identificador' | trans,
                    }, {
                        'label': 'Estado' | trans,
                    }, {
                        'label': 'Fecha de solicitud' | trans,
                    }, {
                        'label': ''
                    },
                ] %}

                <twig:List:Table :columns="columns" :elements="creditPurchases">
                    <td>{{ element.requestedTonnes }}</td>
                    <td>{{ element.purchasedTonnes ?? '-' }}</td>
                    <td>{{ element.purchasedTonnes is not null and project.costPerTonne is not null ? ((element.purchasedTonnes * project.costPerTonne) | number_format(2, ',', '.') ~ ' €') : '-' }}</td>
                    <td>{{ element.reference ?? '-' }}</td>
                    <td>
                        {{ element.status.value | trans({}, 'creditPurchaseStatus') }}
                        {% if element.isPartiallyFulfilled %}
                            <span class="badge bg-warning text-dark">{{ 'Parcial' | trans }}</span>
                        {% endif %}
                    </td>
                    <td>{{ element.requestedAt | date('d/m/Y') }}</td>
                    <td>
                        {% if element.status.value == 'pending' %}
                            <a href="{{ path('credit_purchases_cancel', {'creditPurchaseId': element.id}) }}"
                               class="btn btn-sm btn-outline-danger"
                               data-controller="confirm"
                               data-confirm-text-param="{{ '¿Está seguro de que desea cancelar esta solicitud?' | trans }}"
                               data-action="confirm#link:prevent">
                                {{ 'Cancelar' | trans }}
                            </a>
                        {% endif %}
                    </td>
                </twig:List:Table>
            {% endif %}
        </twig:Card>
    {% endif %}

    <twig:Card title="{{ 'Información' | trans }}">
        <dl class="row mb-0">
            {% if project.location %}
                <dt class="col-sm-3">{{ 'Localización' | trans }}</dt>
                <dd class="col-sm-9">{{ project.location | destination_name }}</dd>
            {% endif %}

            {% if project.projectType %}
                <dt class="col-sm-3">{{ 'Tipo de proyecto' | trans }}</dt>
                <dd class="col-sm-9">{{ project.projectType.value | trans({}, 'projectType') }}</dd>
            {% endif %}

            {% if project.projectStatus %}
                <dt class="col-sm-3">{{ 'Estado del proyecto' | trans }}</dt>
                <dd class="col-sm-9">{{ project.projectStatus.value | trans({}, 'projectStatusType') }}</dd>
            {% endif %}

            {% if project.mitecoId %}
                <dt class="col-sm-3">{{ 'Código Registro Miteco' | trans }}</dt>
                <dd class="col-sm-9">{{ project.mitecoId }}</dd>
            {% endif %}

            <dt class="col-sm-3">{{ 'Fecha de alta' | trans }}</dt>
            <dd class="col-sm-9">{{ project.registeredAt | date('d/m/Y') }}</dd>
        </dl>
    </twig:Card>

    {% if gallery is not empty %}
        <twig:Card title="{{ 'Galería' | trans }}">
            <div class="row g-2">
                {% for media in gallery %}
                    <div class="col-6 col-md-3">
                        <a href="{{ path('library_media_show', {'mediaId': media.id}) }}" target="_blank">
                            <img src="{{ path('library_media_show', {'mediaId': media.id}) }}"
                                 alt="{{ media.alternativeText | default(media.name) }}"
                                 class="rounded w-100"
                                 style="height: 150px; object-fit: cover;">
                        </a>
                    </div>
                {% endfor %}
            </div>
        </twig:Card>
    {% else %}
        <twig:Card>
            <p class="text-muted mb-0">{{ 'Este proyecto no tiene imágenes' | trans }}</p>
        </twig:Card>
    {% endif %}

    {% if project.description %}
        <twig:Card title="{{ 'Descripción' | trans }}">
            {{ project.description | md_to_html }}
        </twig:Card>
    {% endif %}
{% endblock %}
