{% extends '@shared/layout/edit.html.twig' %}

{% set page_title = ('Compras de créditos de CO2' | trans) ~ ' > ' ~ ('Validar' | trans) %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('admin_credit_purchases') }}" />
{% endblock %}

{% block content %}
    {% set project = creditPurchase.projectId | project_name %}

    <twig:Card title="{{ 'Solicitud' | trans }}">
        <dl class="row mb-0">
            <dt class="col-sm-3">{{ 'Cuenta' | trans }}</dt>
            <dd class="col-sm-9">{{ creditPurchase.accountId | account_name }}</dd>

            <dt class="col-sm-3">{{ 'Proyecto' | trans }}</dt>
            <dd class="col-sm-9">{{ project }}</dd>

            {% if project and project.mitecoId %}
                <dt class="col-sm-3">{{ 'Código Registro Miteco' | trans }}</dt>
                <dd class="col-sm-9">{{ project.mitecoId }}</dd>
            {% endif %}

            <dt class="col-sm-3">{{ 'Toneladas solicitadas' | trans }}</dt>
            <dd class="col-sm-9">{{ creditPurchase.requestedTonnes }}</dd>

            {% if project and project.costPerTonne is not null %}
                <dt class="col-sm-3">{{ 'Coste por tonelada' | trans }}</dt>
                <dd class="col-sm-9">{{ project.costPerTonne | number_format(2, ',', '.') }} €</dd>
            {% endif %}

            {% set requestedQuote = creditPurchase.requestedQuote %}

            {% if requestedQuote %}
                <dt class="col-sm-3">{{ 'Base imponible' | trans }}</dt>
                <dd class="col-sm-9">{{ requestedQuote.taxableAmount | number_format(2, ',', '.') }} €</dd>

                <dt class="col-sm-3">{{ 'IVA' | trans }} ({{ requestedQuote.vatRate | number_format(2, ',', '.') }} %)</dt>
                <dd class="col-sm-9">
                    {{ requestedQuote.vatAmount | number_format(2, ',', '.') }} €
                    <span class="d-block text-muted small">{{ ('vat.reason.' ~ requestedQuote.vatReason.value) | trans }}</span>
                </dd>

                <dt class="col-sm-3 fw-semibold">{{ 'Total solicitado' | trans }}</dt>
                <dd class="col-sm-9 fw-semibold">{{ requestedQuote.totalAmount | number_format(2, ',', '.') }} €</dd>
            {% endif %}
        </dl>
    </twig:Card>

    {% set billing = creditPurchase.billing %}

    {% if billing %}
        <twig:Card title="{{ 'Datos de facturación' | trans }}">
            <dl class="row mb-0">
                <dt class="col-sm-3">{{ 'Razón social' | trans }}</dt>
                <dd class="col-sm-9">{{ billing.legalName }}</dd>

                <dt class="col-sm-3">{{ 'NIF / CIF' | trans }}</dt>
                <dd class="col-sm-9">{{ billing.taxId }}</dd>

                <dt class="col-sm-3">{{ 'Dirección' | trans }}</dt>
                <dd class="col-sm-9">{{ billing.street }}</dd>

                <dt class="col-sm-3">{{ 'Código postal' | trans }}</dt>
                <dd class="col-sm-9">{{ billing.postalCode }}</dd>

                <dt class="col-sm-3">{{ 'Ciudad' | trans }}</dt>
                <dd class="col-sm-9">{{ billing.city }}</dd>

                <dt class="col-sm-3">{{ 'País' | trans }}</dt>
                <dd class="col-sm-9">{{ billing.country }}</dd>

                <dt class="col-sm-3">{{ 'Email para recibir la factura' | trans }}</dt>
                <dd class="col-sm-9">{{ billing.email }}</dd>
            </dl>
        </twig:Card>
    {% endif %}

    {{ form_start(form) }}

    <twig:Card title="{{ 'Validación' | trans }}">
        {{ form_row(form.purchasedTonnes) }}
        {{ form_row(form.paymentType) }}
        {{ form_row(form.reference) }}
        {{ form_row(form.certificate) }}
    </twig:Card>

    <twig:Card>
        <twig:ActionBar>
            <twig:ActionBar:Button type="primary" :button="form.saveAndReturn" />
        </twig:ActionBar>
    </twig:Card>

    {{ form_end(form) }}
{% endblock %}
