{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Convenios de donación' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Entidad receptora' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de inicio' | trans,
            'sortable': true,
            'sortableBy': 'startDate'
        }, {
            'label': 'Fecha de expiración' | trans,
            'sortable': true,
            'sortableBy': 'expirationDate'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="donationAgreements">
        <td>{{ element.recipientOrganizationId | recipient_organization_name }}</td>
        <td>{{ element.startDate | date('d/m/Y') }}</td>
        <td>{{ element.expirationDate | date('d/m/Y') }}</td>
        <td>
            <twig:List:Action:Download path="{{ path('donation_agreements_download', {'donationAgreementId': element.id}) }}" />
            
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('donation_agreements_edit', {'donationAgreementId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('donation_agreements_remove', {'donationAgreementId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('donation_agreements_register') }}" />
{% endblock list_actions %}
