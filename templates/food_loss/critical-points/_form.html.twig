<twig:Card title="{{ 'Datos generales' | trans }}" class="mb-4">
    <div class="row">
        <div class="col-12">
            {{ form_row(form.name) }}
        </div>
        <div class="col-12">
            {{ form_row(form.propertyId) }}
        </div>
        <div class="col-12">
            {{ form_row(form.supplyChainStage) }}
        </div>
        <div class="col-12">
            {{ form_row(form.serviceCategoryIds) }}
        </div>
        <div class="col-12">
            {{ form_row(form.surplusCauseIds) }}
        </div>
    </div>
</twig:Card>

