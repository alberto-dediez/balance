{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Puntos Críticos' | trans)
    ~ ' > '
    ~ ('Registrar' | trans)  %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('critical_points') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}

    {% include '@food_loss/critical-points/_form.html.twig' %}

    <twig:Card>
        <twig:ActionBar>
            <twig:ActionBar:Button type="primary" :button="form.register" />
        </twig:ActionBar>
    </twig:Card>

    {{ form_end(form)}}
{% endblock %}
