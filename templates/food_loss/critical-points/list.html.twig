{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Puntos Críticos' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Propiedad' | trans,
        }, {
            'label': 'Etapa' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="criticalPoints" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.propertyId | property_name }}</td>
        <td>{{ element.supplyChainStage.value | trans([], 'supplyChainStage') }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('critical_points_edit', {'criticalPointId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('critical_points_remove', {'criticalPointId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('critical_points_register') }}" />
{% endblock list_actions %}
