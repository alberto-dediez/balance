{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Dashboard de puntos críticos' | trans %}

{% block content %}
    <twig:Card class="mb-3">
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>

    <div class="row">
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-primary-subtle text-primary rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="ph:cooking-pot-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalCriticalPoints }}</h4>
                        <span class="text-muted">{% trans %}Puntos críticos{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-success-subtle text-success rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:shield-check-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.preventionPossibleCriticalPoints }}</h4>
                        <span class="text-muted">{% trans %}Con prevención posible{% endtrans %}</span>
                        <div class="text-success fs-2">{{ dashboard.preventionPossiblePercentage }} %</div>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-danger-subtle text-danger rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:danger-triangle-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.eliminationOnlyCriticalPoints }}</h4>
                        <span class="text-muted">{% trans %}Solo eliminación{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-info-subtle text-info rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:buildings-2-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.coveredProperties }}</h4>
                        <span class="text-muted">{% trans %}Propiedades cubiertas{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
    </div>

    {% if dashboard.totalCriticalPoints == 0 %}
        <twig:Alert type="info">{% trans %}No hay puntos críticos para los filtros seleccionados{% endtrans %}</twig:Alert>
    {% else %}
        <div class="row">
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Puntos críticos por etapa de la cadena' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Donut
                        title="{{ 'Puntos críticos' | trans }}"
                        :values="dashboard.bySupplyChainStage.values"
                        :categories="dashboard.bySupplyChainStage.labels | map(label => label | trans({}, 'supplyChainStage'))"
                        :decimals="0"
                        :legend="true"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Posibilidades de aprovechamiento por punto crítico' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Puntos críticos' | trans }}"
                        :values="dashboard.byPriority.values"
                        :categories="dashboard.byPriority.labels | map(label => label | trans({}, 'priorityType'))"
                        :colors="dashboard.byPriority.colors"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Puntos críticos por propiedad' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Puntos críticos' | trans }}"
                        :values="dashboard.byProperty.values"
                        :categories="dashboard.byProperty.labels"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Puntos críticos por categoría de servicio' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Puntos críticos' | trans }}"
                        :values="dashboard.byServiceCategory.values"
                        :categories="dashboard.byServiceCategory.labels"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}
