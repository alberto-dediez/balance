{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    {% if dummy | is_authorized('register') %}
        <twig:TopAction path="{{ path('training_attendances_request_signature', {'trainingSessionId': trainingSession.id}) }}">
            <twig:Icon name="solar:pen-new-square-line-duotone" size="lg" class="me-2" />

            {{ 'Solicitar firma' | trans }}
        </twig:TopAction>

        <twig:TopAction path="{{ path('training_attendances_register', {'trainingSessionId': trainingSession.id}) }}">
            <twig:Icon name="solar:add-square-line-duotone" size="lg" class="me-2" />

            {{ 'Subir hoja de asistencia' | trans }}
        </twig:TopAction>
    {% endif %}

    <twig:TopAction:Return path="{{ path('training_sessions') }}" />
{% endblock %}

{% set page_title = ('Sesiones formativas' | trans)
    ~ ' > '
    ~ ('Detalles' | trans)
    ~ ' > '
    ~ trainingSession.title %}

{% block content %}
    <twig:Card>
        <div class="row">
            <div class="col-12">
                <dl class="row mb-0 ps-4">
                    <dt class="col-sm-3">{{ 'Fecha de la sesión' | trans }}</dt>
                    <dd class="col-sm-9">{{ trainingSession.sessionDate | date('d/m/Y') }}</dd>

                    <dt class="col-sm-3">{{ 'Título' | trans }}</dt>
                    <dd class="col-sm-9">{{ trainingSession.title }}</dd>

                    <dt class="col-sm-3">{{ 'Tema' | trans }}</dt>
                    <dd class="col-sm-9">{{ trainingSession.topic }}</dd>
                </dl>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                {% set columns = [
                    {'label': 'Nombre' | trans},
                    {'label': 'email' | trans},
                    {'label': 'Estado' | trans},
                    {'label': 'Evidencias' | trans},
                ] %}

                <twig:List:Table :columns="columns" :elements="summaries">
                    <td class="col-5">{{ element.employee.name }}</td>
                    <td class="col-5">{{ element.employee.email }}</td>
                    <td class="col-2">
                        {% if element.hasAttended %}
                            <span class="badge bg-success">{{ 'Asistió' | trans }}</span>
                        {% elseif element.isInSignatureProcess %}
                            <span class="badge bg-info text-white">{{ 'Firma pendiente' | trans }}</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">{{ 'No asistió' | trans }}</span>
                        {% endif %}
                    </td>
                    <td class="col-3">
                        {% for attendance in element.attendances %}
                            <div class="d-flex align-items-center gap-2 mb-1">
                                {% if attendance.isInSignatureProcess %}
                                    {% if attendance | is_authorized('edit') %}
                                        <twig:List:Action:CancelSignature path="{{ path('training_attendances_cancel_signature', {'trainingSessionId': trainingSession.id, 'trainingAttendanceId': attendance.id}) }}" />
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted small">{{ attendance.attendedAt | date('d/m/Y') }}</span>

                                    {% if attendance.filePath and attendance | is_authorized('view') %}
                                        <twig:List:Action:Download path="{{ path('training_attendances_download', {'trainingSessionId': trainingSession.id, 'trainingAttendanceId': attendance.id}) }}" target="_blank" />
                                    {% endif %}

                                    {% if attendance | is_authorized('remove') %}
                                        <twig:List:Action:Delete path="{{ path('training_attendances_remove', {'trainingSessionId': trainingSession.id, 'trainingAttendanceId': attendance.id}) }}" />
                                    {% endif %}
                                {% endif %}
                            </div>
                        {% endfor %}
                    </td>
                </twig:List:Table>
            </div>
        </div>
    </twig:Card>
{% endblock %}
