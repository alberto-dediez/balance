{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Excepciones Doggy Bag' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Descripción' | trans,
            'sortable': true,
            'sortableBy': 'description'
        }, {
            'label': 'Punto Crítico' | trans
        }, {
            'label': 'Propiedad' | trans
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="doggyBagExceptions" :bulkForm="bulkForm">
        <td>{{ element.description }}</td>
        <td>
            {% set criticalPoint = element.criticalPointId | critical_point_name %}

            {% if criticalPoint is not empty %}
                {{ criticalPoint.name }}
            {% endif %}
        </td>
        <td>
            {% if criticalPoint is not empty %}
                {{ criticalPoint.propertyId | property_name }}
            {% endif %}
        </td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('doggy_bag_exceptions_edit', {'doggyBagExceptionId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('doggy_bag_exceptions_remove', {'doggyBagExceptionId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('doggy_bag_exceptions_register') }}" />
{% endblock list_actions %}
