{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Causas de excedente' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': 'Fecha de actualización' | trans,
            'sortable': true,
            'sortableBy': 'updatedAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="surplusCauses" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>{{ element.updatedAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('admin_surplus_causes_edit', {'surplusCauseId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('admin_surplus_causes_remove', {'surplusCauseId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_surplus_causes_register') }}" />
{% endblock list_actions %}
