{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Dashboard de incidencias' | trans %}

{% block content %}
    <twig:Card class="mb-3">
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>

    <div class="row">
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-primary-subtle text-primary rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:shield-warning-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalIncidences }}</h4>
                        <span class="text-muted">{% trans %}Incidencias{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-warning-subtle text-warning rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:danger-triangle-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">
                            {% if dashboard.mostFrequentIncidenceType %}
                                {{ dashboard.mostFrequentIncidenceType | trans({}, 'incidenceType') }}
                            {% else %}
                                &mdash;
                            {% endif %}
                        </h4>
                        <span class="text-muted">{% trans %}Tipo más frecuente{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-success-subtle text-success rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:check-circle-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.withEvidencesIncidences }}</h4>
                        <span class="text-muted">{% trans %}Con evidencias{% endtrans %}</span>
                        <div class="text-success fs-2">{{ dashboard.withEvidencesPercentage }} %</div>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-info-subtle text-info rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:buildings-2-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.affectedProperties }}</h4>
                        <span class="text-muted">{% trans %}Propiedades afectadas{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
    </div>

    {% if dashboard.totalIncidences == 0 %}
        <twig:Alert type="info">{% trans %}No hay incidencias para los filtros seleccionados{% endtrans %}</twig:Alert>
    {% else %}
        <div class="row">
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Incidencias por tipo' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Donut
                        title="{{ 'Incidencias' | trans }}"
                        :values="dashboard.byType.values"
                        :categories="dashboard.byType.labels | map(label => label | trans({}, 'incidenceType'))"
                        :decimals="0"
                        :legend="true"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Incidencias por mes' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Line
                        title="{{ 'Incidencias' | trans }}"
                        :values="dashboard.incidencesByMonth.values"
                        :categories="dashboard.incidencesByMonth.labels"
                        :decimals="0"
                        :dataLabels="true"
                    />
                </twig:Card>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Incidencias por propiedad' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Incidencias' | trans }}"
                        :values="dashboard.byProperty.values"
                        :categories="dashboard.byProperty.labels"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Excedentes por incidencia' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Excedentes' | trans }}"
                        :values="dashboard.surplusByIncidence.values"
                        :categories="dashboard.surplusByIncidence.labels"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}
