{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Incidencias' | trans)
    ~ ' > '
    ~ ('Registrar' | trans)  %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('incidences') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.exceptionOccurredOn) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.incidenceType) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.propertyId) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.description) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.effect) }}
                </div>
            </div>

            <label class="form-label">{{ 'Evidencias' | trans }}</label>

            {% set columns = [
                {label: 'Fichero' | trans},
            ] %}

            <twig:Collection:Table :columns="columns" :elements="form.evidences" :proto="form.evidences.vars.prototype">
                <td class="col-10">
                    {{ form_widget(element.id) }}
                    {{ form_widget(element.file) }}
                    {{ form_errors(element.file) }}
                </td>
            </twig:Collection:Table>

            {{ form_errors(form.evidences) }}

            <twig:ActionBar>
                <twig:ActionBar:Button type="primary" :button="form.register" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form) }}
{% endblock %}
