{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('incidences') }}" />
{% endblock %}

{% set page_title = ('Incidencias' | trans)
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ incidence.name %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.exceptionOccurredOn) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.incidenceType) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.propertyId) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.description) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.effect) }}
                </div>
            </div>

            <label class="form-label">{{ 'Evidencias' | trans }}</label>

            {% set columns = [
                {label: 'Fichero' | trans},
                {label: 'Descargar' | trans},
            ] %}

            <twig:Collection:Table :columns="columns" :elements="form.evidences" :proto="form.evidences.vars.prototype">
                {% if element.vars.data is not null and element.vars.data.id is not null %}
                    <td class="col-10">
                        {{ form_widget(element.id) }}
                        {{ element.vars.data.originalName }}

                        <div class="d-none">{{ form_widget(element.file) }}</div>
                    </td>
                    <td class="col-2">
                        <a
                            href="{{ path('incidences_evidence_download', {incidenceId: incidence.id, evidenceId: element.vars.data.id}) }}"
                            class="btn btn-sm btn-outline-info"
                        >
                            <twig:Icon name="solar:download-minimalistic-outline" />
                        </a>
                    </td>
                {% else %}
                    <td class="col-10">
                        {{ form_widget(element.id) }}
                        {{ form_widget(element.file) }}
                        {{ form_errors(element.file) }}
                    </td>
                    <td class="col-2"></td>
                {% endif %}
            </twig:Collection:Table>

            {{ form_errors(form.evidences) }}

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form) }}
{% endblock %}
