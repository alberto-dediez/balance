{% extends '@shared/layout/action.html.twig' %}

{% set page_title = ('Protocolos' | trans)
    ~ ' > '
    ~ (protocolId | protocol_name)
    ~ ' > '
    ~ ('Accesos de empleados' | trans)
    ~ ' > '
    ~ employee.name %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('protocols_accesses', {'protocolId': protocolId}) }}" />
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>{{ 'Usuario' | trans }}</th>
                        <th>{{ 'Protocolo' | trans }}</th>
                        <th>{{ 'Fecha de acceso' | trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for access in accesses %}
                        <tr>
                            <td>{{ access.employeeId | employee_name }}</td>
                            <td>{{ access.protocolId | protocol_name }}</td>
                            <td>{{ access.accessedAt | date('d/m/Y H:i:s') }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted">{{ 'Este empleado no ha accedido al protocolo.' | trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
