{% extends '@shared/layout/action.html.twig' %}

{% set page_title = ('Protocolos' | trans)
    ~ ' > '
    ~ (protocolId | protocol_name)
    ~ ' > '
    ~ ('Accesos de empleados' | trans) %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('protocols') }}" />
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>{{ 'Protocolo' | trans }}</th>
                        <th>{{ 'Empleado' | trans }}</th>
                        <th>{{ 'Email' | trans }}</th>
                        <th>{{ 'Último acceso' | trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for summary in summaries %}
                        <tr>
                            <td>{{ protocolId | protocol_name }}</td>
                            <td>{{ summary.employee.name }}</td>
                            <td>{{ summary.employee.email }}</td>
                            <td>
                                {% if summary.lastAccessedAt %}
                                    {{ summary.lastAccessedAt | date('d/m/Y H:i') }}
                                {% else %}
                                    <span class="badge bg-warning text-dark">{{ 'Sin acceso' | trans }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if summary.lastAccessedAt %}
                                    <twig:List:Action:View path="{{ path('protocols_employee_access_history', {'protocolId': protocolId, 'employeeId': summary.employee.id}) }}" />
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">{{ 'No hay empleados registrados.' | trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
