{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Protocolos' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Descripción' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="protocols">
        <td>{{ element.name }}</td>
        <td>{{ element.description }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            <twig:List:Action:Download path="{{ path('protocols_download', {'protocolId': element.id}) }}" />

            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('protocols_edit', {'protocolId': element.id}) }}" />
            {% endif %}

            {% if is_granted('ROLE_OWNER') %}
                <twig:List:Action path="{{ path('protocols_accesses', {'protocolId': element.id}) }}"
                                  title="{{ 'Accesos' | trans }}"
                >
                    <twig:Icon name="solar:chart-square-line-duotone" size="lg" />
                </twig:List:Action>
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('protocols_remove', {'protocolId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    {% if dummy | is_authorized('register') %}
        <twig:Link:Register path="{{ path('protocols_register') }}" />
    {% endif %}
{% endblock list_actions %}
