{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Sesiones formativas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Fecha' | trans,
            'sortable': true,
            'sortableBy': 'sessionDate'
        }, {
            'label': 'Título' | trans,
            'sortable': false
        }, {
            'label': 'Tema' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': 'Asistencia' | trans,
            'sortable': false
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="trainingSessions">
        <td>{{ element.sessionDate | date('d/m/Y') }}</td>
        <td>{{ element.title }}</td>
        <td>{{ element.topic }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% set myAttendance = myAttendances[element.id] ?? null %}
            {% if myAttendance %}
                <span class="text-success" title="{{ 'He asistido' | trans }}" data-bs-toggle="tooltip">
                    <twig:Icon name="solar:check-circle-bold-duotone" size="lg"/>
                </span>

                {% if myAttendance.filePath %}
                    <twig:List:Action:DownloadEvidence path="{{ path('training_attendances_download', {'trainingSessionId': element.id, 'trainingAttendanceId': myAttendance.id}) }}" />
                {% endif %}
            {% else %}
                <span class="text-danger" title="{{ 'No he asistido' | trans }}" data-bs-toggle="tooltip">
                    <twig:Icon name="solar:close-circle-bold-duotone" size="lg" />
                </span>
            {% endif %}
        </td>
        <td>
            {% if dummyAttendance | is_authorized('view') %}
                <twig:List:Action:View path="{{ path('training_attendances', {'trainingSessionId': element.id}) }}" />
            {% endif %}

            {% if dummyAttendance | is_authorized('register') %}
                <twig:List:Action:Upload path="{{ path('training_attendances_register', {'trainingSessionId': element.id}) }}" title="{{ 'Subir hoja de asistencia' | trans }}" />
            {% endif %}

            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('training_sessions_edit', {'trainingSessionId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('training_sessions_remove', {'trainingSessionId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    {% if dummy | is_authorized('register') %}
        <twig:Link:Register path="{{ path('training_sessions_register') }}" />
    {% endif %}
{% endblock list_actions %}
