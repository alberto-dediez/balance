{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Gestores de residuos' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Alimentación animal' | trans,
            'sortable': false
        }, {
            'label': 'Subproductos orgánicos' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="wasteManagers" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.animalFeedAuthorized ? 'Sí' | trans : 'No' | trans }}</td>
        <td>{{ element.compostAuthorized ? 'Sí' | trans : 'No' | trans }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('food_waste_managers_edit', {'wasteManagerId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('food_waste_managers_remove', {'wasteManagerId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('food_waste_managers_register') }}" />
{% endblock list_actions %}
