{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Inicio' | trans %}

{% block content %}
    <twig:Card class="mb-3">
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>





    <div class="row">
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-primary-subtle text-primary rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:checklist-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalActions }}</h4>
                        <span class="text-muted">{% trans %}Acciones{% endtrans %}</span>
                        <div class="fs-2">
                            <a href="{{ path('admin_actions') }}">{% trans %}Ver acciones{% endtrans %}</a>
                        </div>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-danger-subtle text-danger rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:shield-warning-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalReasons }}</h4>
                        <span class="text-muted">{% trans %}Motivos{% endtrans %}</span>
                        <div class="fs-2">
                            <a href="{{ path('admin_reasons') }}">{% trans %}Ver motivos{% endtrans %}</a>
                        </div>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-success-subtle text-success rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:tag-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalServiceCategories }}</h4>
                        <span class="text-muted">{% trans %}Categorías de servicio{% endtrans %}</span>
                        <div class="fs-2">
                            <a href="{{ path('admin_service_categories') }}">{% trans %}Ver categorías{% endtrans %}</a>
                        </div>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-warning-subtle text-warning rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:cart-large-minimalistic-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalSurplusCauses }}</h4>
                        <span class="text-muted">{% trans %}Causas de excedente{% endtrans %}</span>
                        <div class="fs-2">
                            <a href="{{ path('admin_surplus_causes') }}">{% trans %}Ver causas{% endtrans %}</a>
                        </div>
                    </div>
                </div>
            </twig:Card>
        </div>
    </div>

    <div class="row">
        {% if dashboard.actionsByPriority.values is not empty %}
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Acciones por prioridad' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Donut
                        title="{{ 'Acciones' | trans }}"
                        :values="dashboard.actionsByPriority.values"
                        :categories="dashboard.actionsByPriority.labels | map(label => label | trans({}, 'priorityType'))"
                        :decimals="0"
                        :legend="true"
                    />
                </twig:Card>
            </div>
        {% endif %}

        <div class="col-lg-{{ dashboard.actionsByPriority.values is not empty ? 6 : 12 }} d-flex">
            <div class="row">
                <div class="col-sm-6 d-flex">
                    <twig:Card class="mb-3 flex-fill">
                        <div class="d-flex align-items-center gap-3">
                            <span class="bg-primary-subtle text-primary rounded-2 p-2 d-inline-flex">
                                <twig:Icon name="solar:buildings-2-line-duotone" size="xl" />
                            </span>
                            <div>
                                <h4 class="mb-0 fw-semibold">{{ dashboard.totalProperties }}</h4>
                                <span class="text-muted">{% trans %}Propiedades{% endtrans %}</span>
                                <div class="fs-2">
                                    <a href="{{ path('admin_properties') }}">{% trans %}Ver propiedades{% endtrans %}</a>
                                </div>
                            </div>
                        </div>
                    </twig:Card>
                </div>
                <div class="col-sm-6 d-flex">
                    <twig:Card class="mb-3 flex-fill">
                        <div class="d-flex align-items-center gap-3">
                            <span class="bg-info-subtle text-info rounded-2 p-2 d-inline-flex">
                                <twig:Icon name="solar:case-line-duotone" size="xl" />
                            </span>
                            <div>
                                <h4 class="mb-0 fw-semibold">{{ dashboard.totalCompanies }}</h4>
                                <span class="text-muted">{% trans %}Empresas{% endtrans %}</span>
                                <div class="fs-2">
                                    <a href="{{ path('admin_companies') }}">{% trans %}Ver empresas{% endtrans %}</a>
                                </div>
                            </div>
                        </div>
                    </twig:Card>
                </div>

                <div class="col-sm-6 d-flex">
                    <twig:Card class="mb-3 flex-fill">
                        <div class="d-flex align-items-center gap-3">
                            <span class="bg-success-subtle text-success rounded-2 p-2 d-inline-flex">
                                <twig:Icon name="solar:buildings-3-line-duotone" size="xl" />
                            </span>
                            <div>
                                <h4 class="mb-0 fw-semibold">{{ dashboard.totalAccounts }}</h4>
                                <span class="text-muted">{% trans %}Cuentas{% endtrans %}</span>
                                <div class="text-muted fs-2">{{ dashboard.activeAccounts }} {% trans %}activas{% endtrans %}</div>
                                <div class="fs-2">
                                    <a href="{{ path('admin_accounts') }}">{% trans %}Ver cuentas{% endtrans %}</a>
                                </div>
                            </div>
                        </div>
                    </twig:Card>
                </div>
                <div class="col-sm-6 d-flex">
                    <twig:Card class="mb-3 flex-fill">
                        <div class="d-flex align-items-center gap-3">
                            <span class="bg-warning-subtle text-warning rounded-2 p-2 d-inline-flex">
                                <twig:Icon name="solar:users-group-rounded-line-duotone" size="xl" />
                            </span>
                            <div>
                                <h4 class="mb-0 fw-semibold">{{ dashboard.totalUsers }}</h4>
                                <span class="text-muted">{% trans %}Usuarios{% endtrans %}</span>
                                <div class="fs-2">
                                    <a href="{{ path('admin_users') }}">{% trans %}Ver usuarios{% endtrans %}</a>
                                </div>
                            </div>
                        </div>
                    </twig:Card>
                </div>
                <div class="col-sm-6 d-flex">
                    <twig:Card class="mb-3 flex-fill">
                        <div class="d-flex align-items-center gap-3">
                            <span class="bg-danger-subtle text-danger rounded-2 p-2 d-inline-flex">
                                <twig:Icon name="solar:user-id-line-duotone" size="xl" />
                            </span>
                            <div>
                                <h4 class="mb-0 fw-semibold">{{ dashboard.totalEmployees }}</h4>
                                <span class="text-muted">{% trans %}Empleados{% endtrans %}</span>
                                <div class="fs-2">
                                    <a href="{{ path('admin_employees') }}">{% trans %}Ver empleados{% endtrans %}</a>
                                </div>
                            </div>
                        </div>
                    </twig:Card>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}
