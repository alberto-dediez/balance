{% extends '@shared/layout/wizard.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('prevention_plans') }}" />
{% endblock %}

{% set page_title = ('Planes de Prevención' | trans)
    ~ ' > '
    ~ ('Acciones' | trans)
    ~ ' > '
    ~ preventionPlan %}

{% set wizard_steps = [
    {label: 'General'  | trans, href: path('prevention_plans_edit',    {preventionPlanId: preventionPlan.id})},
    {label: 'Acciones' | trans, href: path('prevention_plans_actions',  {preventionPlanId: preventionPlan.id})},
    {label: 'Borrador' | trans, href: '#panel-draft'},
    {label: 'Publicar' | trans, href: '#panel-publish'},
] %}
{% set wizard_active = 2 %}

{% block wizard_panels %}
    <div class="d-flex flex-column align-items-center justify-content-center py-5 gap-3"
         data-status-url="{{ statusUrl }}">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">{{ 'Cargando...' | trans }}</span>
        </div>
        <p class="text-muted">{{ 'Generando acciones sugeridas...' | trans }}</p>
    </div>

    <script>
        (function () {
            const container = document.querySelector('[data-status-url]');
            const url = container.dataset.statusUrl;

            function poll() {
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.status !== 'InProgress') {
                            window.location.reload();
                        } else {
                            setTimeout(poll, 2000);
                        }
                    })
                    .catch(function () { setTimeout(poll, 3000); });
            }

            setTimeout(poll, 2000);
        })();
    </script>
{% endblock %}
