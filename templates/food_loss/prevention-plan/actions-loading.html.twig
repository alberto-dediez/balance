{% extends '@food_loss/prevention-plan/actions.html.twig' %}

{% block wizard_panels %}
    <div class="d-flex flex-column align-items-center justify-content-center py-5 gap-3"
         data-status-url="{{ statusUrl }}">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">{{ 'Cargando...' | trans }}</span>
        </div>
        <p class="text-muted">{{ 'Generando acciones sugeridas...' | trans }}</p>
    </div>

    <script>
        (function () {
            const container = document.querySelector('[data-status-url]');
            const url = container.dataset.statusUrl;

            function poll() {
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.status !== 'InProgress') {
                            window.location.reload();
                        } else {
                            setTimeout(poll, 2000);
                        }
                    })
                    .catch(function () { setTimeout(poll, 3000); });
            }

            setTimeout(poll, 2000);
        })();
    </script>
{% endblock %}
