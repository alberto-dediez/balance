{% extends '@food_loss/prevention-plan/draft.html.twig' %}

{% block wizard_panels %}
    <twig:JobProgress key="{{ preventionPlan.id }}">{{ 'Generando borrador del plan...' | trans }}</twig:JobProgress>

    <script>
        (function () {
            const url = '{{ path('prevention_plans_version_status', {'preventionPlanId': preventionPlan.id}) }}';

            function poll() {
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.is_generated) {
                            window.location.reload();
                        } else {
                            setTimeout(poll, 2000);
                        }
                    })
                    .catch(function () { setTimeout(poll, 3000); });
            }

            setTimeout(poll, 2000);
        })();
    </script>
{% endblock %}
