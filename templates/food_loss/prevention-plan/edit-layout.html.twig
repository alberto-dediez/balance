{% extends '@shared/layout/wizard.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('prevention_plans') }}" />
{% endblock %}

{% block content %}
    {% if preventionPlan is not defined %}
        {% set wizard_steps = [
            {label: 'General'    | trans, href: '#prevention_plans_general' },
            {label: 'Validación' | trans, href: '#prevention_plans_validate' },
            {label: 'Acciones'   | trans, href: '#prevention_plans_actions' },
            {label: 'Borrador'   | trans, href: '#prevention_plans_draft' },
            {label: 'Publicar'   | trans, href: '#prevention_plans_publish' },
        ] %}
    {% else %}
        {% set wizard_steps = [
            {label: 'General'    | trans, href: path('prevention_plans_general',     {preventionPlanId: preventionPlan.id})},
            {label: 'Validación' | trans, href: path('prevention_plans_validate', {preventionPlanId: preventionPlan.id})},
            {label: 'Acciones'   | trans, href: path('prevention_plans_actions',  {preventionPlanId: preventionPlan.id})},
            {label: 'Borrador'   | trans, href: path('prevention_plans_draft',    {preventionPlanId: preventionPlan.id})},
            {label: 'Publicar'   | trans, href: path('prevention_plans_publish', {preventionPlanId: preventionPlan.id})},
        ] %}
    {% endif %}

    {{ parent() }}
{% endblock content %}
