{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Dashboard de planes de prevención' | trans %}

{% block content %}
    <twig:Card class="mb-3">
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>

    <div class="row">
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-primary-subtle text-primary rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:shield-check-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalPreventionPlans }}</h4>
                        <span class="text-muted">{% trans %}Planes de prevención{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-success-subtle text-success rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:check-circle-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.completedPreventionPlans }}</h4>
                        <span class="text-muted">{% trans %}Completados{% endtrans %}</span>
                        <div class="text-success fs-2">{{ dashboard.completedPercentage }} %</div>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-warning-subtle text-warning rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:hourglass-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.inProgressPreventionPlans }}</h4>
                        <span class="text-muted">{% trans %}En curso{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-info-subtle text-info rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:user-check-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.withResponsiblePreventionPlans }}</h4>
                        <span class="text-muted">{% trans %}Con responsable{% endtrans %}</span>
                        <div class="text-info fs-2">{{ dashboard.withResponsiblePercentage }} %</div>
                    </div>
                </div>
            </twig:Card>
        </div>
    </div>

    {% if dashboard.totalPreventionPlans == 0 %}
        <twig:Alert type="info">{% trans %}No hay planes de prevención para los filtros seleccionados{% endtrans %}</twig:Alert>
    {% else %}
        <div class="row">
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Propiedades con plan de prevención' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Donut
                        title="{{ 'Propiedades' | trans }}"
                        :values="dashboard.properties.values"
                        :categories="dashboard.properties.labels | map(label => label | trans)"
                        :decimals="0"
                        :legend="true"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Planes de prevención por estado' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Planes de prevención' | trans }}"
                        :values="dashboard.byStatus.values"
                        :categories="dashboard.byStatus.labels | map(label => label | trans({}, 'preventionPlanVersionStatus'))"
                        :decimals="0"
                        :legend="true"
                    />
                </twig:Card>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Empresas con plan de prevención' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:SemiDonut
                        title="{{ 'Empresas' | trans }}"
                        :values="dashboard.byCompany.values"
                        :categories="dashboard.byCompany.labels | map(label => label | trans)"
                        :decimals="0"
                        :legend="true"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Altas por mes' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Line
                        title="{{ 'Planes de prevención' | trans }}"
                        :values="dashboard.registrationsByMonth.values"
                        :categories="dashboard.registrationsByMonth.labels"
                        :decimals="0"
                        :dataLabels="true"
                    />
                </twig:Card>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}
