{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Planes de Prevención' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Empresa' | trans,
        }, {
            'label': 'Propiedades' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': 'Fecha de actualización' | trans,
            'sortable': true,
            'sortableBy': 'updatedAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="preventionPlans">
        <td>{{ element.name }}</td>
        <td>{{ element.companyId | company_name }}</td>
        <td>
            {% set propertyIds = element.propertyIds %}
            {% if propertyIds | length == 0 %}
                {{ 'Todas las propiedades' | trans }}
            {% elseif propertyIds | length <= 2 %}
                {% for propertyId in propertyIds %}
                    {{ propertyId | property_name }}{% if false == loop.last %},{% endif %}
                {% endfor %}
            {% else %}
                {{ propertyIds[0] | property_name }},
                {{ propertyIds[1] | property_name }},
                ...
            {% endif %}
        </td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>{{ element.updatedAt ? (element.updatedAt | date('d/m/Y')) : '-' }}</td>
        <td>
            {% set lastCompletedVersion = element.lastCompletedVersion %}
            {% if lastCompletedVersion is not null %}
                <twig:List:Action:View path="{{ path('prevention_plans_version_detail', {'preventionPlanId': element.id, 'versionNumber': lastCompletedVersion.versionNumber}) }}" />
            {% endif %}

            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('prevention_plans_edit', {'preventionPlanId': element.id}) }}" />
            {% endif %}

            {% if element.PDF is not null %}
                <twig:List:Action:Download path="{{ path('prevention_plans_download_pdf', {'preventionPlanId': element.id}) }}" />
            {% endif %}

            <twig:List:Action:History path="{{ path('prevention_plans_history', {'preventionPlanId': element.id}) }}" />

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('prevention_plans_remove', {'preventionPlanId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('prevention_plans_register') }}" />
{% endblock list_actions %}
