{% extends '@food_loss/prevention-plan/edit-layout.html.twig' %}

{% set page_title = ('Planes de Prevención' | trans)
    ~ ' > '
    ~ preventionPlan
    ~ ' > '
    ~ ('Borrador' | trans) %}

{% set wizard_active = preventionPlan.status.stepActive.value %}
{% set wizard_selected = 4 %}

{% block wizard_panels %}
    {{ form_start(form) }}

        {% set protoCard %}
            <div class="collection-element card mb-3">
                <div class="card-body">
                    {{ form_widget(form.sections.vars.prototype.sectionId) }}
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        {{ form_widget(form.sections.vars.prototype.title, {attr: {class: 'form-control fw-semibold flex-grow-1 me-2'}}) }}
                        <button type="button" class="btn btn-sm btn-outline-danger" data-action="collection#remove">
                            <twig:Icon name="solar:trash-bin-minimalistic-outline" />
                        </button>
                    </div>
                    {{ form_errors(form.sections.vars.prototype.title) }}
                    <div>
                        {{ form_widget(form.sections.vars.prototype.content) }}
                        {{ form_errors(form.sections.vars.prototype.content) }}
                    </div>
                </div>
            </div>
        {% endset %}

        <div
            data-controller="collection"
            data-collection-prototype-value="{{ protoCard | e('html_attr') }}"
        >
            <div class="collection">
                {% for element in form.sections %}
                    <div class="collection-element card mb-3">
                        <div class="card-body">
                            {{ form_widget(element.sectionId) }}
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                {{ form_widget(element.title, {attr: {class: 'form-control fw-semibold flex-grow-1 me-2'}}) }}
                                <button type="button" class="btn btn-sm btn-outline-danger" data-action="collection#remove">
                                    <twig:Icon name="solar:trash-bin-minimalistic-outline" />
                                </button>
                            </div>
                            {{ form_errors(element.title) }}
                            <div>
                                {{ form_widget(element.content) }}
                                {{ form_errors(element.content) }}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-muted">{{ 'No hay secciones generadas.' | trans }}</p>
                {% endfor %}
            </div>

            <div class="mb-3">
                <button type="button" class="btn btn-outline-info" data-action="collection#add">
                    <twig:Icon name="solar:add-circle-outline" />
                    {% trans %}Añadir sección{% endtrans %}
                </button>
            </div>
        </div>

        <twig:ActionBar>
            <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
            <twig:ActionBar:Button type="primary" :button="form.save" />
        </twig:ActionBar>

    {{ form_end(form) }}
{% endblock %}
