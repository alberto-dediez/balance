{% extends '@food_loss/prevention-plan/edit-layout.html.twig' %}

{% set page_title = ('Planes de Prevención' | trans)
    ~ ' > '
    ~ preventionPlan
    ~ ' > '
    ~ ('Publicar' | trans) %}

{% set wizard_active = preventionPlan.status.stepActive.value %}
{% set wizard_selected = 5 %}

{% block wizard_panels %}
    <div id="panel-publish">

        <dl class="row mb-0">
            <dt class="col-sm-3">{{ 'Nombre' | trans }}</dt>
            <dd class="col-sm-9">{{ preventionPlan.name }}</dd>

            <dt class="col-sm-3">{{ 'Empresa' | trans }}</dt>
            <dd class="col-sm-9">{{ preventionPlan.companyId | company_name }}</dd>

            <dt class="col-sm-3">{{ 'Propiedades' | trans }}</dt>
            <dd class="col-sm-9">
                {% set propertyIds = preventionPlan.propertyIds %}
                {% if propertyIds | length == 0 %}
                    {{ 'Todas las propiedades' | trans }}
                {% else %}
                    {% for propertyId in propertyIds %}
                        {{ propertyId | property_name }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                {% endif %}
            </dd>

            <dt class="col-sm-3">{{ 'Versión' | trans }}</dt>
            <dd class="col-sm-9">{{ preventionPlan.currentVersion }}</dd>

            <dt class="col-sm-3">{{ 'Secciones' | trans }}</dt>
            <dd class="col-sm-9">
                <ul>
                    {% for section in preventionPlan.sections %}
                        <li>{{ section.title }}</li>
                    {% endfor %}
                </ul>
            </dd>

            <dt class="col-sm-3">{{ 'Fecha de última modificación' | trans }}</dt>
            <dd class="col-sm-9 mb-0">{{ preventionPlan.updatedAt | date('d/m/Y') }}</dd>
        </dl>

        <div class="mt-4">
            {% if signatureRequestId is not null %}
                <twig:Alert type="info">
                    {{ 'El plan está pendiente de firma por el responsable. Se ha enviado un correo electrónico con el enlace de firma.' | trans }}
                </twig:Alert>
            {% else %}
                <twig:Alert type="warning">
                    {{ 'Generando el documento PDF. En breve se enviará el enlace de firma al responsable por correo electrónico.' | trans }}
                </twig:Alert>
            {% endif %}
        </div>

    </div>
{% endblock %}
