{% extends '@shared/layout/action.html.twig' %}

{% set page_title = ('Planes de Prevención' | trans)
    ~ ' > '
    ~ preventionPlan.name
    ~ ' > '
    ~ ('Historial de versiones' | trans) %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('prevention_plans') }}" />
{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>{{ 'Versión' | trans }}</th>
                        <th>{{ 'Fecha de creación' | trans }}</th>
                        <th>{{ 'Responsable' | trans }}</th>
                        <th>{{ 'Estado' | trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for version in versions %}
                        <tr>
                            <td>{{ version.versionNumber }}</td>
                            <td>{{ version.createdAt | date('d/m/Y') }}</td>
                            <td>{{ version.responsible | employee_name }}</td>
                            <td>
                                <span class="badge {{ version.status.style }}">{{ version.status.value | trans({}, 'preventionPlanVersionStatus') }}</span>
                            </td>
                            <td class="text-end">
                                <twig:List:Action:View path="{{ path('prevention_plans_version_detail', {preventionPlanId: preventionPlan.id, versionNumber: version.versionNumber}) }}" />
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">{{ 'No hay versiones registradas.' | trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
