{% extends '@food_loss/surpluses/wizard-layout.html.twig' %}

{% set page_title = ('Declaración de excedente' | trans)
    ~ ' > '
    ~ ('Registrar' | trans) %}

{% set wizard_active = 1 %}
{% set wizard_selected = 1 %}

{% block wizard_panels %}
    {{ form_start(form) }}
        <div class="row">
            <div class="col-12">
                {% for field in form %}
                    {% if field.vars.name not in ['register'] %}
                        {{ form_row(field) }}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <twig:ActionBar>
            <twig:ActionBar:Button type="primary" :button="form.register" />
        </twig:ActionBar>
    {{ form_end(form) }}
{% endblock %}
