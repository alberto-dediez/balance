{% extends '@food_loss/surpluses/wizard-layout.html.twig' %}

{% set page_title = ('Declaración de excedente' | trans)
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ surplus.date | date('d/m/Y') %}

{% set wizard_active = 1 %}
{% set wizard_selected = 1 %}

{% block wizard_panels %}
    {{ form_start(form) }}
        <div class="row">
            <div class="col-12">
                {{ form_row(form.date) }}
            </div>
            <div class="col-12">
                {{ form_row(form.serviceCategoryId) }}
            </div>
            <div class="col-12">
                {{ form_row(form.criticalPointId) }}
            </div>
            <div class="col-12">
                {{ form_row(form.foodType) }}
            </div>
            <div class="col-12">
                {{ form_row(form.surplusCauseId) }}
            </div>
            <div class="col-12">
                {{ form_row(form.quantity) }}
            </div>
            <div class="col-12">
                {{ form_row(form.unit) }}
            </div>
            <div class="col-12">
                <twig:View:Field label="{{ 'Fecha de registro' | trans }}">{{ surplus.registeredAt | date('H:i d/m/Y') }}</twig:View:Field>
                <twig:View:Field label="{{ 'Registrado por' | trans }}">{{ surplus.registeredBy | user_name }}</twig:View:Field>
            </div>
        </div>

        <twig:ActionBar>
            <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
            <twig:ActionBar:Button type="primary" :button="form.continue" />
        </twig:ActionBar>
    {{ form_end(form) }}
{% endblock %}
