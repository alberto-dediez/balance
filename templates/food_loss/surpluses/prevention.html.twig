{% extends '@food_loss/surpluses/wizard-layout.html.twig' %}

{% set page_title = ('Declaración de excedente' | trans)
    ~ ' > '
    ~ surplus
    ~ ' > '
    ~ ('Prevención' | trans) %}

{% set wizard_active = 2 %}
{% set wizard_selected = 2 %}

{% block wizard_panels %}
    {{ form_start(form) }}
        <div class="row">
            <div class="col-12">
                {{ form_row(form.canBePrevented) }}
            </div>
            <div class="col-12">
                {{ form_row(form.actionId) }}
            </div>
        </div>

        <twig:ActionBar>
            <div class="col-sm-6 col-md-3 col-lg-2">
                <twig:Link path="{{ path('surpluses_edit', {surplusId: surplus.id}) }}" color="light">
                    {{ 'Volver' | trans }}
                </twig:Link>
            </div>
            <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" offset="offset-lg-6 offset-md-3" />
            <twig:ActionBar:Button type="primary" :button="form.continue" />
        </twig:ActionBar>
    {{ form_end(form) }}
{% endblock %}
