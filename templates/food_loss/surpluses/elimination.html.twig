{% extends '@food_loss/surpluses/wizard-layout.html.twig' %}

{% set page_title = ('Declaración de excedente' | trans)
    ~ ' > '
    ~ surplus
    ~ ' > '
    ~ ('Eliminación' | trans) %}

{% set wizard_active = 7 %}
{% set wizard_selected = 7 %}

{% block wizard_panels %}
    {{ form_start(form) }}
        <div class="row">
            <div class="col-12">
                <twig:Alert type="warning">{{ 'De acuerdo con la normativa vigente, la eliminación del excedente alimentario únicamente está permitida cuando ninguna de las alternativas de valorización previstas en la jerarquía de gestión de alimentos resulte viable.' | trans }}</twig:Alert>
                {{ form_row(form.canBeEliminated) }}
            </div>
        </div>

        <twig:ActionBar>
            <div class="col-sm-6 col-md-3 col-lg-2">
                <twig:Link path="{{ path('surpluses_composting', {surplusId: surplus.id}) }}" color="light">
                    {{ 'Volver' | trans }}
                </twig:Link>
            </div>
            <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" offset="offset-lg-6 offset-md-3" />
            <twig:ActionBar:Button type="primary" :button="form.continue" />
        </twig:ActionBar>
    {{ form_end(form) }}
{% endblock %}
