{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Declaración de excedente' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Fecha' | trans,
            'sortable': true,
            'sortableBy': 'date'
        }, {
            'label': 'Propiedad' | trans,
        }, {
            'label': 'Punto crítico' | trans,
        }, {
            'label': 'Tipo de alimento' | trans,
        }, {
            'label': 'Cantidad' | trans,
        }, {
            'label': 'Destino' | trans,
        }, {
            'label': 'Incidencia' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="surpluses">
        <td>{{ element.date | date('d/m/Y') }}</td>
        {% set criticalPoint = element.criticalPointId | critical_point_name %}
        <td>{{ criticalPoint ? (criticalPoint.propertyId | property_name) : '' }}</td>
        <td>{{ criticalPoint ? criticalPoint.name : '' }}</td>
        <td>{{ element.foodType.value | trans({}, 'foodType') }}</td>
        <td>{{ element.quantity }} {{ element.unit.value | trans({}, 'deliveryLogUnit') }}</td>
        <td>
            {% if element.destination %}
                <span class="badge {{ element.destination.style }}">{{ element.destination.value | trans({}, 'surplusDestination') }}</span>
            {% endif %}
        </td>
        <td>
            {% if element.incidenceId %}
                {% set incidence = element.incidenceId | incidence_name %}
                {% if incidence %}
                    <a href="{{ path('incidences', {}) }}" class="text-decoration-none">{{ incidence.name }}</a>
                {% endif %}
            {% endif %}
        </td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('surpluses_edit', {'surplusId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('surpluses_remove', {'surplusId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('surpluses_register') }}" />
{% endblock list_actions %}
