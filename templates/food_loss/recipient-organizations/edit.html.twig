{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('recipient_organizations') }}" />
{% endblock %}

{% set page_title = ('Entidades Receptoras' | trans)
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ recipientOrganization.name %}

{% block content %}
    {{ form_start(form) }}
        {% include '@food_loss/recipient-organizations/_form.html.twig' %}

        <twig:Card>
            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form) }}
{% endblock %}
