<twig:Card title="{{ 'General' | trans }}">
    <div class="row">
        <div class="col-12">
            {{ form_row(form.name) }}
        </div>
        <div class="col-12">
            {{ form_row(form.type) }}
        </div>
        <div class="col-12">
            {{ form_row(form.nif) }}
        </div>
        <div class="col-12">
            {{ form_row(form.socialReason) }}
        </div>
        <div class="col-12">
            {{ form_row(form.address) }}
        </div>
    </div>
</twig:Card>

<twig:Card title="{{ 'Contacto para recogidas' | trans }}">
    <div class="row">
        <div class="col-12">
            {{ form_row(form.contactName) }}
        </div>
        <div class="col-12">
            {{ form_row(form.contactEmail) }}
        </div>
        <div class="col-12">
            {{ form_row(form.contactPhone) }}
        </div>
        <div class="col-12">
            {{ form_row(form.contactLocale) }}
        </div>
        <div class="col-12">
            {{ form_row(form.contactNotificationChannel) }}
        </div>
        <div class="col-12">
            {{ form_row(form.operatingHours) }}
        </div>
        <div class="col-12">
            {{ form_row(form.pickupTypes) }}
        </div>
    </div>
</twig:Card>
