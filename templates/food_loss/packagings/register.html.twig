{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Envases' | trans)
    ~ ' > '
    ~ ('Registrar' | trans) %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('packagings') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.name) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.packagingType) }}
                </div>
            </div>

            {% if form.stocks | length > 0 %}
                <h5 class="mt-3">{% trans %}Stock por propiedad{% endtrans %}</h5>
                {% set stockColumns = [
                    { 'label': 'Propiedad' | trans },
                    { 'label': 'Stock' | trans },
                ] %}
                <twig:List:Table :columns="stockColumns" :elements="form.stocks">
                    <td>{{ element.vars.data.propertyId | property_name }}</td>
                    <td>
                        {{ form_widget(element.stock) }}
                        {{ form_widget(element.propertyId) }}
                    </td>
                </twig:List:Table>
            {% endif %}

            <twig:ActionBar>
                <twig:ActionBar:Button type="primary" :button="form.register" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form) }}
{% endblock %}
