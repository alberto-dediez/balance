{% extends '@shared/layout/app.html.twig' %}

{% set page_title = 'Dashboard de Doggy Bag' | trans %}

{% block content %}
    <twig:Card class="mb-3">
        <twig:List:FilterBar :form="form"></twig:List:FilterBar>
    </twig:Card>

    <div class="row">
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-primary-subtle text-primary rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:box-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalPackagings }}</h4>
                        <span class="text-muted">{% trans %}Envases{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-success-subtle text-success rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:layers-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalStock }}</h4>
                        <span class="text-muted">{% trans %}Stock total{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-info-subtle text-info rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:bill-list-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalDoggyBagSigns }}</h4>
                        <span class="text-muted">{% trans %}Carteles{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
        <div class="col-sm-6 col-xl-3 d-flex">
            <twig:Card class="mb-3 flex-fill">
                <div class="d-flex align-items-center gap-3">
                    <span class="bg-warning-subtle text-warning rounded-2 p-2 d-inline-flex">
                        <twig:Icon name="solar:shield-warning-line-duotone" size="xl" />
                    </span>
                    <div>
                        <h4 class="mb-0 fw-semibold">{{ dashboard.totalDoggyBagExceptions }}</h4>
                        <span class="text-muted">{% trans %}Excepciones{% endtrans %}</span>
                    </div>
                </div>
            </twig:Card>
        </div>
    </div>

    {% if dashboard.totalPackagings == 0 and dashboard.totalDoggyBagSigns == 0 and dashboard.totalDoggyBagExceptions == 0 %}
        <twig:Alert type="info">{% trans %}No hay datos de doggy bag para los filtros seleccionados{% endtrans %}</twig:Alert>
    {% else %}
        <div class="row">
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Stock por tipo de envase' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Donut
                        title="{{ 'Stock' | trans }}"
                        :values="dashboard.stockByType.values"
                        :categories="dashboard.stockByType.labels | map(label => label | trans({}, 'packagingType'))"
                        :decimals="0"
                        :legend="true"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-6 d-flex">
                <twig:Card title="{{ 'Excepciones por mes' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Line
                        title="{{ 'Excepciones' | trans }}"
                        :values="dashboard.exceptionsByMonth.values"
                        :categories="dashboard.exceptionsByMonth.labels"
                        :decimals="0"
                        :dataLabels="true"
                    />
                </twig:Card>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4 d-flex">
                <twig:Card title="{{ 'Stock por propiedad' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Stock' | trans }}"
                        :values="dashboard.stockByProperty.values"
                        :categories="dashboard.stockByProperty.labels"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-4 d-flex">
                <twig:Card title="{{ 'Carteles por propiedad' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Carteles' | trans }}"
                        :values="dashboard.signsByProperty.values"
                        :categories="dashboard.signsByProperty.labels"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
            <div class="col-lg-4 d-flex">
                <twig:Card title="{{ 'Excepciones por punto crítico' | trans }}" class="mb-3 flex-fill">
                    <twig:Chart:Bar
                        title="{{ 'Excepciones' | trans }}"
                        :values="dashboard.exceptionsByCriticalPoint.values"
                        :categories="dashboard.exceptionsByCriticalPoint.labels"
                        :decimals="0"
                    />
                </twig:Card>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block right_bar %}
    <twig:Sidebar:Right>
        <twig:List:Filter title="{{ 'Filtrar resultados' | trans }}"></twig:List:Filter>
    </twig:Sidebar:Right>
{% endblock %}
