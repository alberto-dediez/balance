{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Carteles Doggy Bag' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Ubicación' | trans,
            'sortable': false
        }, {
            'label': 'Propiedad' | trans,
            'sortable': false
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        },
    ] %}

    <twig:List:Table :columns="columns" :elements="doggyBagSigns" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.location }}</td>
        <td>{{ element.propertyId ? element.propertyId | property_name : '' }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            <twig:List:Action:Download path="{{ path('doggy_bag_signs_download', {'doggyBagSignId': element.id}) }}" />

            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('doggy_bag_signs_edit', {'doggyBagSignId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('doggy_bag_signs_remove', {'doggyBagSignId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    {% if dummy | is_authorized('register') %}
        <twig:Link:Register path="{{ path('doggy_bag_signs_register') }}" />
    {% endif %}
{% endblock list_actions %}
