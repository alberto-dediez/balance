{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Países' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'ISO' | trans,
        }, {
            'label': 'UE' | trans,
        }, {
            'label': 'IVA %' | trans,
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="countries" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.iso }}</td>
        <td>{{ element.europeanUnion ? 'Sí' | trans : 'No' | trans }}</td>
        <td>{{ element.vatRate is null ? '-' : element.vatRate | number_format(2, ',', '.') }}</td>
        <td>{{ element.registeredAt | date('d/m/Y') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('admin_countries_edit', {'countryId': element.id}) }}" />
            {% endif %}
            
            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('admin_countries_remove', {'countryId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_countries_register') }}" />
{% endblock list_actions %}