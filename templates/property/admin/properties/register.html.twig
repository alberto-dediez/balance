{% extends '@shared/layout/register.html.twig' %}

{% set page_title = ('Propiedades' | trans)
    ~ ' > '
    ~ ('Registrar' | trans)  %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('admin_properties') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            {% include '@property/admin/properties/_form.html.twig' %}

            <twig:ActionBar>
                <twig:ActionBar:Button type="primary" :button="form.register" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
