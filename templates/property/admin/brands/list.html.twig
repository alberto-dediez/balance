{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Marcas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Fecha de registro' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="brands">
        <tr>
            <td>{{ element.name }}</td>
            <td>{{ element.registeredAt | date('d/m/Y') }}</td>
            <td>
                {% if element | is_authorized('edit') %}
                    <twig:List:Action:Edit path="{{ path('admin_brands_edit', {'brandId': element.id}) }}" />
                {% endif %}
                
                {% if element | is_authorized('remove') %}
                    <twig:List:Action:Delete path="{{ path('admin_brands_remove', {'brandId': element.id}) }}" />
                {% endif %}
            </td>
        </tr>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link:Register path="{{ path('admin_brands_register') }}" />
{% endblock list_actions %}