{% extends '@shared/layout/action.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ backToList }}" />
{% endblock %}

{% block content %}
    <form method="get">
        <input type="hidden" name="page" value="{{ page - 1 }}">
        <input type="hidden" name="limit" value="{{ limit }}">

        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>{{ 'Evento' | trans }}</th>
                                <th>{{ 'Realizado por' | trans }}</th>
                                <th>{{ 'Fecha' | trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for event in events %}
                                <tr>
                                    <td>
                                        {% include [
                                            '@security/admin/events/detail/' ~ event.context ~ '.' ~ event.eventName ~ '.html.twig',
                                            '@security/admin/events/detail/default.html.twig'
                                        ] with {
                                            'event': event.rebuild()
                                        } %}
                                    </td>
                                    <td>
                                        {{ event.userId | user_name | trans | raw }}
                                        {% if event.isImpersonated %}
                                            <span class="badge bg-warning-subtle text-warning">{{ 'Suplantado por' | trans }}: {{ event.impersonatorId | user_name | trans | raw }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-nowrap">{{ event.occurredOn | date('H:i d/m/Y') }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        {{ 'Sin eventos registrados' | trans }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <twig:List:Pagination totalResults="{{ totalResults }}" page="{{ page }}" limit="{{ limit }}" />
            </div>
        </div>
    </form>
{% endblock %}
