{% extends theme_template('@shared/base.html.twig') %}

{% block branding %}
    {% set consent_required = true %}
    {{ include(theme_template('@shared/layout/_branding.html.twig')) }}
{% endblock %}

{% block body_tag %}class="public-page branded-page" data-bs-theme-locked="true" data-controller="consent-gate" data-consent-gate-name-value="{{ cookie_consent_name() }}"{% endblock %}

{% block body %}
    <div id="main-wrapper">
        <div class="page-wrapper">
            <twig:Topbar :public="true"></twig:Topbar>

            <div class="body-wrapper">
                <div class="container-fluid">
                    {% block page_header %}
                        <div class="card card-body d-print-none">
                            <div class="row align-items-center">
                                <div class="col-12">
                                    <div class="d-sm-flex align-items-center justify-space-between">
                                        {% block page_title %}
                                            <h4 class="fw-semibold fs-4 mb-4 mb-md-0 card-title">{{ page_title }}</h4>
                                        {% endblock %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endblock %}

                    {% block content %}{% endblock %}
                </div>

                {% block footer %}<twig:Footer :public="true" />{% endblock %}
            </div>
        </div>
    </div>

    <twig:Messages></twig:Messages>
    {% block cookie_consent %}<twig:CookieConsent />{% endblock %}
{% endblock body %}
