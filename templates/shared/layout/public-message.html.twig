{% extends '@shared/layout/public.html.twig' %}

{#
    Variables expected from the child template:
      message_title — heading (required)
      message_text — body text (required)
      message_variant — contextual name: success, warning, danger or info (default: info)
      message_icon — iconify name; omitted renders no icon
#}

{% block page_header %}{% endblock %}

{% block content %}
    {% set message_variant = message_variant ?? 'info' %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5 text-center">
            <div class="card">
                <div class="card-body py-5 px-4">
                    {% if message_icon is defined and message_icon %}
                        <twig:Icon :name="message_icon" size="xl" :class="'text-' ~ message_variant ~ ' mb-3'" />
                    {% endif %}
                    <h3 class="text-{{ message_variant }}">{{ message_title }}</h3>
                    <p class="text-muted mt-3 mb-0">{{ message_text }}</p>
                    {% block message_actions %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
