{% extends '@shared/layout/action.html.twig' %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {% for field in form %}
                        {% if field.vars.name != 'register' %}
                            {{ form_row(field) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>    

            <twig:ActionBar>
                <twig:ActionBar:Button type="primary" :button="form.register" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}