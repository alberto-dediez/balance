<!--  Header Start -->
<header class="topbar d-print-none">
    <div class="with-vertical">
        <nav class="navbar navbar-expand-lg p-0">
            <ul class="navbar-nav">
                <li class="nav-item nav-icon-hover ms-n3">
                    <a class="nav-link sidebartoggler" id="headerCollapse" href="javascript:void(0)">
                        <twig:ux:icon name="solar:hamburger-menu-line-duotone" class="icon icon-500" />
                    </a>
                </li>
            </ul>
            <div class="topbar-logo | d-flex">
                <img src="{{ asset('images/logo-light.png') }}" class="dark-logo" height="36" alt="Bioscore Sustainability" />
                <img src="{{ asset('images/logo-dark.png') }}" class="light-logo" height="36" alt="Bioscore Sustainability" />
            </div>
            <a class="navbar-toggler p-0 border-0 nav-icon-hover" href="javascript:void(0)" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="p-2">
                    <twig:ux:icon name="ph:dots-three" class="icon" />
                </span>
            </a>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <div class="d-flex align-items-center justify-content-between">
                    <ul class="navbar-nav flex-row mx-auto ms-lg-auto align-items-center justify-content-center">
                        <li class="nav-item nav-icon-hover">
                            <a class="nav-link moon dark-layout" href="javascript:void(0)">
                                <twig:ux:icon name="solar:moon-line-duotone" class="icon moon" />
                            </a>
                            <a class="nav-link sun light-layout" href="javascript:void(0)">
                                <twig:ux:icon name="solar:sun-2-line-duotone" class="icon sun" />
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            {% include '@shared/layout/app/topbar/profile.html.twig' %}
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </div>
</header>