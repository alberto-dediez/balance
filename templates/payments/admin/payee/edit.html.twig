{% extends '@shared/layout/edit.html.twig' %}

{% set page_title = ('Beneficiarios' | trans) ~ ' > ' ~ ('Editar' | trans) ~ ' > ' ~ payee.legalName %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('admin_payees') }}" />
{% endblock %}

{% block content %}
    {{ form_start(form) }}

    <twig:Card title="{{ 'Beneficiario' | trans }}">
        <dl class="row mb-0">
            <dt class="col-sm-4">{{ 'Tipo' | trans }}</dt>
            <dd class="col-sm-8">{{ payee.type.value | trans({}, 'payeeType') }}</dd>

            <dt class="col-sm-4">{{ 'Cuenta o proyecto' | trans }}</dt>
            <dd class="col-sm-8">{{ subjectLabel ?? payee.subjectId }}</dd>

            <dt class="col-sm-4">{{ 'Estado' | trans }}</dt>
            <dd class="col-sm-8">{{ payee.status.value | trans({}, 'payeeStatus') }}</dd>
        </dl>
    </twig:Card>

    {% include '@payments/admin/payee/_form.html.twig' %}

    <twig:Card>
        <twig:ActionBar>
            <twig:ActionBar:Button type="primary" :button="form.saveAndReturn" />
        </twig:ActionBar>
    </twig:Card>

    {{ form_end(form) }}
{% endblock %}
