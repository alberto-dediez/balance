{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('library_media') }}" />
{% endblock %}

{% set page_title = ('Biblioteca' | trans)
    ~ ' > '
    ~ ('Editar' | trans)
    ~ ' > '
    ~ media.name %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12 col-md-4">
                    <twig:Library:Thumbnail size="lg" :name="media.alternativeText | default(media.name)" :type="media.type.value" :isImage="media.image" :url="media.image ? path('library_media_show', {'mediaId': media.id}) : null" class="mb-3" />

                    <twig:View:Field label="{{ 'Archivo' | trans }}">{{ media.fileName }}</twig:View:Field>
                    <twig:View:Field label="{{ 'Tipo' | trans }}">{{ media.type.value | trans({}, 'mediaType') }}</twig:View:Field>
                    <twig:View:Field label="{{ 'Tamaño' | trans }}">{{ media.size | file_size }}</twig:View:Field>

                    <twig:Link path="{{ path('library_media_show', {'mediaId': media.id, 'download': 1}) }}" color="primarySubtle" class="w-100 justify-content-center" title="{{ 'Descargar' | trans }}">
                        <twig:Icon name="solar:download-square-line-duotone" size="lg" class="me-2" />

                        {{ 'Descargar' | trans }}
                    </twig:Link>
                </div>

                <div class="col-12 col-md-8">
                    {{ form_row(form.name) }}
                    {{ form_row(form.alternativeText) }}
                    {{ form_row(form.description) }}

                    {{ form_row(form.visibility) }}
                    {% if form.shared is defined %}
                        {{ form_row(form.shared) }}
                    {% endif %}

                    {% if media.public %}
                        <twig:View:Field label="{{ 'Enlace público' | trans }}">
                            <a href="{{ url('library_media_public_show', {'mediaId': media.id}) }}" target="_blank" rel="noopener">
                                {{ url('library_media_public_show', {'mediaId': media.id}) }}
                            </a>
                        </twig:View:Field>
                    {% endif %}
                </div>
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
