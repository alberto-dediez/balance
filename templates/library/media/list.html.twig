{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Biblioteca' | trans %}

{% block table %}
    {% set type_colors = {'Image': 'primary', 'Document': 'info', 'Video': 'warning', 'Audio': 'success', 'Other': 'secondary'} %}
    {% set visibility_colors = {'Account': 'secondary', 'System': 'info', 'Public': 'warning'} %}

    {% set columns = [
        {
            'label': ''
        }, {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Tipo' | trans
        }, {
            'label': 'Visibilidad' | trans,
            'sortable': false
        },
    ] %}

    {% set columns = columns | merge([{
            'label': 'Tamaño' | trans,
            'sortable': true,
            'sortableBy': 'size'
        }, {
            'label': 'Fecha de subida' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ]) %}

    <twig:List:Table :columns="columns" :elements="media" :bulkForm="bulkForm">
        <td>
            <twig:Library:Thumbnail size="sm" :name="element.alternativeText | default(element.name)" :type="element.type.value" :isImage="element.image" :url="element.image ? path('library_media_show', {'mediaId': element.id}) : null" />
        </td>
        <td>
            {{ element.name }}

            <div class="text-muted fs-2">
                {{ element.fileName }}
            </div>
        </td>
        <td>
            <span class="badge bg-{{ type_colors[element.type.value] }}-subtle text-{{ type_colors[element.type.value] }}">{{ element.type.value | trans({}, 'mediaType') }}</span>
        </td>

        <td>
            <span class="badge bg-{{ visibility_colors[element.visibility.value] }}-subtle text-{{ visibility_colors[element.visibility.value] }}">{{ element.visibility.value | trans({}, 'mediaVisibility') }}</span>

            {% if element.shared %}
                <span class="badge bg-success-subtle text-success">{{ 'Compartido' | trans }}</span>
            {% endif %}
        </td>
        <td>{{ element.size | file_size }}</td>
        <td>{{ element.registeredAt | date('d/m/Y H:i') }}</td>
        <td>
            <twig:List:Action:Download path="{{ path('library_media_show', {'mediaId': element.id, 'download': 1}) }}" />

            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('library_media_edit', {'mediaId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('library_media_remove', {'mediaId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    <twig:Link path="{{ path('library_media_upload') }}" color="primary">
        <twig:Icon name="solar:upload-square-line-duotone" size="lg" class="me-2" />

        {% trans %}Subir archivo{% endtrans %}
    </twig:Link>
{% endblock list_actions %}
