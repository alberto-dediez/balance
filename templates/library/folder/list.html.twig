{% extends '@shared/layout/list.html.twig' %}

{% set page_title = 'Biblioteca' | trans ~ ' > ' ~ 'Carpetas' | trans %}

{% block table %}
    {% set columns = [
        {
            'label': 'Nombre' | trans,
            'sortable': true,
            'sortableBy': 'name'
        }, {
            'label': 'Fecha de creación' | trans,
            'sortable': true,
            'sortableBy': 'registeredAt'
        }, {
            'label': ''
        }
    ] %}

    <twig:List:Table :columns="columns" :elements="folders" :bulkForm="bulkForm">
        <td>{{ element.name }}</td>
        <td>{{ element.registeredAt | date('d/m/Y H:i') }}</td>
        <td>
            {% if element | is_authorized('edit') %}
                <twig:List:Action:Edit path="{{ path('library_folders_edit', {'folderId': element.id}) }}" />
            {% endif %}

            {% if element | is_authorized('remove') %}
                <twig:List:Action:Delete path="{{ path('library_folders_remove', {'folderId': element.id}) }}" />
            {% endif %}
        </td>
    </twig:List:Table>
{% endblock %}

{% block list_actions %}
    {% if canManage %}
        <twig:Link:Register path="{{ path('library_folders_register') }}" />
    {% endif %}
{% endblock list_actions %}
