{% extends '@shared/layout/edit.html.twig' %}

{% block top_actions %}
    <twig:TopAction:Return path="{{ path('library_media') }}" />
{% endblock %}

{% if parent %}
    {% set page_title = ('Biblioteca' | trans)
        ~ ' > '
        ~ parent.name
        ~ ' > '
        ~ ('Editar subcarpeta' | trans)
        ~ ' > '
        ~ folder.name %}
{% else %}
    {% set page_title = ('Biblioteca' | trans)
        ~ ' > '
        ~ ('Editar carpeta' | trans)
        ~ ' > '
        ~ folder.name %}
{% endif %}

{% block content %}
    {{ form_start(form) }}
        <twig:Card>
            <div class="row">
                <div class="col-12">
                    {{ form_row(form.name) }}
                </div>
            </div>

            <twig:ActionBar>
                <twig:ActionBar:Button type="outline-primary" :button="form.saveAndReturn" />
                <twig:ActionBar:Button type="primary" :button="form.save" />
            </twig:ActionBar>
        </twig:Card>
    {{ form_end(form)}}
{% endblock %}
